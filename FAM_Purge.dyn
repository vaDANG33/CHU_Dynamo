      "NodeType": "ExtensionNode",
      "Inputs": [
        {
          "Id": "d096cfef86954295a885e688b2869fd4",
          "Name": "",
          "Description": "Afficher la sortie de ce noeud",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        }
      ],
      "Outputs": [
