    {
      "ConcreteType": "PythonNodeModels.PythonNode, PythonNodeModels",
      "Code": "import clr\r\nclr.AddReference('RevitAPI')\r\nfrom Autodesk.Revit.DB import SaveAsOptions\r\n\r\nimport os\r\n\r\n# 📥 Entrées depuis Dynamo\r\ndocs_familles = IN[0]  # Liste de documents de familles déjà ouverts\r\ndossier = IN[1]        # Chemin du dossier cible\r\n\r\n# 📤 Liste des résultats\r\nresultats = []\r\n\r\nfor doc in docs_familles:\r\n    try:\r\n        # 📛 Nom du fichier .rfa\r\n        nom_fichier = os.path.basename(doc.PathName)\r\n        if not nom_fichier.lower().endswith(\".rfa\"):\r\n            nom_fichier += \".rfa\"\r\n\r\n        # 📁 Nouveau chemin de sauvegarde\r\n        chemin_sauvegarde = os.path.join(dossier, nom_fichier)\r\n\r\n        # ⚙️ Options d'enregistrement\r\n        options = SaveAsOptions()\r\n        options.Compact = True\r\n        options.OverwriteExistingFile = True\r\n\r\n        # 💾 Sauvegarde\r\n        doc.SaveAs(chemin_sauvegarde, options)\r\n\r\n        # ❌ Fermeture du document\r\n        doc.Close(False)  # False = ne pas enregistrer à nouveau\r\n\r\n        resultats.append(f\"✅ Sauvegardé et fermé : {chemin_sauvegarde}\")\r\n    except Exception as e:\r\n        resultats.append(f\"⚠️ Erreur : {str(e)}\")\r\n\r\n# 🔄 Sortie vers Dynamo\r\nOUT = resultats",
      "Engine": "PythonNet3",
      "VariableInputPorts": true,
      "Id": "08ffb51e94504de8a5c67fb3998018f7",
      "NodeType": "PythonScriptNode",
      "Inputs": [
        {
          "Id": "99acb9cbc6464b52b8b2de2cb0f2e0e5",
