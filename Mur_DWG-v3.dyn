    {
      "ConcreteType": "PythonNodeModels.PythonNode, PythonNodeModels",
      "Code": "# -*- coding: utf-8 -*-\r\n\r\nimport clr\r\nimport math\r\n\r\nclr.AddReference(\"ProtoGeometry\")\r\nfrom Autodesk.DesignScript.Geometry import Point, Line\r\n\r\nclr.AddReference(\"RevitAPI\")\r\nfrom Autodesk.Revit.DB import UnitUtils, UnitTypeId, SpecTypeId\r\n\r\nclr.AddReference(\"RevitServices\")\r\nfrom RevitServices.Persistence import DocumentManager\r\n\r\n\r\n# ============================================================\r\n# INPUTS\r\n# ============================================================\r\n\r\nlines = IN[0] if IN[0] else []\r\n\r\nmax_width_mm = (\r\n    float(IN[1])\r\n    if IN[1] is not None\r\n    else 150.0\r\n)\r\n\r\nangle_tolerance_deg = (\r\n    float(IN[2])\r\n    if IN[2] is not None\r\n    else 0.1\r\n)\r\n\r\nmin_overlap_mm = (\r\n    float(IN[3])\r\n    if IN[3] is not None\r\n    else 10.0\r\n)\r\n\r\n\r\n# ============================================================\r\n# UNITES\r\n# ============================================================\r\n\r\ndoc = DocumentManager.Instance.CurrentDBDocument\r\n\r\nproject_unit_id = (\r\n    doc.GetUnits()\r\n       .GetFormatOptions(SpecTypeId.Length)\r\n       .GetUnitTypeId()\r\n)\r\n\r\n\r\ndef mm_to_project(value_mm):\r\n\r\n    internal = UnitUtils.ConvertToInternalUnits(\r\n        value_mm,\r\n        UnitTypeId.Millimeters\r\n    )\r\n\r\n    return UnitUtils.ConvertFromInternalUnits(\r\n        internal,\r\n        project_unit_id\r\n    )\r\n\r\n\r\ndef project_to_mm(value):\r\n\r\n    internal = UnitUtils.ConvertToInternalUnits(\r\n        value,\r\n        project_unit_id\r\n    )\r\n\r\n    return UnitUtils.ConvertFromInternalUnits(\r\n        internal,\r\n        UnitTypeId.Millimeters\r\n    )\r\n\r\n\r\nmax_width = mm_to_project(max_width_mm)\r\nmin_overlap = mm_to_project(min_overlap_mm)\r\n\r\n\r\n# ============================================================\r\n# PARAMETRES ANGULAIRES\r\n# ============================================================\r\n\r\nangle_tolerance_rad = math.radians(\r\n    angle_tolerance_deg\r\n)\r\n\r\nparallel_threshold = math.cos(\r\n    angle_tolerance_rad\r\n)\r\n\r\n# La taille d'un bucket correspond à la tolérance.\r\nangle_bucket_size = max(\r\n    angle_tolerance_rad,\r\n    1e-8\r\n)\r\n\r\nnumber_angle_buckets = int(\r\n    math.ceil(\r\n        math.pi / angle_bucket_size\r\n    )\r\n)\r\n\r\n\r\n# ============================================================\r\n# PRECALCUL DES LIGNES\r\n# ============================================================\r\n\r\ndata = []\r\n\r\nfor index, curve in enumerate(lines):\r\n\r\n    try:\r\n\r\n        p0 = curve.StartPoint\r\n        p1 = curve.EndPoint\r\n\r\n        x0 = float(p0.X)\r\n        y0 = float(p0.Y)\r\n        z0 = float(p0.Z)\r\n\r\n        x1 = float(p1.X)\r\n        y1 = float(p1.Y)\r\n        z1 = float(p1.Z)\r\n\r\n        dx = x1 - x0\r\n        dy = y1 - y0\r\n\r\n        length_xy = math.sqrt(\r\n            dx * dx +\r\n            dy * dy\r\n        )\r\n\r\n        if length_xy <= 1e-12:\r\n            continue\r\n\r\n        ux = dx / length_xy\r\n        uy = dy / length_xy\r\n\r\n        # --------------------------------------------\r\n        # Orientation canonique [0 ; pi[\r\n        # --------------------------------------------\r\n\r\n        angle = math.atan2(uy, ux)\r\n\r\n        if angle < 0.0:\r\n            angle += math.pi\r\n\r\n        if angle >= math.pi:\r\n            angle -= math.pi\r\n\r\n        # --------------------------------------------\r\n        # Midpoint\r\n        # --------------------------------------------\r\n\r\n        mx = 0.5 * (x0 + x1)\r\n        my = 0.5 * (y0 + y1)\r\n        mz = 0.5 * (z0 + z1)\r\n\r\n        # --------------------------------------------\r\n        # Bucket orientation\r\n        # --------------------------------------------\r\n\r\n        angle_key = int(\r\n            math.floor(\r\n                angle / angle_bucket_size\r\n            )\r\n        )\r\n\r\n        if angle_key >= number_angle_buckets:\r\n            angle_key = (\r\n                number_angle_buckets - 1\r\n            )\r\n\r\n        data.append({\r\n            \"id\": index,\r\n            \"curve\": curve,\r\n\r\n            \"x0\": x0,\r\n            \"y0\": y0,\r\n            \"z0\": z0,\r\n\r\n            \"x1\": x1,\r\n            \"y1\": y1,\r\n            \"z1\": z1,\r\n\r\n            \"mx\": mx,\r\n            \"my\": my,\r\n            \"mz\": mz,\r\n\r\n            \"ux\": ux,\r\n            \"uy\": uy,\r\n\r\n            \"length\": length_xy,\r\n\r\n            \"angle\": angle,\r\n            \"angle_key\": angle_key\r\n        })\r\n\r\n    except:\r\n        pass\r\n\r\n\r\n# ============================================================\r\n# INDEX SPATIAL\r\n#\r\n# Structure :\r\n#\r\n# spatial_index[angle_bucket][normal_bucket]\r\n#       -> liste des IDs de lignes\r\n#\r\n# ============================================================\r\n\r\nspatial_index = {}\r\n\r\n\r\ndef representative_angle(angle_key):\r\n\r\n    return (\r\n        angle_key + 0.5\r\n    ) * angle_bucket_size\r\n\r\n\r\nfor local_id, d in enumerate(data):\r\n\r\n    angle_key = d[\"angle_key\"]\r\n\r\n    rep_angle = representative_angle(\r\n        angle_key\r\n    )\r\n\r\n    # Normale au bucket d'orientation.\r\n    nx = -math.sin(rep_angle)\r\n    ny =  math.cos(rep_angle)\r\n\r\n    rho = (\r\n        d[\"mx\"] * nx +\r\n        d[\"my\"] * ny\r\n    )\r\n\r\n    normal_key = int(\r\n        math.floor(\r\n            rho / max_width\r\n        )\r\n    )\r\n\r\n    if angle_key not in spatial_index:\r\n        spatial_index[angle_key] = {}\r\n\r\n    if normal_key not in spatial_index[angle_key]:\r\n        spatial_index[angle_key][normal_key] = []\r\n\r\n    spatial_index[\r\n        angle_key\r\n    ][\r\n        normal_key\r\n    ].append(local_id)\r\n\r\n\r\n# ============================================================\r\n# OUTILS MATHEMATIQUES\r\n# ============================================================\r\n\r\ndef dot2(ax, ay, bx, by):\r\n\r\n    return ax * bx + ay * by\r\n\r\n\r\ndef projection_interval(d, ux, uy):\r\n\r\n    s0 = (\r\n        d[\"x0\"] * ux +\r\n        d[\"y0\"] * uy\r\n    )\r\n\r\n    s1 = (\r\n        d[\"x1\"] * ux +\r\n        d[\"y1\"] * uy\r\n    )\r\n\r\n    if s0 <= s1:\r\n        return s0, s1\r\n\r\n    return s1, s0\r\n\r\n\r\ndef point_at_projection(d, ux, uy, s):\r\n    \"\"\"\r\n    Retourne le point de la ligne d tel que sa\r\n    projection sur la direction (ux, uy) vaut s.\r\n    \"\"\"\r\n\r\n    dx = d[\"x1\"] - d[\"x0\"]\r\n    dy = d[\"y1\"] - d[\"y0\"]\r\n    dz = d[\"z1\"] - d[\"z0\"]\r\n\r\n    denominator = (\r\n        dx * ux +\r\n        dy * uy\r\n    )\r\n\r\n    if abs(denominator) < 1e-12:\r\n        return None\r\n\r\n    s0 = (\r\n        d[\"x0\"] * ux +\r\n        d[\"y0\"] * uy\r\n    )\r\n\r\n    t = (s - s0) / denominator\r\n\r\n    return (\r\n        d[\"x0\"] + t * dx,\r\n        d[\"y0\"] + t * dy,\r\n        d[\"z0\"] + t * dz\r\n    )\r\n\r\n\r\n# ============================================================\r\n# RECHERCHE DES PAIRES\r\n# ============================================================\r\n\r\ncandidate_centerlines = []\r\ncandidate_widths_mm = []\r\ncandidate_source_pairs = []\r\ncandidate_info = []\r\n\r\ntested_pairs = set()\r\n\r\nbroad_phase_count = 0\r\n\r\nrejected_angle = 0\r\nrejected_distance = 0\r\nrejected_overlap = 0\r\n\r\ncandidate_count_per_line = {}\r\n\r\n\r\nfor i, A in enumerate(data):\r\n\r\n    # --------------------------------------------------------\r\n    # On regarde :\r\n    #\r\n    # bucket angle courant\r\n    # bucket precedent\r\n    # bucket suivant\r\n    #\r\n    # avec périodicité pi.\r\n    # --------------------------------------------------------\r\n\r\n    angle_keys_to_search = [\r\n        (\r\n            A[\"angle_key\"] - 1\r\n        ) % number_angle_buckets,\r\n\r\n        A[\"angle_key\"],\r\n\r\n        (\r\n            A[\"angle_key\"] + 1\r\n        ) % number_angle_buckets\r\n    ]\r\n\r\n    for target_angle_key in angle_keys_to_search:\r\n\r\n        if target_angle_key not in spatial_index:\r\n            continue\r\n\r\n        rep_angle = representative_angle(\r\n            target_angle_key\r\n        )\r\n\r\n        nx_rep = -math.sin(rep_angle)\r\n        ny_rep =  math.cos(rep_angle)\r\n\r\n        rho_A = (\r\n            A[\"mx\"] * nx_rep +\r\n            A[\"my\"] * ny_rep\r\n        )\r\n\r\n        normal_key_A = int(\r\n            math.floor(\r\n                rho_A / max_width\r\n            )\r\n        )\r\n\r\n        # Avec une cellule de taille max_width,\r\n        # une ligne distante de <= max_width\r\n        # ne peut être que dans :\r\n        #\r\n        # q-1 / q / q+1\r\n        #\r\n        for target_normal_key in (\r\n            normal_key_A - 1,\r\n            normal_key_A,\r\n            normal_key_A + 1\r\n        ):\r\n\r\n            bucket = spatial_index[\r\n                target_angle_key\r\n            ].get(\r\n                target_normal_key,\r\n                []\r\n            )\r\n\r\n            for j in bucket:\r\n\r\n                if i == j:\r\n                    continue\r\n\r\n                # --------------------------------------------\r\n                # Paire unique\r\n                # --------------------------------------------\r\n\r\n                if i < j:\r\n                    pair_key = (i, j)\r\n                else:\r\n                    pair_key = (j, i)\r\n\r\n                if pair_key in tested_pairs:\r\n                    continue\r\n\r\n                tested_pairs.add(pair_key)\r\n\r\n                broad_phase_count += 1\r\n\r\n                B = data[j]\r\n\r\n                # ============================================\r\n                # C1 - PARALLELISME EXACT\r\n                # ============================================\r\n\r\n                dot = abs(\r\n                    dot2(\r\n                        A[\"ux\"],\r\n                        A[\"uy\"],\r\n                        B[\"ux\"],\r\n                        B[\"uy\"]\r\n                    )\r\n                )\r\n\r\n                dot = max(\r\n                    -1.0,\r\n                    min(1.0, dot)\r\n                )\r\n\r\n                if dot < parallel_threshold:\r\n\r\n                    rejected_angle += 1\r\n                    continue\r\n\r\n                angle_difference = math.acos(dot)\r\n\r\n                # ============================================\r\n                # C3 - DISTANCE ENTRE SUPPORTS\r\n                # ============================================\r\n\r\n                # Normale exacte à A\r\n                nx = -A[\"uy\"]\r\n                ny =  A[\"ux\"]\r\n\r\n                distance_normal = abs(\r\n                    (\r\n                        B[\"mx\"] - A[\"mx\"]\r\n                    ) * nx\r\n                    +\r\n                    (\r\n                        B[\"my\"] - A[\"my\"]\r\n                    ) * ny\r\n                )\r\n\r\n                if (\r\n                    distance_normal <= 1e-9\r\n                    or\r\n                    distance_normal > max_width\r\n                ):\r\n\r\n                    rejected_distance += 1\r\n                    continue\r\n\r\n                # ============================================\r\n                # C2 - OVERLAP LONGITUDINAL\r\n                # ============================================\r\n\r\n                a0, a1 = projection_interval(\r\n                    A,\r\n                    A[\"ux\"],\r\n                    A[\"uy\"]\r\n                )\r\n\r\n                b0, b1 = projection_interval(\r\n                    B,\r\n                    A[\"ux\"],\r\n                    A[\"uy\"]\r\n                )\r\n\r\n                overlap_start = max(\r\n                    a0,\r\n                    b0\r\n                )\r\n\r\n                overlap_end = min(\r\n                    a1,\r\n                    b1\r\n                )\r\n\r\n                overlap = (\r\n                    overlap_end -\r\n                    overlap_start\r\n                )\r\n\r\n                if overlap < min_overlap:\r\n\r\n                    rejected_overlap += 1\r\n                    continue\r\n\r\n                # ============================================\r\n                # POINTS CORRESPONDANTS AUX LIMITES OVERLAP\r\n                # ============================================\r\n\r\n                A_start = point_at_projection(\r\n                    A,\r\n                    A[\"ux\"],\r\n                    A[\"uy\"],\r\n                    overlap_start\r\n                )\r\n\r\n                A_end = point_at_projection(\r\n                    A,\r\n                    A[\"ux\"],\r\n                    A[\"uy\"],\r\n                    overlap_end\r\n                )\r\n\r\n                B_start = point_at_projection(\r\n                    B,\r\n                    A[\"ux\"],\r\n                    A[\"uy\"],\r\n                    overlap_start\r\n                )\r\n\r\n                B_end = point_at_projection(\r\n                    B,\r\n                    A[\"ux\"],\r\n                    A[\"uy\"],\r\n                    overlap_end\r\n                )\r\n\r\n                if (\r\n                    A_start is None\r\n                    or A_end is None\r\n                    or B_start is None\r\n                    or B_end is None\r\n                ):\r\n                    continue\r\n\r\n                # ============================================\r\n                # AXE MEDIAN CANDIDAT\r\n                # ============================================\r\n\r\n                start_center = (\r\n                    0.5 * (\r\n                        A_start[0] +\r\n                        B_start[0]\r\n                    ),\r\n                    0.5 * (\r\n                        A_start[1] +\r\n                        B_start[1]\r\n                    ),\r\n                    0.5 * (\r\n                        A_start[2] +\r\n                        B_start[2]\r\n                    )\r\n                )\r\n\r\n                end_center = (\r\n                    0.5 * (\r\n                        A_end[0] +\r\n                        B_end[0]\r\n                    ),\r\n                    0.5 * (\r\n                        A_end[1] +\r\n                        B_end[1]\r\n                    ),\r\n                    0.5 * (\r\n                        A_end[2] +\r\n                        B_end[2]\r\n                    )\r\n                )\r\n\r\n                p_start = Point.ByCoordinates(\r\n                    start_center[0],\r\n                    start_center[1],\r\n                    start_center[2]\r\n                )\r\n\r\n                p_end = Point.ByCoordinates(\r\n                    end_center[0],\r\n                    end_center[1],\r\n                    end_center[2]\r\n                )\r\n\r\n                centerline = (\r\n                    Line.ByStartPointEndPoint(\r\n                        p_start,\r\n                        p_end\r\n                    )\r\n                )\r\n\r\n                # ============================================\r\n                # LARGEUR AU MILIEU DE L'OVERLAP\r\n                # ============================================\r\n\r\n                overlap_middle = 0.5 * (\r\n                    overlap_start +\r\n                    overlap_end\r\n                )\r\n\r\n                A_middle = point_at_projection(\r\n                    A,\r\n                    A[\"ux\"],\r\n                    A[\"uy\"],\r\n                    overlap_middle\r\n                )\r\n\r\n                B_middle = point_at_projection(\r\n                    B,\r\n                    A[\"ux\"],\r\n                    A[\"uy\"],\r\n                    overlap_middle\r\n                )\r\n\r\n                dx_width = (\r\n                    B_middle[0] -\r\n                    A_middle[0]\r\n                )\r\n\r\n                dy_width = (\r\n                    B_middle[1] -\r\n                    A_middle[1]\r\n                )\r\n\r\n                width = math.sqrt(\r\n                    dx_width * dx_width +\r\n                    dy_width * dy_width\r\n                )\r\n\r\n                width_mm = project_to_mm(\r\n                    width\r\n                )\r\n\r\n                overlap_mm = project_to_mm(\r\n                    overlap\r\n                )\r\n\r\n                # ============================================\r\n                # RATIO OVERLAP\r\n                # ============================================\r\n\r\n                projected_length_A = (\r\n                    a1 - a0\r\n                )\r\n\r\n                projected_length_B = (\r\n                    b1 - b0\r\n                )\r\n\r\n                min_projected_length = min(\r\n                    projected_length_A,\r\n                    projected_length_B\r\n                )\r\n\r\n                if min_projected_length > 1e-12:\r\n\r\n                    overlap_ratio = (\r\n                        overlap /\r\n                        min_projected_length\r\n                    )\r\n\r\n                else:\r\n\r\n                    overlap_ratio = 0.0\r\n\r\n                # ============================================\r\n                # ENREGISTREMENT\r\n                # ============================================\r\n\r\n                candidate_centerlines.append(\r\n                    centerline\r\n                )\r\n\r\n                candidate_widths_mm.append(\r\n                    width_mm\r\n                )\r\n\r\n                candidate_source_pairs.append([\r\n                    A[\"curve\"],\r\n                    B[\"curve\"]\r\n                ])\r\n\r\n                candidate_info.append({\r\n                    \"SourceA\": A[\"id\"],\r\n                    \"SourceB\": B[\"id\"],\r\n\r\n                    \"Largeur_mm\": round(\r\n                        width_mm,\r\n                        3\r\n                    ),\r\n\r\n                    \"Overlap_mm\": round(\r\n                        overlap_mm,\r\n                        3\r\n                    ),\r\n\r\n                    \"RatioOverlap\": round(\r\n                        overlap_ratio,\r\n                        4\r\n                    ),\r\n\r\n                    \"AngleDiff_deg\": round(\r\n                        math.degrees(\r\n                            angle_difference\r\n                        ),\r\n                        5\r\n                    )\r\n                })\r\n\r\n                candidate_count_per_line[\r\n                    A[\"id\"]\r\n                ] = (\r\n                    candidate_count_per_line.get(\r\n                        A[\"id\"],\r\n                        0\r\n                    ) + 1\r\n                )\r\n\r\n                candidate_count_per_line[\r\n                    B[\"id\"]\r\n                ] = (\r\n                    candidate_count_per_line.get(\r\n                        B[\"id\"],\r\n                        0\r\n                    ) + 1\r\n                )\r\n\r\n\r\n# ============================================================\r\n# DIAGNOSTIC\r\n# ============================================================\r\n\r\nnumber_lines = len(data)\r\n\r\npossible_pairs_naive = int(\r\n    number_lines *\r\n    (number_lines - 1) /\r\n    2\r\n)\r\n\r\nambiguous_lines = 0\r\n\r\nfor count in candidate_count_per_line.values():\r\n\r\n    if count > 1:\r\n        ambiguous_lines += 1\r\n\r\n\r\nif broad_phase_count > 0:\r\n\r\n    reduction_ratio = (\r\n        1.0 -\r\n        (\r\n            float(broad_phase_count) /\r\n            float(possible_pairs_naive)\r\n        )\r\n    )\r\n\r\nelse:\r\n\r\n    reduction_ratio = 1.0\r\n\r\n\r\ndiagnostic = {\r\n\r\n    \"Lignes entree\":\r\n        number_lines,\r\n\r\n    \"Couples possibles methode brute\":\r\n        possible_pairs_naive,\r\n\r\n    \"Couples testes apres indexation\":\r\n        broad_phase_count,\r\n\r\n    \"Reduction broad-phase (%)\":\r\n        round(\r\n            reduction_ratio * 100.0,\r\n            2\r\n        ),\r\n\r\n    \"Rejetes angle\":\r\n        rejected_angle,\r\n\r\n    \"Rejetes distance\":\r\n        rejected_distance,\r\n\r\n    \"Rejetes overlap\":\r\n        rejected_overlap,\r\n\r\n    \"Paires candidates\":\r\n        len(candidate_centerlines),\r\n\r\n    \"Lignes avec plusieurs candidats\":\r\n        ambiguous_lines,\r\n\r\n    \"Largeur max mm\":\r\n        max_width_mm,\r\n\r\n    \"Tolerance angle deg\":\r\n        angle_tolerance_deg,\r\n\r\n    \"Overlap minimum mm\":\r\n        min_overlap_mm\r\n}\r\n\r\n\r\n# ============================================================\r\n# OUTPUT\r\n# ============================================================\r\n\r\nOUT = (\r\n    candidate_centerlines,\r\n    candidate_widths_mm,\r\n    candidate_source_pairs,\r\n    candidate_info,\r\n    diagnostic\r\n)",
      "Engine": "PythonNet3",
      "VariableInputPorts": true,
      "Id": "35091a85fced46ad8f5d56f0f3ae2944",
      "NodeType": "PythonScriptNode",
      "Inputs": [
        {
          "Id": "b9b1bde960094a94be589c98487a3c40",
          "Name": "IN[0]",
          "Description": "Input #0",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        },
        {
          "Id": "e28450a803c849da9caff0b260146dcd",
          "Name": "IN[1]",
          "Description": "Input #1",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        },
        {
          "Id": "57a163310d7946dd9915af399b38f1db",
          "Name": "IN[2]",
          "Description": "Input #2",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        },
        {
          "Id": "f5176bb67fca49438f1ac01fc4b5f52d",
          "Name": "IN[3]",
          "Description": "Input #3",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        }
      ],
      "Outputs": [
        {
          "Id": "3a389ff3c0624f7fb8fcbb6851c2f4b4",
          "Name": "OUT",
          "Description": "Résultat du script Python",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        }
      ],
      "Replication": "Disabled",
      "Description": "Runs an embedded Python script."
    },
    {
      "ConcreteType": "Dynamo.Graph.Nodes.CodeBlockNodeModel, DynamoCore",
