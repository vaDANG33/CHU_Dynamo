    {
      "ConcreteType": "PythonNodeModels.PythonNode, PythonNodeModels",
      "Code": "# -*- coding: utf-8 -*-\r\n\r\nimport clr\r\nimport math\r\nfrom collections import deque\r\n\r\nclr.AddReference(\"ProtoGeometry\")\r\nfrom Autodesk.DesignScript.Geometry import Point, Line\r\n\r\nclr.AddReference(\"RevitAPI\")\r\nfrom Autodesk.Revit.DB import UnitUtils, UnitTypeId, SpecTypeId\r\n\r\nclr.AddReference(\"RevitServices\")\r\nfrom RevitServices.Persistence import DocumentManager\r\n\r\n\r\n# ============================================================\r\n# PORTE_01_RegrouperCourbes\r\n#\r\n# 1. Flatten des courbes CO-Porte\r\n# 2. Regroupement par connectivité des extrémités\r\n# 3. Une composante connexe = une porte potentielle\r\n# 4. Calcul d'un rectangle minimum orienté 2D\r\n# 5. Création de 4 lignes DesignScript visibles dans Dynamo\r\n#\r\n# Aucun besoin de reconnaître :\r\n# - porte simple\r\n# - porte double\r\n# - charnière\r\n# - vantail\r\n#\r\n# ============================================================\r\n\r\n\r\n# ============================================================\r\n# INPUTS\r\n# ============================================================\r\n\r\ninput_curves = IN[0]\r\n\r\nconnection_tol_mm = (\r\n    float(IN[1])\r\n    if IN[1] is not None\r\n    else 30\r\n)\r\n\r\nmin_curves_group = (\r\n    int(IN[2])\r\n    if IN[2] is not None\r\n    else 2\r\n)\r\n\r\nsamples_per_curve = (\r\n    int(IN[3])\r\n    if IN[3] is not None\r\n    else 12\r\n)\r\n\r\nsamples_per_curve = max(\r\n    2,\r\n    samples_per_curve\r\n)\r\n\r\n\r\n# ============================================================\r\n# FLATTEN RECURSIF\r\n# ============================================================\r\n\r\ndef flatten(data):\r\n\r\n    result = []\r\n\r\n    if isinstance(data, (list, tuple)):\r\n\r\n        for item in data:\r\n            result.extend(\r\n                flatten(item)\r\n            )\r\n\r\n    elif data is not None:\r\n\r\n        result.append(data)\r\n\r\n    return result\r\n\r\n\r\ncurves = flatten(\r\n    input_curves\r\n)\r\n\r\n\r\n# ============================================================\r\n# UNITES\r\n# ============================================================\r\n\r\ndoc = DocumentManager.Instance.CurrentDBDocument\r\n\r\nproject_unit_id = (\r\n    doc.GetUnits()\r\n       .GetFormatOptions(SpecTypeId.Length)\r\n       .GetUnitTypeId()\r\n)\r\n\r\n\r\ndef mm_to_project(value_mm):\r\n\r\n    internal = UnitUtils.ConvertToInternalUnits(\r\n        value_mm,\r\n        UnitTypeId.Millimeters\r\n    )\r\n\r\n    return UnitUtils.ConvertFromInternalUnits(\r\n        internal,\r\n        project_unit_id\r\n    )\r\n\r\n\r\ndef project_to_mm(value):\r\n\r\n    internal = UnitUtils.ConvertToInternalUnits(\r\n        value,\r\n        project_unit_id\r\n    )\r\n\r\n    return UnitUtils.ConvertFromInternalUnits(\r\n        internal,\r\n        UnitTypeId.Millimeters\r\n    )\r\n\r\n\r\nconnection_tol = mm_to_project(\r\n    connection_tol_mm\r\n)\r\n\r\n\r\n# ============================================================\r\n# OUTILS GEOMETRIQUES\r\n# ============================================================\r\n\r\ndef xyz(point):\r\n\r\n    return (\r\n        float(point.X),\r\n        float(point.Y),\r\n        float(point.Z)\r\n    )\r\n\r\n\r\ndef distance_3d(a, b):\r\n\r\n    dx = a[0] - b[0]\r\n    dy = a[1] - b[1]\r\n    dz = a[2] - b[2]\r\n\r\n    return math.sqrt(\r\n        dx * dx +\r\n        dy * dy +\r\n        dz * dz\r\n    )\r\n\r\n\r\ndef get_endpoints(curve):\r\n\r\n    try:\r\n\r\n        p0 = xyz(\r\n            curve.StartPoint\r\n        )\r\n\r\n        p1 = xyz(\r\n            curve.EndPoint\r\n        )\r\n\r\n        return p0, p1\r\n\r\n    except:\r\n\r\n        return None\r\n\r\n\r\n# ============================================================\r\n# ECHANTILLONNAGE D'UNE COURBE\r\n#\r\n# On essaie d'utiliser PointAtParameter afin de prendre\r\n# correctement en compte les arcs.\r\n#\r\n# Si cela échoue, on utilise StartPoint / EndPoint.\r\n# ============================================================\r\n\r\ndef sample_curve(curve, count):\r\n\r\n    points = []\r\n\r\n    # --------------------------------------------------------\r\n    # Essai PointAtParameter\r\n    # DesignScript utilise généralement un paramètre normalisé\r\n    # 0 -> 1.\r\n    # --------------------------------------------------------\r\n\r\n    try:\r\n\r\n        for i in range(count + 1):\r\n\r\n            t = float(i) / float(count)\r\n\r\n            p = curve.PointAtParameter(t)\r\n\r\n            if p is not None:\r\n\r\n                points.append(\r\n                    xyz(p)\r\n                )\r\n\r\n                try:\r\n                    p.Dispose()\r\n                except:\r\n                    pass\r\n\r\n        if len(points) >= 2:\r\n\r\n            return points\r\n\r\n    except:\r\n        pass\r\n\r\n\r\n    # --------------------------------------------------------\r\n    # Fallback\r\n    # --------------------------------------------------------\r\n\r\n    endpoints = get_endpoints(\r\n        curve\r\n    )\r\n\r\n    if endpoints is not None:\r\n\r\n        return [\r\n            endpoints[0],\r\n            endpoints[1]\r\n        ]\r\n\r\n    return []\r\n\r\n\r\n# ============================================================\r\n# PREPARATION DES COURBES\r\n# ============================================================\r\n\r\nvalid_curves = []\r\n\r\ncurve_endpoints = []\r\n\r\ninvalid_curves = []\r\n\r\n\r\nfor curve in curves:\r\n\r\n    endpoints = get_endpoints(\r\n        curve\r\n    )\r\n\r\n    if endpoints is None:\r\n\r\n        invalid_curves.append(\r\n            curve\r\n        )\r\n\r\n        continue\r\n\r\n    valid_curves.append(\r\n        curve\r\n    )\r\n\r\n    curve_endpoints.append(\r\n        endpoints\r\n    )\r\n\r\n\r\nn = len(\r\n    valid_curves\r\n)\r\n\r\n\r\n# ============================================================\r\n# GRAPHE DE CONNEXION\r\n#\r\n# Deux courbes appartiennent au même graphe si au moins\r\n# deux de leurs extrémités sont suffisamment proches.\r\n#\r\n# On conserve la logique validée lors du test précédent.\r\n# ============================================================\r\n\r\nadjacency = [\r\n    set()\r\n    for _ in range(n)\r\n]\r\n\r\nconnection_count = 0\r\n\r\n\r\nfor i in range(n):\r\n\r\n    a0, a1 = curve_endpoints[i]\r\n\r\n    for j in range(\r\n        i + 1,\r\n        n\r\n    ):\r\n\r\n        b0, b1 = curve_endpoints[j]\r\n\r\n        minimum_distance = min(\r\n\r\n            distance_3d(\r\n                a0,\r\n                b0\r\n            ),\r\n\r\n            distance_3d(\r\n                a0,\r\n                b1\r\n            ),\r\n\r\n            distance_3d(\r\n                a1,\r\n                b0\r\n            ),\r\n\r\n            distance_3d(\r\n                a1,\r\n                b1\r\n            )\r\n        )\r\n\r\n        if (\r\n            minimum_distance <=\r\n            connection_tol\r\n        ):\r\n\r\n            adjacency[i].add(j)\r\n\r\n            adjacency[j].add(i)\r\n\r\n            connection_count += 1\r\n\r\n\r\n# ============================================================\r\n# COMPOSANTES CONNEXES\r\n# ============================================================\r\n\r\nvisited = set()\r\n\r\ncomponents = []\r\n\r\n\r\nfor start in range(n):\r\n\r\n    if start in visited:\r\n        continue\r\n\r\n    queue = deque(\r\n        [start]\r\n    )\r\n\r\n    visited.add(\r\n        start\r\n    )\r\n\r\n    component = []\r\n\r\n\r\n    while queue:\r\n\r\n        current = queue.popleft()\r\n\r\n        component.append(\r\n            current\r\n        )\r\n\r\n        for neighbour in adjacency[current]:\r\n\r\n            if neighbour not in visited:\r\n\r\n                visited.add(\r\n                    neighbour\r\n                )\r\n\r\n                queue.append(\r\n                    neighbour\r\n                )\r\n\r\n    components.append(\r\n        component\r\n    )\r\n\r\n\r\n# ============================================================\r\n# GROUPES VALIDES\r\n# ============================================================\r\n\r\ngroups = []\r\n\r\nrejected_curves = list(\r\n    invalid_curves\r\n)\r\n\r\ngroup_sizes = []\r\n\r\n\r\nfor component in components:\r\n\r\n    component_curves = [\r\n\r\n        valid_curves[i]\r\n\r\n        for i in component\r\n    ]\r\n\r\n    if (\r\n        len(component_curves) >=\r\n        min_curves_group\r\n    ):\r\n\r\n        groups.append(\r\n            component_curves\r\n        )\r\n\r\n        group_sizes.append(\r\n            len(component_curves)\r\n        )\r\n\r\n    else:\r\n\r\n        rejected_curves.extend(\r\n            component_curves\r\n        )\r\n\r\n\r\n# ============================================================\r\n# CONVEX HULL 2D\r\n#\r\n# Algorithme monotonic chain.\r\n#\r\n# Le convex hull permet de réduire fortement le nombre de\r\n# points avant la recherche du rectangle minimum.\r\n# ============================================================\r\n\r\ndef cross(o, a, b):\r\n\r\n    return (\r\n        (a[0] - o[0]) *\r\n        (b[1] - o[1])\r\n        -\r\n        (a[1] - o[1]) *\r\n        (b[0] - o[0])\r\n    )\r\n\r\n\r\ndef convex_hull(points):\r\n\r\n    # Suppression des doublons XY\r\n    unique = {}\r\n\r\n    for p in points:\r\n\r\n        key = (\r\n            round(p[0], 9),\r\n            round(p[1], 9)\r\n        )\r\n\r\n        if key not in unique:\r\n\r\n            unique[key] = p\r\n\r\n\r\n    pts = list(\r\n        unique.values()\r\n    )\r\n\r\n    pts.sort(\r\n        key=lambda p:\r\n        (\r\n            p[0],\r\n            p[1]\r\n        )\r\n    )\r\n\r\n\r\n    if len(pts) <= 2:\r\n\r\n        return pts\r\n\r\n\r\n    lower = []\r\n\r\n    for p in pts:\r\n\r\n        while (\r\n            len(lower) >= 2\r\n            and\r\n            cross(\r\n                lower[-2],\r\n                lower[-1],\r\n                p\r\n            ) <= 0.0\r\n        ):\r\n\r\n            lower.pop()\r\n\r\n        lower.append(p)\r\n\r\n\r\n    upper = []\r\n\r\n    for p in reversed(pts):\r\n\r\n        while (\r\n            len(upper) >= 2\r\n            and\r\n            cross(\r\n                upper[-2],\r\n                upper[-1],\r\n                p\r\n            ) <= 0.0\r\n        ):\r\n\r\n            upper.pop()\r\n\r\n        upper.append(p)\r\n\r\n\r\n    return (\r\n        lower[:-1] +\r\n        upper[:-1]\r\n    )\r\n\r\n\r\n# ============================================================\r\n# RECTANGLE MINIMUM ORIENTE\r\n#\r\n# Pour chaque direction d'arête du convex hull :\r\n#\r\n# - rotation virtuelle des points\r\n# - calcul min/max X/Y\r\n# - aire du rectangle\r\n#\r\n# On conserve le rectangle de plus petite aire.\r\n#\r\n# Pour nos symboles de portes 2D, cette méthode est très\r\n# adaptée.\r\n# ============================================================\r\n\r\ndef minimum_oriented_rectangle(points):\r\n\r\n    hull = convex_hull(\r\n        points\r\n    )\r\n\r\n\r\n    if len(hull) < 2:\r\n\r\n        return None\r\n\r\n\r\n    # Z moyen du groupe\r\n    z_value = (\r\n        sum(\r\n            p[2]\r\n            for p in points\r\n        )\r\n        /\r\n        float(len(points))\r\n    )\r\n\r\n\r\n    best = None\r\n\r\n\r\n    for i in range(\r\n        len(hull)\r\n    ):\r\n\r\n        p0 = hull[i]\r\n\r\n        p1 = hull[\r\n            (i + 1) %\r\n            len(hull)\r\n        ]\r\n\r\n\r\n        dx = (\r\n            p1[0] -\r\n            p0[0]\r\n        )\r\n\r\n        dy = (\r\n            p1[1] -\r\n            p0[1]\r\n        )\r\n\r\n\r\n        length = math.sqrt(\r\n            dx * dx +\r\n            dy * dy\r\n        )\r\n\r\n\r\n        if length <= 1e-12:\r\n            continue\r\n\r\n\r\n        # Axe local U\r\n        ux = dx / length\r\n        uy = dy / length\r\n\r\n        # Axe local V\r\n        vx = -uy\r\n        vy = ux\r\n\r\n\r\n        min_u = float(\"inf\")\r\n        max_u = float(\"-inf\")\r\n\r\n        min_v = float(\"inf\")\r\n        max_v = float(\"-inf\")\r\n\r\n\r\n        for p in hull:\r\n\r\n            u = (\r\n                p[0] * ux +\r\n                p[1] * uy\r\n            )\r\n\r\n            v = (\r\n                p[0] * vx +\r\n                p[1] * vy\r\n            )\r\n\r\n\r\n            if u < min_u:\r\n                min_u = u\r\n\r\n            if u > max_u:\r\n                max_u = u\r\n\r\n            if v < min_v:\r\n                min_v = v\r\n\r\n            if v > max_v:\r\n                max_v = v\r\n\r\n\r\n        size_u = (\r\n            max_u -\r\n            min_u\r\n        )\r\n\r\n        size_v = (\r\n            max_v -\r\n            min_v\r\n        )\r\n\r\n\r\n        area = (\r\n            size_u *\r\n            size_v\r\n        )\r\n\r\n\r\n        if (\r\n            best is None\r\n            or\r\n            area < best[\"area\"]\r\n        ):\r\n\r\n            best = {\r\n\r\n                \"area\":\r\n                    area,\r\n\r\n                \"ux\":\r\n                    ux,\r\n\r\n                \"uy\":\r\n                    uy,\r\n\r\n                \"vx\":\r\n                    vx,\r\n\r\n                \"vy\":\r\n                    vy,\r\n\r\n                \"min_u\":\r\n                    min_u,\r\n\r\n                \"max_u\":\r\n                    max_u,\r\n\r\n                \"min_v\":\r\n                    min_v,\r\n\r\n                \"max_v\":\r\n                    max_v,\r\n\r\n                \"size_u\":\r\n                    size_u,\r\n\r\n                \"size_v\":\r\n                    size_v,\r\n\r\n                \"z\":\r\n                    z_value\r\n            }\r\n\r\n\r\n    if best is None:\r\n\r\n        return None\r\n\r\n\r\n    # ========================================================\r\n    # COINS DU RECTANGLE\r\n    # ========================================================\r\n\r\n    ux = best[\"ux\"]\r\n    uy = best[\"uy\"]\r\n\r\n    vx = best[\"vx\"]\r\n    vy = best[\"vy\"]\r\n\r\n    z = best[\"z\"]\r\n\r\n\r\n    def local_to_global(u, v):\r\n\r\n        x = (\r\n            u * ux +\r\n            v * vx\r\n        )\r\n\r\n        y = (\r\n            u * uy +\r\n            v * vy\r\n        )\r\n\r\n        return (\r\n            x,\r\n            y,\r\n            z\r\n        )\r\n\r\n\r\n    c0 = local_to_global(\r\n        best[\"min_u\"],\r\n        best[\"min_v\"]\r\n    )\r\n\r\n    c1 = local_to_global(\r\n        best[\"max_u\"],\r\n        best[\"min_v\"]\r\n    )\r\n\r\n    c2 = local_to_global(\r\n        best[\"max_u\"],\r\n        best[\"max_v\"]\r\n    )\r\n\r\n    c3 = local_to_global(\r\n        best[\"min_u\"],\r\n        best[\"max_v\"]\r\n    )\r\n\r\n\r\n    best[\"corners\"] = [\r\n        c0,\r\n        c1,\r\n        c2,\r\n        c3\r\n    ]\r\n\r\n\r\n    # ========================================================\r\n    # CENTRE\r\n    # ========================================================\r\n\r\n    center_u = (\r\n        best[\"min_u\"] +\r\n        best[\"max_u\"]\r\n    ) * 0.5\r\n\r\n    center_v = (\r\n        best[\"min_v\"] +\r\n        best[\"max_v\"]\r\n    ) * 0.5\r\n\r\n\r\n    best[\"center\"] = (\r\n        center_u * ux +\r\n        center_v * vx,\r\n\r\n        center_u * uy +\r\n        center_v * vy,\r\n\r\n        z\r\n    )\r\n\r\n\r\n    # ========================================================\r\n    # On normalise :\r\n    #\r\n    # longueur = grande dimension\r\n    # largeur  = petite dimension\r\n    #\r\n    # direction_longue = direction de la grande dimension\r\n    # ========================================================\r\n\r\n    if (\r\n        best[\"size_u\"] >=\r\n        best[\"size_v\"]\r\n    ):\r\n\r\n        best[\"long_size\"] = (\r\n            best[\"size_u\"]\r\n        )\r\n\r\n        best[\"short_size\"] = (\r\n            best[\"size_v\"]\r\n        )\r\n\r\n        best[\"long_dir\"] = (\r\n            ux,\r\n            uy\r\n        )\r\n\r\n    else:\r\n\r\n        best[\"long_size\"] = (\r\n            best[\"size_v\"]\r\n        )\r\n\r\n        best[\"short_size\"] = (\r\n            best[\"size_u\"]\r\n        )\r\n\r\n        best[\"long_dir\"] = (\r\n            vx,\r\n            vy\r\n        )\r\n\r\n\r\n    angle = math.degrees(\r\n        math.atan2(\r\n            best[\"long_dir\"][1],\r\n            best[\"long_dir\"][0]\r\n        )\r\n    )\r\n\r\n\r\n    # Orientation sans sens :\r\n    # 0 <= angle < 180\r\n    angle = (\r\n        angle %\r\n        180.0\r\n    )\r\n\r\n\r\n    best[\"angle_deg\"] = (\r\n        angle\r\n    )\r\n\r\n\r\n    return best\r\n\r\n\r\n# ============================================================\r\n# CREATION DES RECTANGLES DESIGN SCRIPT\r\n# ============================================================\r\n\r\nrectangles = []\r\n\r\nrectangle_infos = []\r\n\r\nfailed_rectangles = 0\r\n\r\n\r\nfor group_index, group in enumerate(\r\n    groups\r\n):\r\n\r\n    points = []\r\n\r\n\r\n    # --------------------------------------------------------\r\n    # Echantillonner toutes les courbes du groupe\r\n    # --------------------------------------------------------\r\n\r\n    for curve in group:\r\n\r\n        curve_points = sample_curve(\r\n            curve,\r\n            samples_per_curve\r\n        )\r\n\r\n        points.extend(\r\n            curve_points\r\n        )\r\n\r\n\r\n    if len(points) < 2:\r\n\r\n        rectangles.append(\r\n            []\r\n        )\r\n\r\n        rectangle_infos.append({\r\n\r\n            \"Groupe\":\r\n                group_index,\r\n\r\n            \"Valide\":\r\n                False\r\n        })\r\n\r\n        failed_rectangles += 1\r\n\r\n        continue\r\n\r\n\r\n    result = minimum_oriented_rectangle(\r\n        points\r\n    )\r\n\r\n\r\n    if result is None:\r\n\r\n        rectangles.append(\r\n            []\r\n        )\r\n\r\n        rectangle_infos.append({\r\n\r\n            \"Groupe\":\r\n                group_index,\r\n\r\n            \"Valide\":\r\n                False\r\n        })\r\n\r\n        failed_rectangles += 1\r\n\r\n        continue\r\n\r\n\r\n    corners = result[\r\n        \"corners\"\r\n    ]\r\n\r\n\r\n    # --------------------------------------------------------\r\n    # Créer 4 points DS\r\n    # --------------------------------------------------------\r\n\r\n    ds_points = []\r\n\r\n    for c in corners:\r\n\r\n        ds_points.append(\r\n            Point.ByCoordinates(\r\n                c[0],\r\n                c[1],\r\n                c[2]\r\n            )\r\n        )\r\n\r\n\r\n    # --------------------------------------------------------\r\n    # Créer 4 lignes fermées\r\n    # --------------------------------------------------------\r\n\r\n    rectangle_lines = []\r\n\r\n    for i in range(4):\r\n\r\n        line = Line.ByStartPointEndPoint(\r\n\r\n            ds_points[i],\r\n\r\n            ds_points[\r\n                (i + 1) % 4\r\n            ]\r\n        )\r\n\r\n        rectangle_lines.append(\r\n            line\r\n        )\r\n\r\n\r\n    rectangles.append(\r\n        rectangle_lines\r\n    )\r\n\r\n\r\n    # --------------------------------------------------------\r\n    # Centre DS\r\n    # --------------------------------------------------------\r\n\r\n    center = result[\r\n        \"center\"\r\n    ]\r\n\r\n    center_point = (\r\n        Point.ByCoordinates(\r\n            center[0],\r\n            center[1],\r\n            center[2]\r\n        )\r\n    )\r\n\r\n\r\n    # --------------------------------------------------------\r\n    # Informations utiles pour MUR_04\r\n    # --------------------------------------------------------\r\n\r\n    rectangle_infos.append({\r\n\r\n        \"Groupe\":\r\n            group_index,\r\n\r\n        \"Valide\":\r\n            True,\r\n\r\n        \"NbCourbes\":\r\n            len(group),\r\n\r\n        \"Centre\":\r\n            center_point,\r\n\r\n        \"GrandeDimension_mm\":\r\n            round(\r\n                project_to_mm(\r\n                    result[\r\n                        \"long_size\"\r\n                    ]\r\n                ),\r\n                1\r\n            ),\r\n\r\n        \"PetiteDimension_mm\":\r\n            round(\r\n                project_to_mm(\r\n                    result[\r\n                        \"short_size\"\r\n                    ]\r\n                ),\r\n                1\r\n            ),\r\n\r\n        \"Angle_deg\":\r\n            round(\r\n                result[\r\n                    \"angle_deg\"\r\n                ],\r\n                3\r\n            )\r\n    })\r\n\r\n\r\n# ============================================================\r\n# DIAGNOSTIC\r\n# ============================================================\r\n\r\nlargest_group = (\r\n    max(group_sizes)\r\n    if group_sizes\r\n    else 0\r\n)\r\n\r\nsmallest_group = (\r\n    min(group_sizes)\r\n    if group_sizes\r\n    else 0\r\n)\r\n\r\naverage_group = (\r\n    round(\r\n        sum(group_sizes) /\r\n        float(len(group_sizes)),\r\n        2\r\n    )\r\n    if group_sizes\r\n    else 0\r\n)\r\n\r\n\r\ndiagnostic = {\r\n\r\n    \"Courbes entree\":\r\n        len(curves),\r\n\r\n    \"Courbes valides\":\r\n        len(valid_curves),\r\n\r\n    \"Courbes invalides\":\r\n        len(invalid_curves),\r\n\r\n    \"Connexions detectees\":\r\n        connection_count,\r\n\r\n    \"Composantes totales\":\r\n        len(components),\r\n\r\n    \"Groupes portes\":\r\n        len(groups),\r\n\r\n    \"Rectangles generes\":\r\n        (\r\n            len(groups) -\r\n            failed_rectangles\r\n        ),\r\n\r\n    \"Rectangles echoues\":\r\n        failed_rectangles,\r\n\r\n    \"Courbes rejetees/isolees\":\r\n        len(rejected_curves),\r\n\r\n    \"Taille groupe minimum\":\r\n        smallest_group,\r\n\r\n    \"Taille groupe maximum\":\r\n        largest_group,\r\n\r\n    \"Taille groupe moyenne\":\r\n        average_group,\r\n\r\n    \"Tolerance connexion mm\":\r\n        connection_tol_mm,\r\n\r\n    \"Nb minimum courbes groupe\":\r\n        min_curves_group,\r\n\r\n    \"Echantillons par courbe\":\r\n        samples_per_curve\r\n}\r\n\r\n\r\n# ============================================================\r\n# OUTPUT\r\n# ============================================================\r\n\r\nOUT = (\r\n    groups,             # OUT[0]\r\n    rectangles,         # OUT[1]\r\n    rectangle_infos,    # OUT[2]\r\n    rejected_curves,    # OUT[3]\r\n    diagnostic          # OUT[4]\r\n)",
      "Engine": "PythonNet3",
      "VariableInputPorts": true,
      "Id": "fb9838f47a8c4d85ace27e985882e1e0",
