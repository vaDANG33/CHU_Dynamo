    {
      "ConcreteType": "PythonNodeModels.PythonNode, PythonNodeModels",
      "Code": "# -*- coding: utf-8 -*-\r\n\r\nimport clr\r\nimport math\r\n\r\nclr.AddReference(\"ProtoGeometry\")\r\nfrom Autodesk.DesignScript.Geometry import Point, Line\r\n\r\nclr.AddReference(\"RevitAPI\")\r\nfrom Autodesk.Revit.DB import UnitUtils, UnitTypeId, SpecTypeId\r\n\r\nclr.AddReference(\"RevitServices\")\r\nfrom RevitServices.Persistence import DocumentManager\r\n\r\n\r\n# ============================================================\r\n# MUR_04_AssocierPortesAxes V2\r\n#\r\n# CAS A\r\n# Deux axes colineaires de part et d'autre d'une porte :\r\n#\r\n#   --------> [PORTE] <--------\r\n#\r\n#   => connexion entre les deux axes\r\n#\r\n#\r\n# CAS B\r\n# Un seul axe arrive vers la porte :\r\n#\r\n#   --------> [PORTE]\r\n#\r\n#   => prolongement de cet axe jusqu'au côté opposé\r\n#      du rectangle.\r\n#\r\n#\r\n# Ce noeud produit de la géométrie proposée.\r\n# Il ne modifie pas encore définitivement les axes MUR_03.\r\n# ============================================================\r\n\r\n\r\n# ============================================================\r\n# INPUTS\r\n# ============================================================\r\n\r\nwall_axes = IN[0] if IN[0] else []\r\nwall_widths_mm = IN[1] if IN[1] else []\r\n\r\ndoor_rectangles = IN[2] if IN[2] else []\r\ndoor_infos = IN[3] if IN[3] else []\r\n\r\nsearch_distance_mm = (\r\n    float(IN[4])\r\n    if IN[4] is not None\r\n    else 300.0\r\n)\r\n\r\ncollinear_tol_mm = (\r\n    float(IN[5])\r\n    if IN[5] is not None\r\n    else 30.0\r\n)\r\n\r\nangle_tol_deg = (\r\n    float(IN[6])\r\n    if IN[6] is not None\r\n    else 1.0\r\n)\r\n\r\n\r\n# ============================================================\r\n# UNITES\r\n# ============================================================\r\n\r\ndoc = DocumentManager.Instance.CurrentDBDocument\r\n\r\nproject_unit_id = (\r\n    doc.GetUnits()\r\n       .GetFormatOptions(SpecTypeId.Length)\r\n       .GetUnitTypeId()\r\n)\r\n\r\n\r\ndef mm_to_project(value_mm):\r\n\r\n    internal = UnitUtils.ConvertToInternalUnits(\r\n        value_mm,\r\n        UnitTypeId.Millimeters\r\n    )\r\n\r\n    return UnitUtils.ConvertFromInternalUnits(\r\n        internal,\r\n        project_unit_id\r\n    )\r\n\r\n\r\ndef project_to_mm(value):\r\n\r\n    internal = UnitUtils.ConvertToInternalUnits(\r\n        value,\r\n        project_unit_id\r\n    )\r\n\r\n    return UnitUtils.ConvertFromInternalUnits(\r\n        internal,\r\n        UnitTypeId.Millimeters\r\n    )\r\n\r\n\r\nsearch_distance = mm_to_project(search_distance_mm)\r\ncollinear_tol = mm_to_project(collinear_tol_mm)\r\n\r\n\r\n# ============================================================\r\n# OUTILS GENERAUX\r\n# ============================================================\r\n\r\ndef flatten(data):\r\n\r\n    result = []\r\n\r\n    if isinstance(data, (list, tuple)):\r\n\r\n        for item in data:\r\n            result.extend(flatten(item))\r\n\r\n    elif data is not None:\r\n\r\n        result.append(data)\r\n\r\n    return result\r\n\r\n\r\nwall_axes = flatten(wall_axes)\r\n\r\n\r\ndef xyz(point):\r\n\r\n    return (\r\n        float(point.X),\r\n        float(point.Y),\r\n        float(point.Z)\r\n    )\r\n\r\n\r\ndef distance2d(a, b):\r\n\r\n    dx = a[0] - b[0]\r\n    dy = a[1] - b[1]\r\n\r\n    return math.sqrt(\r\n        dx * dx +\r\n        dy * dy\r\n    )\r\n\r\n\r\ndef dot2(a, b):\r\n\r\n    return (\r\n        a[0] * b[0] +\r\n        a[1] * b[1]\r\n    )\r\n\r\n\r\ndef normalize2(v):\r\n\r\n    length = math.sqrt(\r\n        v[0] * v[0] +\r\n        v[1] * v[1]\r\n    )\r\n\r\n    if length <= 1e-12:\r\n        return None\r\n\r\n    return (\r\n        v[0] / length,\r\n        v[1] / length\r\n    )\r\n\r\n\r\ndef get_info(info, key, default=None):\r\n\r\n    try:\r\n        return info[key]\r\n    except:\r\n        pass\r\n\r\n    try:\r\n        return info.get(key, default)\r\n    except:\r\n        return default\r\n\r\n\r\ndef make_point(p):\r\n\r\n    return Point.ByCoordinates(\r\n        p[0],\r\n        p[1],\r\n        p[2]\r\n    )\r\n\r\n\r\ndef make_line(a, b):\r\n\r\n    if distance2d(a, b) <= 1e-9:\r\n        return None\r\n\r\n    pa = make_point(a)\r\n    pb = make_point(b)\r\n\r\n    try:\r\n        return Line.ByStartPointEndPoint(pa, pb)\r\n    except:\r\n        return None\r\n\r\n\r\n# ============================================================\r\n# MURS\r\n# ============================================================\r\n\r\ndef wall_data(line, index):\r\n\r\n    try:\r\n\r\n        p0 = xyz(line.StartPoint)\r\n        p1 = xyz(line.EndPoint)\r\n\r\n    except:\r\n        return None\r\n\r\n\r\n    direction = normalize2(\r\n        (\r\n            p1[0] - p0[0],\r\n            p1[1] - p0[1]\r\n        )\r\n    )\r\n\r\n\r\n    if direction is None:\r\n        return None\r\n\r\n\r\n    return {\r\n\r\n        \"index\": index,\r\n\r\n        \"line\": line,\r\n\r\n        \"p0\": p0,\r\n        \"p1\": p1,\r\n\r\n        \"dir\": direction,\r\n\r\n        \"length\": distance2d(p0, p1)\r\n    }\r\n\r\n\r\n# ============================================================\r\n# RECTANGLES\r\n# ============================================================\r\n\r\ndef rectangle_data(rectangle):\r\n\r\n    if not rectangle:\r\n        return None\r\n\r\n\r\n    if len(rectangle) < 4:\r\n        return None\r\n\r\n\r\n    # --------------------------------------------------------\r\n    # Les 4 lignes produites par PORTE_01 sont ordonnées.\r\n    # --------------------------------------------------------\r\n\r\n    try:\r\n\r\n        p0 = xyz(rectangle[0].StartPoint)\r\n        p1 = xyz(rectangle[0].EndPoint)\r\n\r\n        p2 = xyz(rectangle[1].EndPoint)\r\n        p3 = xyz(rectangle[2].EndPoint)\r\n\r\n    except:\r\n        return None\r\n\r\n\r\n    points = [\r\n        p0,\r\n        p1,\r\n        p2,\r\n        p3\r\n    ]\r\n\r\n\r\n    cx = sum(p[0] for p in points) / 4.0\r\n    cy = sum(p[1] for p in points) / 4.0\r\n    cz = sum(p[2] for p in points) / 4.0\r\n\r\n\r\n    u = normalize2(\r\n        (\r\n            p1[0] - p0[0],\r\n            p1[1] - p0[1]\r\n        )\r\n    )\r\n\r\n    v = normalize2(\r\n        (\r\n            p2[0] - p1[0],\r\n            p2[1] - p1[1]\r\n        )\r\n    )\r\n\r\n\r\n    if u is None or v is None:\r\n        return None\r\n\r\n\r\n    size_u = distance2d(p0, p1)\r\n    size_v = distance2d(p1, p2)\r\n\r\n\r\n    return {\r\n\r\n        \"rectangle\": rectangle,\r\n\r\n        \"points\": points,\r\n\r\n        \"center\": (\r\n            cx,\r\n            cy,\r\n            cz\r\n        ),\r\n\r\n        \"u\": u,\r\n        \"v\": v,\r\n\r\n        \"size_u\": size_u,\r\n        \"size_v\": size_v,\r\n\r\n        \"half_u\": size_u * 0.5,\r\n        \"half_v\": size_v * 0.5\r\n    }\r\n\r\n\r\n# ============================================================\r\n# DISTANCE POINT -> RECTANGLE ORIENTE\r\n# ============================================================\r\n\r\ndef point_rectangle_distance(point, rect):\r\n\r\n    center = rect[\"center\"]\r\n\r\n    rel = (\r\n        point[0] - center[0],\r\n        point[1] - center[1]\r\n    )\r\n\r\n\r\n    local_u = dot2(\r\n        rel,\r\n        rect[\"u\"]\r\n    )\r\n\r\n    local_v = dot2(\r\n        rel,\r\n        rect[\"v\"]\r\n    )\r\n\r\n\r\n    du = max(\r\n        abs(local_u) - rect[\"half_u\"],\r\n        0.0\r\n    )\r\n\r\n    dv = max(\r\n        abs(local_v) - rect[\"half_v\"],\r\n        0.0\r\n    )\r\n\r\n\r\n    return math.sqrt(\r\n        du * du +\r\n        dv * dv\r\n    )\r\n\r\n\r\n# ============================================================\r\n# INTERSECTION DROITE INFINIE / RECTANGLE\r\n#\r\n# Retourne :\r\n#\r\n# None\r\n#\r\n# ou\r\n#\r\n# {\r\n#     \"point1\": ...\r\n#     \"point2\": ...\r\n#     \"t1\": ...\r\n#     \"t2\": ...\r\n# }\r\n#\r\n# Les deux points sont les deux intersections de la droite\r\n# avec les côtés opposés du rectangle.\r\n# ============================================================\r\n\r\ndef line_rectangle_intersections(\r\n    point,\r\n    direction,\r\n    rect\r\n):\r\n\r\n    center = rect[\"center\"]\r\n\r\n\r\n    rel = (\r\n        point[0] - center[0],\r\n        point[1] - center[1]\r\n    )\r\n\r\n\r\n    # Point en repère rectangle\r\n    pu = dot2(\r\n        rel,\r\n        rect[\"u\"]\r\n    )\r\n\r\n    pv = dot2(\r\n        rel,\r\n        rect[\"v\"]\r\n    )\r\n\r\n\r\n    # Direction en repère rectangle\r\n    du = dot2(\r\n        direction,\r\n        rect[\"u\"]\r\n    )\r\n\r\n    dv = dot2(\r\n        direction,\r\n        rect[\"v\"]\r\n    )\r\n\r\n\r\n    t_min = float(\"-inf\")\r\n    t_max = float(\"inf\")\r\n\r\n\r\n    # ========================================================\r\n    # SLAB U\r\n    # ========================================================\r\n\r\n    if abs(du) < 1e-12:\r\n\r\n        if abs(pu) > rect[\"half_u\"]:\r\n            return None\r\n\r\n    else:\r\n\r\n        ta = (\r\n            -rect[\"half_u\"] - pu\r\n        ) / du\r\n\r\n        tb = (\r\n            rect[\"half_u\"] - pu\r\n        ) / du\r\n\r\n\r\n        if ta > tb:\r\n            ta, tb = tb, ta\r\n\r\n\r\n        t_min = max(t_min, ta)\r\n        t_max = min(t_max, tb)\r\n\r\n\r\n        if t_min > t_max:\r\n            return None\r\n\r\n\r\n    # ========================================================\r\n    # SLAB V\r\n    # ========================================================\r\n\r\n    if abs(dv) < 1e-12:\r\n\r\n        if abs(pv) > rect[\"half_v\"]:\r\n            return None\r\n\r\n    else:\r\n\r\n        ta = (\r\n            -rect[\"half_v\"] - pv\r\n        ) / dv\r\n\r\n        tb = (\r\n            rect[\"half_v\"] - pv\r\n        ) / dv\r\n\r\n\r\n        if ta > tb:\r\n            ta, tb = tb, ta\r\n\r\n\r\n        t_min = max(t_min, ta)\r\n        t_max = min(t_max, tb)\r\n\r\n\r\n        if t_min > t_max:\r\n            return None\r\n\r\n\r\n    if (\r\n        not math.isfinite(t_min)\r\n        or\r\n        not math.isfinite(t_max)\r\n    ):\r\n        return None\r\n\r\n\r\n    z = point[2]\r\n\r\n\r\n    p1 = (\r\n\r\n        point[0] +\r\n        t_min * direction[0],\r\n\r\n        point[1] +\r\n        t_min * direction[1],\r\n\r\n        z\r\n    )\r\n\r\n\r\n    p2 = (\r\n\r\n        point[0] +\r\n        t_max * direction[0],\r\n\r\n        point[1] +\r\n        t_max * direction[1],\r\n\r\n        z\r\n    )\r\n\r\n\r\n    return {\r\n\r\n        \"point1\": p1,\r\n        \"point2\": p2,\r\n\r\n        \"t1\": t_min,\r\n        \"t2\": t_max\r\n    }\r\n\r\n\r\n# ============================================================\r\n# ANGLE\r\n# ============================================================\r\n\r\ndef angle_difference_deg(\r\n    dir_a,\r\n    dir_b\r\n):\r\n\r\n    value = abs(\r\n        dot2(\r\n            dir_a,\r\n            dir_b\r\n        )\r\n    )\r\n\r\n\r\n    value = max(\r\n        0.0,\r\n        min(\r\n            1.0,\r\n            value\r\n        )\r\n    )\r\n\r\n\r\n    return math.degrees(\r\n        math.acos(value)\r\n    )\r\n\r\n\r\n# ============================================================\r\n# DISTANCE ENTRE DROITES SUPPORT\r\n# ============================================================\r\n\r\ndef support_line_distance(\r\n    wall_a,\r\n    wall_b\r\n):\r\n\r\n    direction = wall_a[\"dir\"]\r\n\r\n    normal = (\r\n        -direction[1],\r\n        direction[0]\r\n    )\r\n\r\n\r\n    vector = (\r\n\r\n        wall_b[\"p0\"][0] -\r\n        wall_a[\"p0\"][0],\r\n\r\n        wall_b[\"p0\"][1] -\r\n        wall_a[\"p0\"][1]\r\n    )\r\n\r\n\r\n    return abs(\r\n        dot2(\r\n            vector,\r\n            normal\r\n        )\r\n    )\r\n\r\n\r\n# ============================================================\r\n# EXTREMITE LA PLUS PROCHE DU RECTANGLE\r\n# ============================================================\r\n\r\ndef closest_endpoint_to_rectangle(\r\n    wall,\r\n    rect\r\n):\r\n\r\n    d0 = point_rectangle_distance(\r\n        wall[\"p0\"],\r\n        rect\r\n    )\r\n\r\n    d1 = point_rectangle_distance(\r\n        wall[\"p1\"],\r\n        rect\r\n    )\r\n\r\n\r\n    if d0 <= d1:\r\n\r\n        return {\r\n            \"point\": wall[\"p0\"],\r\n            \"distance\": d0,\r\n            \"endpoint_id\": 0\r\n        }\r\n\r\n    else:\r\n\r\n        return {\r\n            \"point\": wall[\"p1\"],\r\n            \"distance\": d1,\r\n            \"endpoint_id\": 1\r\n        }\r\n\r\n\r\n# ============================================================\r\n# COTE D'UNE EXTREMITE PAR RAPPORT AU CENTRE\r\n# ============================================================\r\n\r\ndef signed_position(\r\n    point,\r\n    center,\r\n    direction\r\n):\r\n\r\n    vector = (\r\n\r\n        point[0] - center[0],\r\n        point[1] - center[1]\r\n    )\r\n\r\n\r\n    return dot2(\r\n        vector,\r\n        direction\r\n    )\r\n\r\n\r\n# ============================================================\r\n# POINT D'INTERSECTION OPPOSE A UNE EXTREMITE\r\n#\r\n# La droite coupe le rectangle en P1 et P2.\r\n#\r\n# On prend comme destination le point d'intersection\r\n# le plus éloigné de l'extrémité existante.\r\n# ============================================================\r\n\r\ndef opposite_rectangle_point(\r\n    endpoint,\r\n    intersections\r\n):\r\n\r\n    p1 = intersections[\"point1\"]\r\n    p2 = intersections[\"point2\"]\r\n\r\n\r\n    d1 = distance2d(\r\n        endpoint,\r\n        p1\r\n    )\r\n\r\n    d2 = distance2d(\r\n        endpoint,\r\n        p2\r\n    )\r\n\r\n\r\n    if d1 >= d2:\r\n        return p1\r\n\r\n    return p2\r\n\r\n\r\n# ============================================================\r\n# PREPARATION MURS\r\n# ============================================================\r\n\r\nwalls = []\r\n\r\n\r\nfor i, axis in enumerate(wall_axes):\r\n\r\n    data = wall_data(\r\n        axis,\r\n        i\r\n    )\r\n\r\n\r\n    if data is None:\r\n        continue\r\n\r\n\r\n    width_mm = None\r\n\r\n\r\n    if i < len(wall_widths_mm):\r\n\r\n        try:\r\n\r\n            width_mm = float(\r\n                wall_widths_mm[i]\r\n            )\r\n\r\n        except:\r\n            pass\r\n\r\n\r\n    data[\"width_mm\"] = width_mm\r\n\r\n    walls.append(data)\r\n\r\n\r\n# ============================================================\r\n# PREPARATION PORTES\r\n# ============================================================\r\n\r\nrectangles = []\r\n\r\n\r\nfor i, rectangle in enumerate(\r\n    door_rectangles\r\n):\r\n\r\n    data = rectangle_data(\r\n        rectangle\r\n    )\r\n\r\n\r\n    if data is None:\r\n        continue\r\n\r\n\r\n    data[\"index\"] = i\r\n\r\n\r\n    if i < len(door_infos):\r\n\r\n        data[\"info\"] = (\r\n            door_infos[i]\r\n        )\r\n\r\n    else:\r\n\r\n        data[\"info\"] = None\r\n\r\n\r\n    rectangles.append(data)\r\n\r\n\r\n# ============================================================\r\n# OUTPUTS\r\n# ============================================================\r\n\r\nwall_pairs = []\r\n\r\ntwo_axis_connections = []\r\n\r\nsingle_axis_extensions = []\r\n\r\nassociations = []\r\n\r\ndoors_without_solution = []\r\n\r\nambiguous_doors = []\r\n\r\n\r\n# ============================================================\r\n# DIAGNOSTIC\r\n# ============================================================\r\n\r\ndoors_with_candidates = 0\r\n\r\ndoors_two_axes = 0\r\ndoors_one_axis = 0\r\n\r\ndoors_no_solution_count = 0\r\n\r\ndoors_ambiguous_count = 0\r\n\r\ntotal_candidates = 0\r\nmax_candidates = 0\r\n\r\npair_tests = 0\r\n\r\nsingle_extensions_created = 0\r\n\r\n\r\n# ============================================================\r\n# BOUCLE PORTES\r\n# ============================================================\r\n\r\nfor rect in rectangles:\r\n\r\n    center = rect[\"center\"]\r\n\r\n\r\n    # ========================================================\r\n    # ETAPE 1\r\n    # AXES CANDIDATS\r\n    # ========================================================\r\n\r\n    candidates = []\r\n\r\n\r\n    for wall in walls:\r\n\r\n        closest = (\r\n            closest_endpoint_to_rectangle(\r\n                wall,\r\n                rect\r\n            )\r\n        )\r\n\r\n\r\n        # ----------------------------------------------------\r\n        # Extrémité suffisamment proche\r\n        # ----------------------------------------------------\r\n\r\n        if (\r\n            closest[\"distance\"] >\r\n            search_distance\r\n        ):\r\n            continue\r\n\r\n\r\n        # ----------------------------------------------------\r\n        # Droite support traverse le rectangle\r\n        # ----------------------------------------------------\r\n\r\n        intersections = (\r\n            line_rectangle_intersections(\r\n                wall[\"p0\"],\r\n                wall[\"dir\"],\r\n                rect\r\n            )\r\n        )\r\n\r\n\r\n        if intersections is None:\r\n            continue\r\n\r\n\r\n        candidates.append({\r\n\r\n            \"wall\":\r\n                wall,\r\n\r\n            \"endpoint\":\r\n                closest[\"point\"],\r\n\r\n            \"endpoint_id\":\r\n                closest[\"endpoint_id\"],\r\n\r\n            \"distance\":\r\n                closest[\"distance\"],\r\n\r\n            \"intersections\":\r\n                intersections\r\n        })\r\n\r\n\r\n    total_candidates += len(candidates)\r\n\r\n    max_candidates = max(\r\n        max_candidates,\r\n        len(candidates)\r\n    )\r\n\r\n\r\n    if candidates:\r\n        doors_with_candidates += 1\r\n\r\n\r\n    # ========================================================\r\n    # ETAPE 2\r\n    # CHERCHER UNE PAIRE DE DEUX AXES\r\n    # ========================================================\r\n\r\n    possible_pairs = []\r\n\r\n\r\n    if len(candidates) >= 2:\r\n\r\n        for i in range(len(candidates)):\r\n\r\n            for j in range(\r\n                i + 1,\r\n                len(candidates)\r\n            ):\r\n\r\n                pair_tests += 1\r\n\r\n\r\n                ca = candidates[i]\r\n                cb = candidates[j]\r\n\r\n                wa = ca[\"wall\"]\r\n                wb = cb[\"wall\"]\r\n\r\n\r\n                # --------------------------------------------\r\n                # A. Angle\r\n                # --------------------------------------------\r\n\r\n                angle = angle_difference_deg(\r\n                    wa[\"dir\"],\r\n                    wb[\"dir\"]\r\n                )\r\n\r\n\r\n                if angle > angle_tol_deg:\r\n                    continue\r\n\r\n\r\n                # --------------------------------------------\r\n                # B. Colinéarité\r\n                # --------------------------------------------\r\n\r\n                line_distance = (\r\n                    support_line_distance(\r\n                        wa,\r\n                        wb\r\n                    )\r\n                )\r\n\r\n\r\n                if (\r\n                    line_distance >\r\n                    collinear_tol\r\n                ):\r\n                    continue\r\n\r\n\r\n                # --------------------------------------------\r\n                # C. Axes de part et d'autre de la porte\r\n                # --------------------------------------------\r\n\r\n                sa = signed_position(\r\n                    ca[\"endpoint\"],\r\n                    center,\r\n                    wa[\"dir\"]\r\n                )\r\n\r\n                sb = signed_position(\r\n                    cb[\"endpoint\"],\r\n                    center,\r\n                    wa[\"dir\"]\r\n                )\r\n\r\n\r\n                if sa * sb >= 0.0:\r\n                    continue\r\n\r\n\r\n                # --------------------------------------------\r\n                # D. Gap entre extrémités\r\n                # --------------------------------------------\r\n\r\n                gap = distance2d(\r\n                    ca[\"endpoint\"],\r\n                    cb[\"endpoint\"]\r\n                )\r\n\r\n\r\n                # --------------------------------------------\r\n                # E. Score\r\n                # --------------------------------------------\r\n\r\n                score = (\r\n\r\n                    ca[\"distance\"] +\r\n                    cb[\"distance\"] +\r\n\r\n                    2.0 *\r\n                    line_distance +\r\n\r\n                    mm_to_project(\r\n                        angle * 10.0\r\n                    )\r\n                )\r\n\r\n\r\n                possible_pairs.append({\r\n\r\n                    \"a\": ca,\r\n                    \"b\": cb,\r\n\r\n                    \"angle\": angle,\r\n\r\n                    \"line_distance\":\r\n                        line_distance,\r\n\r\n                    \"gap\":\r\n                        gap,\r\n\r\n                    \"score\":\r\n                        score\r\n                })\r\n\r\n\r\n    # ========================================================\r\n    # CAS A\r\n    # UNE PAIRE DE DEUX AXES EXISTE\r\n    # ========================================================\r\n\r\n    if possible_pairs:\r\n\r\n        possible_pairs.sort(\r\n            key=lambda x:\r\n                x[\"score\"]\r\n        )\r\n\r\n\r\n        best = possible_pairs[0]\r\n\r\n\r\n        ambiguous = False\r\n\r\n\r\n        if len(possible_pairs) > 1:\r\n\r\n            second = possible_pairs[1]\r\n\r\n            score_difference = (\r\n                second[\"score\"] -\r\n                best[\"score\"]\r\n            )\r\n\r\n\r\n            if (\r\n                score_difference <\r\n                mm_to_project(50.0)\r\n            ):\r\n\r\n                ambiguous = True\r\n\r\n\r\n        ca = best[\"a\"]\r\n        cb = best[\"b\"]\r\n\r\n        wa = ca[\"wall\"]\r\n        wb = cb[\"wall\"]\r\n\r\n\r\n        connection = make_line(\r\n            ca[\"endpoint\"],\r\n            cb[\"endpoint\"]\r\n        )\r\n\r\n\r\n        if connection is not None:\r\n\r\n            two_axis_connections.append(\r\n                connection\r\n            )\r\n\r\n\r\n        wall_pairs.append([\r\n            wa[\"line\"],\r\n            wb[\"line\"]\r\n        ])\r\n\r\n\r\n        association = {\r\n\r\n            \"PorteIndex\":\r\n                rect[\"index\"],\r\n\r\n            \"Mode\":\r\n                \"DeuxAxes\",\r\n\r\n            \"MurA\":\r\n                wa[\"index\"],\r\n\r\n            \"MurB\":\r\n                wb[\"index\"],\r\n\r\n            \"DistanceA_mm\":\r\n                round(\r\n                    project_to_mm(\r\n                        ca[\"distance\"]\r\n                    ),\r\n                    1\r\n                ),\r\n\r\n            \"DistanceB_mm\":\r\n                round(\r\n                    project_to_mm(\r\n                        cb[\"distance\"]\r\n                    ),\r\n                    1\r\n                ),\r\n\r\n            \"AngleDifference_deg\":\r\n                round(\r\n                    best[\"angle\"],\r\n                    3\r\n                ),\r\n\r\n            \"DecalageAxes_mm\":\r\n                round(\r\n                    project_to_mm(\r\n                        best[\r\n                            \"line_distance\"\r\n                        ]\r\n                    ),\r\n                    1\r\n                ),\r\n\r\n            \"Gap_mm\":\r\n                round(\r\n                    project_to_mm(\r\n                        best[\"gap\"]\r\n                    ),\r\n                    1\r\n                ),\r\n\r\n            \"NbAxesCandidats\":\r\n                len(candidates),\r\n\r\n            \"NbPairesPossibles\":\r\n                len(possible_pairs),\r\n\r\n            \"Ambigu\":\r\n                ambiguous\r\n        }\r\n\r\n\r\n        associations.append(\r\n            association\r\n        )\r\n\r\n\r\n        doors_two_axes += 1\r\n\r\n\r\n        if ambiguous:\r\n\r\n            doors_ambiguous_count += 1\r\n\r\n            ambiguous_doors.append(\r\n                rect[\"rectangle\"]\r\n            )\r\n\r\n\r\n        # Porte traitée :\r\n        # on ne crée PAS de prolongement simple.\r\n        continue\r\n\r\n\r\n    # ========================================================\r\n    # CAS B\r\n    # PAS DE PAIRE\r\n    #\r\n    # On cherche maintenant le meilleur axe individuel.\r\n    # ========================================================\r\n\r\n    if candidates:\r\n\r\n        # ----------------------------------------------------\r\n        # Axe dont l'extrémité est la plus proche\r\n        # du rectangle.\r\n        # ----------------------------------------------------\r\n\r\n        candidates.sort(\r\n            key=lambda x:\r\n                x[\"distance\"]\r\n        )\r\n\r\n\r\n        best = candidates[0]\r\n\r\n\r\n        wall = best[\"wall\"]\r\n\r\n        endpoint = best[\"endpoint\"]\r\n\r\n\r\n        # ----------------------------------------------------\r\n        # Point situé sur le côté opposé du rectangle.\r\n        # ----------------------------------------------------\r\n\r\n        destination = (\r\n            opposite_rectangle_point(\r\n                endpoint,\r\n                best[\"intersections\"]\r\n            )\r\n        )\r\n\r\n\r\n        extension = make_line(\r\n            endpoint,\r\n            destination\r\n        )\r\n\r\n\r\n        if extension is not None:\r\n\r\n            single_axis_extensions.append(\r\n                extension\r\n            )\r\n\r\n            single_extensions_created += 1\r\n\r\n\r\n            association = {\r\n\r\n                \"PorteIndex\":\r\n                    rect[\"index\"],\r\n\r\n                \"Mode\":\r\n                    \"UnAxe\",\r\n\r\n                \"MurA\":\r\n                    wall[\"index\"],\r\n\r\n                \"MurB\":\r\n                    None,\r\n\r\n                \"DistanceA_mm\":\r\n                    round(\r\n                        project_to_mm(\r\n                            best[\"distance\"]\r\n                        ),\r\n                        1\r\n                    ),\r\n\r\n                \"LongueurProlongement_mm\":\r\n                    round(\r\n                        project_to_mm(\r\n                            distance2d(\r\n                                endpoint,\r\n                                destination\r\n                            )\r\n                        ),\r\n                        1\r\n                    ),\r\n\r\n                \"NbAxesCandidats\":\r\n                    len(candidates),\r\n\r\n                \"Ambigu\":\r\n                    False\r\n            }\r\n\r\n\r\n            associations.append(\r\n                association\r\n            )\r\n\r\n\r\n            doors_one_axis += 1\r\n\r\n            continue\r\n\r\n\r\n    # ========================================================\r\n    # CAS C\r\n    # AUCUNE SOLUTION\r\n    # ========================================================\r\n\r\n    doors_without_solution.append(\r\n        rect[\"rectangle\"]\r\n    )\r\n\r\n    doors_no_solution_count += 1\r\n\r\n\r\n# ============================================================\r\n# DIAGNOSTIC\r\n# ============================================================\r\n\r\ndiagnostic = {\r\n\r\n    \"Axes murs entree\":\r\n        len(wall_axes),\r\n\r\n    \"Axes murs valides\":\r\n        len(walls),\r\n\r\n    \"Portes entree\":\r\n        len(door_rectangles),\r\n\r\n    \"Rectangles valides\":\r\n        len(rectangles),\r\n\r\n    \"Portes avec axes candidats\":\r\n        doors_with_candidates,\r\n\r\n    \"Portes mode DeuxAxes\":\r\n        doors_two_axes,\r\n\r\n    \"Portes mode UnAxe\":\r\n        doors_one_axis,\r\n\r\n    \"Portes sans solution\":\r\n        doors_no_solution_count,\r\n\r\n    \"Portes ambigues\":\r\n        doors_ambiguous_count,\r\n\r\n    \"Axes candidats total\":\r\n        total_candidates,\r\n\r\n    \"Nb axes candidats max\":\r\n        max_candidates,\r\n\r\n    \"Tests de paires\":\r\n        pair_tests,\r\n\r\n    \"Prolongements simples crees\":\r\n        single_extensions_created,\r\n\r\n    \"Distance recherche mm\":\r\n        search_distance_mm,\r\n\r\n    \"Tolerance colinearite mm\":\r\n        collinear_tol_mm,\r\n\r\n    \"Tolerance angle deg\":\r\n        angle_tol_deg\r\n}\r\n\r\n\r\n# ============================================================\r\n# OUTPUT\r\n# ============================================================\r\n\r\nOUT = (\r\n\r\n    wall_pairs,               # OUT[0]\r\n\r\n    two_axis_connections,     # OUT[1]\r\n\r\n    single_axis_extensions,   # OUT[2]\r\n\r\n    associations,             # OUT[3]\r\n\r\n    doors_without_solution,   # OUT[4]\r\n\r\n    ambiguous_doors,          # OUT[5]\r\n\r\n    diagnostic                # OUT[6]\r\n)",
      "Engine": "PythonNet3",
      "VariableInputPorts": true,
      "Id": "fa2f6846591d4d2f9c97a2b41b57100d",
