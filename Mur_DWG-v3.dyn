      "Code": "x[0];\nx[1];"
    },
    {
      "ConcreteType": "PythonNodeModels.PythonNode, PythonNodeModels",
      "Code": "# -*- coding: utf-8 -*-\r\n\r\nimport math\r\n\r\n\r\n# ============================================================\r\n# MUR_07_ClasserEpaisseurs\r\n#\r\n# Objectif :\r\n#\r\n# A partir des épaisseurs mesurées sur les axes MUR_06 :\r\n#\r\n#   99.9999999998\r\n#   100.0000000003\r\n#   119.867756\r\n#   30.000000001\r\n#   79.999999999\r\n#\r\n# produire des classes propres :\r\n#\r\n#   100\r\n#   100\r\n#   120\r\n#   30\r\n#   80\r\n#\r\n#\r\n# IMPORTANT :\r\n#\r\n# On ne force PAS les épaisseurs sur un pas de 10 mm.\r\n#\r\n# Exemple :\r\n#\r\n#   71.8\r\n#   72.0\r\n#   72.2\r\n#\r\n# devient :\r\n#\r\n#   72 mm\r\n#\r\n# et non 70 mm.\r\n#\r\n# ============================================================\r\n\r\n\r\n# ============================================================\r\n# INPUTS\r\n# ============================================================\r\n\r\ninput_axes = IN[0] if IN[0] else []\r\ninput_widths = IN[1] if IN[1] else []\r\n\r\ncluster_tol_mm = (\r\n    float(IN[2])\r\n    if IN[2] is not None\r\n    else 2.0\r\n)\r\n\r\n\r\n# ============================================================\r\n# OUTILS\r\n# ============================================================\r\n\r\ndef flatten(data):\r\n\r\n    result = []\r\n\r\n    if isinstance(data, (list, tuple)):\r\n\r\n        for item in data:\r\n            result.extend(\r\n                flatten(item)\r\n            )\r\n\r\n    elif data is not None:\r\n\r\n        result.append(data)\r\n\r\n    return result\r\n\r\n\r\naxes = flatten(input_axes)\r\nwidths_raw = flatten(input_widths)\r\n\r\n\r\ndef safe_float(value):\r\n\r\n    try:\r\n\r\n        x = float(value)\r\n\r\n        if math.isnan(x):\r\n            return None\r\n\r\n        if math.isinf(x):\r\n            return None\r\n\r\n        return x\r\n\r\n    except:\r\n\r\n        return None\r\n\r\n\r\ndef clean_number(value):\r\n\r\n    \"\"\"\r\n    Nettoyage uniquement pour affichage.\r\n\r\n    100.00000000003 -> 100\r\n    119.8677         -> 119.868\r\n    \"\"\"\r\n\r\n    if value is None:\r\n        return None\r\n\r\n    rounded_integer = round(value)\r\n\r\n    if abs(\r\n        value - rounded_integer\r\n    ) < 1e-6:\r\n\r\n        return int(\r\n            rounded_integer\r\n        )\r\n\r\n    return round(\r\n        value,\r\n        3\r\n    )\r\n\r\n\r\n# ============================================================\r\n# VERIFICATION DES DONNEES\r\n# ============================================================\r\n\r\nvalid_items = []\r\n\r\ninvalid_width_indices = []\r\n\r\n\r\ncount = min(\r\n    len(axes),\r\n    len(widths_raw)\r\n)\r\n\r\n\r\nfor i in range(count):\r\n\r\n    width = safe_float(\r\n        widths_raw[i]\r\n    )\r\n\r\n\r\n    if width is None:\r\n\r\n        invalid_width_indices.append(\r\n            i\r\n        )\r\n\r\n        continue\r\n\r\n\r\n    if width <= 0.0:\r\n\r\n        invalid_width_indices.append(\r\n            i\r\n        )\r\n\r\n        continue\r\n\r\n\r\n    valid_items.append({\r\n\r\n        \"index\":\r\n            i,\r\n\r\n        \"axis\":\r\n            axes[i],\r\n\r\n        \"width\":\r\n            width\r\n    })\r\n\r\n\r\n# ============================================================\r\n# TRI PAR EPAISSEUR\r\n# ============================================================\r\n\r\nsorted_items = sorted(\r\n\r\n    valid_items,\r\n\r\n    key=lambda x:\r\n        x[\"width\"]\r\n)\r\n\r\n\r\n# ============================================================\r\n# CREATION DES GROUPES\r\n#\r\n# Méthode :\r\n#\r\n# On ajoute une valeur au groupe courant si elle reste\r\n# compatible avec le centre du groupe.\r\n#\r\n# Le centre est recalculé après chaque ajout.\r\n#\r\n# Exemple tolérance 2 mm :\r\n#\r\n# 99.8\r\n# 100.0\r\n# 100.3\r\n#\r\n# => même groupe\r\n#\r\n#\r\n# 100\r\n# 104\r\n#\r\n# => deux groupes\r\n#\r\n# ============================================================\r\n\r\nclusters = []\r\n\r\n\r\nfor item in sorted_items:\r\n\r\n    width = item[\"width\"]\r\n\r\n\r\n    if not clusters:\r\n\r\n        clusters.append({\r\n\r\n            \"items\":\r\n                [item],\r\n\r\n            \"mean\":\r\n                width\r\n        })\r\n\r\n        continue\r\n\r\n\r\n    current = clusters[-1]\r\n\r\n\r\n    if abs(\r\n        width -\r\n        current[\"mean\"]\r\n    ) <= cluster_tol_mm:\r\n\r\n        current[\"items\"].append(\r\n            item\r\n        )\r\n\r\n\r\n        current[\"mean\"] = (\r\n\r\n            sum(\r\n                x[\"width\"]\r\n                for x in current[\"items\"]\r\n            )\r\n\r\n            /\r\n            float(\r\n                len(current[\"items\"])\r\n            )\r\n        )\r\n\r\n\r\n    else:\r\n\r\n        clusters.append({\r\n\r\n            \"items\":\r\n                [item],\r\n\r\n            \"mean\":\r\n                width\r\n        })\r\n\r\n\r\n# ============================================================\r\n# CLASSE REPRESENTATIVE\r\n#\r\n# Pour chaque cluster :\r\n#\r\n#   moyenne mesurée = 99.9987\r\n#\r\n# classe :\r\n#\r\n#   100 mm\r\n#\r\n#\r\n# Ici on arrondit la moyenne au millimètre.\r\n#\r\n# Ce n'est PAS un arrondi au multiple de 10.\r\n#\r\n# 72.1 -> 72\r\n# 97.2 -> 97\r\n# 119.87 -> 120\r\n# ============================================================\r\n\r\nfor cluster in clusters:\r\n\r\n    mean_width = cluster[\"mean\"]\r\n\r\n    class_width = float(\r\n        round(mean_width)\r\n    )\r\n\r\n\r\n    cluster[\"class_width\"] = (\r\n        class_width\r\n    )\r\n\r\n\r\n# ============================================================\r\n# ATTENTION :\r\n#\r\n# Deux clusters différents pourraient exceptionnellement\r\n# produire la même classe après arrondi.\r\n#\r\n# Exemple :\r\n#\r\n# cluster A -> 99.4 -> 99\r\n# cluster B -> 99.49 -> 99\r\n#\r\n# On consolide donc les classes identiques.\r\n# ============================================================\r\n\r\nclass_map = {}\r\n\r\n\r\nfor cluster in clusters:\r\n\r\n    class_width = (\r\n        cluster[\"class_width\"]\r\n    )\r\n\r\n\r\n    if class_width not in class_map:\r\n\r\n        class_map[class_width] = {\r\n\r\n            \"class_width\":\r\n                class_width,\r\n\r\n            \"items\":\r\n                []\r\n        }\r\n\r\n\r\n    class_map[\r\n        class_width\r\n    ][\"items\"].extend(\r\n        cluster[\"items\"]\r\n    )\r\n\r\n\r\n# ============================================================\r\n# CLASSES FINALES\r\n# ============================================================\r\n\r\nfinal_classes = sorted(\r\n    class_map.values(),\r\n    key=lambda x:\r\n        x[\"class_width\"]\r\n)\r\n\r\n\r\n# ============================================================\r\n# TABLE INDEX ORIGINAL -> CLASSE\r\n# ============================================================\r\n\r\nclassified_by_index = {}\r\n\r\n\r\nfor class_data in final_classes:\r\n\r\n    class_width = (\r\n        class_data[\"class_width\"]\r\n    )\r\n\r\n\r\n    for item in class_data[\"items\"]:\r\n\r\n        classified_by_index[\r\n            item[\"index\"]\r\n        ] = class_width\r\n\r\n\r\n# ============================================================\r\n# OUTPUT AXES / EPAISSEURS\r\n#\r\n# On conserve exactement l'ordre des axes MUR_06.\r\n# ============================================================\r\n\r\noutput_axes = []\r\n\r\nclassified_widths = []\r\n\r\ncorrespondences = []\r\n\r\n\r\nfor i in range(count):\r\n\r\n    width = safe_float(\r\n        widths_raw[i]\r\n    )\r\n\r\n\r\n    if (\r\n        width is None\r\n        or\r\n        i not in classified_by_index\r\n    ):\r\n\r\n        continue\r\n\r\n\r\n    class_width = (\r\n        classified_by_index[i]\r\n    )\r\n\r\n\r\n    output_axes.append(\r\n        axes[i]\r\n    )\r\n\r\n    classified_widths.append(\r\n        class_width\r\n    )\r\n\r\n\r\n    correspondences.append({\r\n\r\n        \"AxeIndex\":\r\n            i,\r\n\r\n        \"EpaisseurMesuree_mm\":\r\n            clean_number(\r\n                width\r\n            ),\r\n\r\n        \"EpaisseurClasse_mm\":\r\n            clean_number(\r\n                class_width\r\n            ),\r\n\r\n        \"Correction_mm\":\r\n            round(\r\n                class_width -\r\n                width,\r\n                3\r\n            )\r\n    })\r\n\r\n\r\n# ============================================================\r\n# CLASSES + EFFECTIFS\r\n# ============================================================\r\n\r\ndetected_classes = []\r\n\r\ncounts_per_class = []\r\n\r\n\r\nfor class_data in final_classes:\r\n\r\n    class_width = (\r\n        class_data[\"class_width\"]\r\n    )\r\n\r\n    items = (\r\n        class_data[\"items\"]\r\n    )\r\n\r\n\r\n    detected_classes.append(\r\n        clean_number(\r\n            class_width\r\n        )\r\n    )\r\n\r\n\r\n    counts_per_class.append({\r\n\r\n        \"Epaisseur_mm\":\r\n            clean_number(\r\n                class_width\r\n            ),\r\n\r\n        \"NombreAxes\":\r\n            len(items),\r\n\r\n        \"MinimumMesure_mm\":\r\n            clean_number(\r\n                min(\r\n                    x[\"width\"]\r\n                    for x in items\r\n                )\r\n            ),\r\n\r\n        \"MaximumMesure_mm\":\r\n            clean_number(\r\n                max(\r\n                    x[\"width\"]\r\n                    for x in items\r\n                )\r\n            ),\r\n\r\n        \"MoyenneMesuree_mm\":\r\n            clean_number(\r\n\r\n                sum(\r\n                    x[\"width\"]\r\n                    for x in items\r\n                )\r\n\r\n                /\r\n                float(\r\n                    len(items)\r\n                )\r\n            )\r\n    })\r\n\r\n\r\n# ============================================================\r\n# STATISTIQUES DE CORRECTION\r\n# ============================================================\r\n\r\ncorrections = []\r\n\r\n\r\nfor item in correspondences:\r\n\r\n    corrections.append(\r\n        abs(\r\n            item[\"Correction_mm\"]\r\n        )\r\n    )\r\n\r\n\r\nif corrections:\r\n\r\n    max_correction = max(\r\n        corrections\r\n    )\r\n\r\n    mean_correction = (\r\n        sum(corrections)\r\n        /\r\n        float(len(corrections))\r\n    )\r\n\r\nelse:\r\n\r\n    max_correction = 0.0\r\n    mean_correction = 0.0\r\n\r\n\r\n# ============================================================\r\n# DIAGNOSTIC\r\n# ============================================================\r\n\r\ndiagnostic = {\r\n\r\n    \"Axes entree\":\r\n        len(axes),\r\n\r\n    \"Epaisseurs entree\":\r\n        len(widths_raw),\r\n\r\n    \"Axes analyses\":\r\n        count,\r\n\r\n    \"Epaisseurs valides\":\r\n        len(valid_items),\r\n\r\n    \"Epaisseurs invalides\":\r\n        len(invalid_width_indices),\r\n\r\n    \"Indices epaisseurs invalides\":\r\n        invalid_width_indices,\r\n\r\n    \"Clusters initiaux\":\r\n        len(clusters),\r\n\r\n    \"Classes finales\":\r\n        len(final_classes),\r\n\r\n    \"Classes detectees mm\":\r\n        detected_classes,\r\n\r\n    \"Tolerance regroupement mm\":\r\n        cluster_tol_mm,\r\n\r\n    \"Correction moyenne mm\":\r\n        round(\r\n            mean_correction,\r\n            3\r\n        ),\r\n\r\n    \"Correction maximum mm\":\r\n        round(\r\n            max_correction,\r\n            3\r\n        ),\r\n\r\n    \"Axes sortie\":\r\n        len(output_axes)\r\n}\r\n\r\n\r\n# ============================================================\r\n# OUTPUT\r\n# ============================================================\r\n\r\nOUT = (\r\n\r\n    output_axes,            # OUT[0]\r\n\r\n    classified_widths,      # OUT[1]\r\n\r\n    detected_classes,       # OUT[2]\r\n\r\n    counts_per_class,       # OUT[3]\r\n\r\n    correspondences,        # OUT[4]\r\n\r\n    diagnostic              # OUT[5]\r\n)",
      "Engine": "PythonNet3",
      "VariableInputPorts": true,
      "Id": "1d0828e71c294889919f771a4f9f2f1e",
      "NodeType": "PythonScriptNode",
