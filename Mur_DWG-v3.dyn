    },
    {
      "ConcreteType": "PythonNodeModels.PythonNode, PythonNodeModels",
      "Code": "# -*- coding: utf-8 -*-\r\n\r\nimport clr\r\nimport math\r\nfrom collections import defaultdict, deque\r\n\r\nclr.AddReference(\"ProtoGeometry\")\r\nfrom Autodesk.DesignScript.Geometry import Point, Line\r\n\r\nclr.AddReference(\"RevitAPI\")\r\nfrom Autodesk.Revit.DB import UnitUtils, UnitTypeId, SpecTypeId\r\n\r\nclr.AddReference(\"RevitServices\")\r\nfrom RevitServices.Persistence import DocumentManager\r\n\r\n\r\n# ============================================================\r\n# MUR_03_ResoudrePairesMur\r\n# VERSION 04\r\n#\r\n# OBJECTIF\r\n# ------------------------------------------------------------\r\n# Transformer les Wall-Prone Pairs de MUR_02 en axes de murs.\r\n#\r\n# AMELIORATION V04\r\n# ------------------------------------------------------------\r\n# Une même face source peut participer à plusieurs paires\r\n# sur des domaines longitudinaux DIFFERENTS.\r\n#\r\n# Exemple T :\r\n#\r\n# Face longue A\r\n# =============================================\r\n#\r\n# Face B1                    Face B2\r\n# =============              ================\r\n#\r\n# On accepte :\r\n#\r\n# A-B1                       A-B2\r\n#\r\n# puis les deux axes peuvent être regroupés comme appartenant\r\n# au même mur parce qu'ils :\r\n#\r\n#   - sont colinéaires\r\n#   - ont une largeur compatible\r\n#   - partagent une face source\r\n#   - sont séparés par un gap limité\r\n#\r\n#\r\n# IMPORTANT\r\n# ------------------------------------------------------------\r\n# Une même face reste INTERDITE dans deux paires simultanées\r\n# sur la même tranche longitudinale.\r\n#\r\n# Donc :\r\n#\r\n#     A-B et B-C au même endroit\r\n#\r\n# reste un conflit traité par matching.\r\n#\r\n#\r\n# IN[0] = SourcePairs MUR_02\r\n# IN[1] = CandidateInfos MUR_02\r\n# IN[2] = tolérance fusion atomique mm\r\n# IN[3] = longueur minimum mm\r\n#\r\n# OUT[0] = axes résolus\r\n# OUT[1] = largeurs mm\r\n# OUT[2] = infos\r\n# OUT[3] = axes issus zones de conflit\r\n# OUT[4] = diagnostic\r\n# ============================================================\r\n\r\n\r\n# ============================================================\r\n# 0. INPUTS\r\n# ============================================================\r\n\r\nsource_pairs = IN[0] if IN[0] else []\r\ncandidate_infos = IN[1] if IN[1] else []\r\n\r\nmerge_tol_mm = (\r\n    float(IN[2])\r\n    if IN[2] is not None\r\n    else 2.0\r\n)\r\n\r\nmin_length_mm = (\r\n    float(IN[3])\r\n    if IN[3] is not None\r\n    else 10.0\r\n)\r\n\r\n\r\n# ============================================================\r\n# PARAMETRES INTERNES V04\r\n# ============================================================\r\n\r\n# Tolérance de colinéarité des AXES déjà reconstruits.\r\n#\r\n# Très petite : on ne veut pas fusionner deux murs parallèles.\r\nAXIS_COLLINEAR_TOL_MM = 3.0\r\n\r\n\r\n# Gap autorisé entre deux axes partageant une face source.\r\n#\r\n# Ici 150 mm est volontairement possible :\r\n# ce n'est PAS un I générique.\r\n#\r\n# La fusion exige également une face source commune.\r\nSHARED_FACE_GAP_MM = 150.0\r\n\r\n\r\n# Tolérance largeur entre deux portions du même mur.\r\nSHARED_FACE_WIDTH_TOL_MM = 5.0\r\n\r\n\r\n# Tolérance angulaire entre axes à fusionner.\r\nSHARED_FACE_ANGLE_TOL_DEG = 2.0\r\n\r\n\r\nEPS = 1e-12\r\n\r\n\r\n# ============================================================\r\n# 1. UNITES\r\n# ============================================================\r\n\r\ndoc = DocumentManager.Instance.CurrentDBDocument\r\n\r\nproject_unit_id = (\r\n    doc.GetUnits()\r\n       .GetFormatOptions(SpecTypeId.Length)\r\n       .GetUnitTypeId()\r\n)\r\n\r\n\r\ndef mm_to_project(value_mm):\r\n\r\n    internal = UnitUtils.ConvertToInternalUnits(\r\n        value_mm,\r\n        UnitTypeId.Millimeters\r\n    )\r\n\r\n    return UnitUtils.ConvertFromInternalUnits(\r\n        internal,\r\n        project_unit_id\r\n    )\r\n\r\n\r\ndef project_to_mm(value):\r\n\r\n    internal = UnitUtils.ConvertToInternalUnits(\r\n        value,\r\n        project_unit_id\r\n    )\r\n\r\n    return UnitUtils.ConvertFromInternalUnits(\r\n        internal,\r\n        UnitTypeId.Millimeters\r\n    )\r\n\r\n\r\nmerge_tol = mm_to_project(merge_tol_mm)\r\nmin_length = mm_to_project(min_length_mm)\r\n\r\naxis_collinear_tol = mm_to_project(\r\n    AXIS_COLLINEAR_TOL_MM\r\n)\r\n\r\nshared_face_gap = mm_to_project(\r\n    SHARED_FACE_GAP_MM\r\n)\r\n\r\n\r\n# ============================================================\r\n# 2. OUTILS GENERAUX\r\n# ============================================================\r\n\r\ndef get_info(info, key, default=None):\r\n\r\n    try:\r\n        return info[key]\r\n    except:\r\n        pass\r\n\r\n    try:\r\n        return info.get(key, default)\r\n    except:\r\n        return default\r\n\r\n\r\ndef xyz(point):\r\n\r\n    return (\r\n        float(point.X),\r\n        float(point.Y),\r\n        float(point.Z)\r\n    )\r\n\r\n\r\ndef dot2(a, b):\r\n\r\n    return (\r\n        a[0] * b[0] +\r\n        a[1] * b[1]\r\n    )\r\n\r\n\r\ndef cross2(a, b):\r\n\r\n    return (\r\n        a[0] * b[1] -\r\n        a[1] * b[0]\r\n    )\r\n\r\n\r\ndef distance2d(a, b):\r\n\r\n    dx = a[0] - b[0]\r\n    dy = a[1] - b[1]\r\n\r\n    return math.sqrt(\r\n        dx * dx +\r\n        dy * dy\r\n    )\r\n\r\n\r\ndef curve_data(curve):\r\n\r\n    try:\r\n\r\n        p0 = curve.StartPoint\r\n        p1 = curve.EndPoint\r\n\r\n        x0 = float(p0.X)\r\n        y0 = float(p0.Y)\r\n        z0 = float(p0.Z)\r\n\r\n        x1 = float(p1.X)\r\n        y1 = float(p1.Y)\r\n        z1 = float(p1.Z)\r\n\r\n        dx = x1 - x0\r\n        dy = y1 - y0\r\n\r\n        length = math.sqrt(\r\n            dx * dx +\r\n            dy * dy\r\n        )\r\n\r\n        if length <= EPS:\r\n            return None\r\n\r\n        ux = dx / length\r\n        uy = dy / length\r\n\r\n        # Direction canonique :\r\n        # indépendante du Start/End Dynamo.\r\n\r\n        if (\r\n            ux < 0.0\r\n            or\r\n            (\r\n                abs(ux) < EPS\r\n                and uy < 0.0\r\n            )\r\n        ):\r\n\r\n            ux = -ux\r\n            uy = -uy\r\n\r\n        return {\r\n\r\n            \"x0\": x0,\r\n            \"y0\": y0,\r\n            \"z0\": z0,\r\n\r\n            \"x1\": x1,\r\n            \"y1\": y1,\r\n            \"z1\": z1,\r\n\r\n            \"ux\": ux,\r\n            \"uy\": uy,\r\n\r\n            \"length\": length\r\n        }\r\n\r\n    except:\r\n        return None\r\n\r\n\r\ndef projection_interval(curve, ux, uy):\r\n\r\n    p0 = curve.StartPoint\r\n    p1 = curve.EndPoint\r\n\r\n    s0 = (\r\n        float(p0.X) * ux +\r\n        float(p0.Y) * uy\r\n    )\r\n\r\n    s1 = (\r\n        float(p1.X) * ux +\r\n        float(p1.Y) * uy\r\n    )\r\n\r\n    return (\r\n        min(s0, s1),\r\n        max(s0, s1)\r\n    )\r\n\r\n\r\ndef point_at_s(curve, ux, uy, s):\r\n\r\n    p0 = curve.StartPoint\r\n    p1 = curve.EndPoint\r\n\r\n    x0 = float(p0.X)\r\n    y0 = float(p0.Y)\r\n    z0 = float(p0.Z)\r\n\r\n    x1 = float(p1.X)\r\n    y1 = float(p1.Y)\r\n    z1 = float(p1.Z)\r\n\r\n    dx = x1 - x0\r\n    dy = y1 - y0\r\n    dz = z1 - z0\r\n\r\n    denominator = (\r\n        dx * ux +\r\n        dy * uy\r\n    )\r\n\r\n    if abs(denominator) < EPS:\r\n        return None\r\n\r\n    s_origin = (\r\n        x0 * ux +\r\n        y0 * uy\r\n    )\r\n\r\n    t = (\r\n        (s - s_origin) /\r\n        denominator\r\n    )\r\n\r\n    if (\r\n        t < -1e-6\r\n        or\r\n        t > 1.000001\r\n    ):\r\n        return None\r\n\r\n    t = max(\r\n        0.0,\r\n        min(1.0, t)\r\n    )\r\n\r\n    return (\r\n\r\n        x0 + t * dx,\r\n        y0 + t * dy,\r\n        z0 + t * dz\r\n    )\r\n\r\n\r\ndef distance_between_curves_at_s(\r\n    curve_a,\r\n    curve_b,\r\n    ux,\r\n    uy,\r\n    s\r\n):\r\n\r\n    a = point_at_s(\r\n        curve_a,\r\n        ux,\r\n        uy,\r\n        s\r\n    )\r\n\r\n    b = point_at_s(\r\n        curve_b,\r\n        ux,\r\n        uy,\r\n        s\r\n    )\r\n\r\n    if a is None or b is None:\r\n        return None\r\n\r\n    return distance2d(\r\n        a,\r\n        b\r\n    )\r\n\r\n\r\ndef make_centerline(\r\n    curve_a,\r\n    curve_b,\r\n    ux,\r\n    uy,\r\n    s0,\r\n    s1\r\n):\r\n\r\n    a0 = point_at_s(\r\n        curve_a,\r\n        ux,\r\n        uy,\r\n        s0\r\n    )\r\n\r\n    a1 = point_at_s(\r\n        curve_a,\r\n        ux,\r\n        uy,\r\n        s1\r\n    )\r\n\r\n    b0 = point_at_s(\r\n        curve_b,\r\n        ux,\r\n        uy,\r\n        s0\r\n    )\r\n\r\n    b1 = point_at_s(\r\n        curve_b,\r\n        ux,\r\n        uy,\r\n        s1\r\n    )\r\n\r\n    if (\r\n        a0 is None\r\n        or a1 is None\r\n        or b0 is None\r\n        or b1 is None\r\n    ):\r\n        return None\r\n\r\n    c0 = (\r\n\r\n        0.5 * (a0[0] + b0[0]),\r\n        0.5 * (a0[1] + b0[1]),\r\n        0.5 * (a0[2] + b0[2])\r\n    )\r\n\r\n    c1 = (\r\n\r\n        0.5 * (a1[0] + b1[0]),\r\n        0.5 * (a1[1] + b1[1]),\r\n        0.5 * (a1[2] + b1[2])\r\n    )\r\n\r\n    if distance2d(c0, c1) <= EPS:\r\n        return None\r\n\r\n    p0 = Point.ByCoordinates(\r\n        c0[0],\r\n        c0[1],\r\n        c0[2]\r\n    )\r\n\r\n    p1 = Point.ByCoordinates(\r\n        c1[0],\r\n        c1[1],\r\n        c1[2]\r\n    )\r\n\r\n    return Line.ByStartPointEndPoint(\r\n        p0,\r\n        p1\r\n    )\r\n\r\n\r\ndef make_line_from_xyz(a, b):\r\n\r\n    if distance2d(a, b) <= EPS:\r\n        return None\r\n\r\n    p0 = Point.ByCoordinates(\r\n        a[0],\r\n        a[1],\r\n        a[2]\r\n    )\r\n\r\n    p1 = Point.ByCoordinates(\r\n        b[0],\r\n        b[1],\r\n        b[2]\r\n    )\r\n\r\n    return Line.ByStartPointEndPoint(\r\n        p0,\r\n        p1\r\n    )\r\n\r\n\r\ndef acute_angle_deg(\r\n    ux1,\r\n    uy1,\r\n    ux2,\r\n    uy2\r\n):\r\n\r\n    value = abs(\r\n        ux1 * ux2 +\r\n        uy1 * uy2\r\n    )\r\n\r\n    value = max(\r\n        0.0,\r\n        min(1.0, value)\r\n    )\r\n\r\n    return math.degrees(\r\n        math.acos(value)\r\n    )\r\n\r\n\r\n# ============================================================\r\n# 3. RECONSTRUIRE LES WALL-PRONE PAIRS\r\n# ============================================================\r\n\r\nrecords = []\r\n\r\nsource_curves = {}\r\n\r\ninput_count = min(\r\n    len(source_pairs),\r\n    len(candidate_infos)\r\n)\r\n\r\n\r\nfor i in range(input_count):\r\n\r\n    try:\r\n\r\n        pair = source_pairs[i]\r\n        info = candidate_infos[i]\r\n\r\n        if (\r\n            pair is None\r\n            or len(pair) < 2\r\n        ):\r\n            continue\r\n\r\n        curve_a = pair[0]\r\n        curve_b = pair[1]\r\n\r\n        source_a = int(\r\n            get_info(\r\n                info,\r\n                \"SourceA\",\r\n                -1\r\n            )\r\n        )\r\n\r\n        source_b = int(\r\n            get_info(\r\n                info,\r\n                \"SourceB\",\r\n                -1\r\n            )\r\n        )\r\n\r\n        if (\r\n            source_a < 0\r\n            or source_b < 0\r\n            or source_a == source_b\r\n        ):\r\n            continue\r\n\r\n        source_curves[source_a] = curve_a\r\n        source_curves[source_b] = curve_b\r\n\r\n        pair_key = tuple(\r\n            sorted(\r\n                (\r\n                    source_a,\r\n                    source_b\r\n                )\r\n            )\r\n        )\r\n\r\n        records.append({\r\n\r\n            \"id\": i,\r\n\r\n            \"sourceA\": source_a,\r\n            \"sourceB\": source_b,\r\n\r\n            \"pairKey\": pair_key,\r\n\r\n            \"curveA\": curve_a,\r\n            \"curveB\": curve_b,\r\n\r\n            \"width_mm\": float(\r\n                get_info(\r\n                    info,\r\n                    \"Largeur_mm\",\r\n                    0.0\r\n                )\r\n            ),\r\n\r\n            \"overlap_mm\": float(\r\n                get_info(\r\n                    info,\r\n                    \"Overlap_mm\",\r\n                    0.0\r\n                )\r\n            )\r\n        })\r\n\r\n    except:\r\n        pass\r\n\r\n\r\n# ============================================================\r\n# 4. WAG SIMPLIFIE\r\n# ============================================================\r\n\r\ngraph = defaultdict(set)\r\n\r\n\r\nfor record in records:\r\n\r\n    a = record[\"sourceA\"]\r\n    b = record[\"sourceB\"]\r\n\r\n    graph[a].add(b)\r\n    graph[b].add(a)\r\n\r\n\r\n# ============================================================\r\n# 5. COMPOSANTES CONNEXES\r\n# ============================================================\r\n\r\ncomponents = []\r\n\r\nvisited = set()\r\n\r\n\r\nfor start_node in graph:\r\n\r\n    if start_node in visited:\r\n        continue\r\n\r\n    queue = deque([start_node])\r\n\r\n    visited.add(start_node)\r\n\r\n    component = set()\r\n\r\n    while queue:\r\n\r\n        current = queue.popleft()\r\n\r\n        component.add(current)\r\n\r\n        for neighbour in graph[current]:\r\n\r\n            if neighbour in visited:\r\n                continue\r\n\r\n            visited.add(neighbour)\r\n            queue.append(neighbour)\r\n\r\n    components.append(component)\r\n\r\n\r\n# ============================================================\r\n# 6. RECORDS PAR COMPOSANTE\r\n# ============================================================\r\n\r\nsource_to_component = {}\r\n\r\n\r\nfor component_index, component in enumerate(components):\r\n\r\n    for source_id in component:\r\n\r\n        source_to_component[\r\n            source_id\r\n        ] = component_index\r\n\r\n\r\ncomponent_records = [\r\n    []\r\n    for _ in components\r\n]\r\n\r\n\r\nfor record in records:\r\n\r\n    component_index = (\r\n        source_to_component.get(\r\n            record[\"sourceA\"]\r\n        )\r\n    )\r\n\r\n    if component_index is None:\r\n        continue\r\n\r\n    component_records[\r\n        component_index\r\n    ].append(record)\r\n\r\n\r\n# ============================================================\r\n# 7. RESULTATS ATOMIQUES\r\n# ============================================================\r\n\r\natomic_results = []\r\n\r\nsimple_components = 0\r\ncomplex_components = 0\r\n\r\ndirect_pairs = 0\r\n\r\nlongitudinal_slices = 0\r\n\r\nnon_adjacent_rejected = 0\r\n\r\nconflict_slices = 0\r\n\r\ncomplex_selected_atoms = 0\r\n\r\nlargest_component = 0\r\n\r\n\r\n# ============================================================\r\n# 8. TRAITEMENT DES COMPOSANTES\r\n# ============================================================\r\n\r\nfor component_index, component in enumerate(components):\r\n\r\n    local_records = (\r\n        component_records[\r\n            component_index\r\n        ]\r\n    )\r\n\r\n    component_size = len(component)\r\n\r\n    largest_component = max(\r\n        largest_component,\r\n        component_size\r\n    )\r\n\r\n\r\n    # ========================================================\r\n    # 8A. COMPOSANTE SIMPLE\r\n    # ========================================================\r\n\r\n    if (\r\n        component_size == 2\r\n        and len(local_records) == 1\r\n    ):\r\n\r\n        simple_components += 1\r\n        direct_pairs += 1\r\n\r\n        record = local_records[0]\r\n\r\n        d = curve_data(\r\n            record[\"curveA\"]\r\n        )\r\n\r\n        if d is None:\r\n            continue\r\n\r\n        ux = d[\"ux\"]\r\n        uy = d[\"uy\"]\r\n\r\n        a0, a1 = projection_interval(\r\n            record[\"curveA\"],\r\n            ux,\r\n            uy\r\n        )\r\n\r\n        b0, b1 = projection_interval(\r\n            record[\"curveB\"],\r\n            ux,\r\n            uy\r\n        )\r\n\r\n        # Domaine CERTAIN commun aux deux faces.\r\n        s0 = max(a0, b0)\r\n        s1 = min(a1, b1)\r\n\r\n        if (\r\n            s1 - s0\r\n            < min_length\r\n        ):\r\n            continue\r\n\r\n        s_mid = 0.5 * (\r\n            s0 + s1\r\n        )\r\n\r\n        width = distance_between_curves_at_s(\r\n            record[\"curveA\"],\r\n            record[\"curveB\"],\r\n            ux,\r\n            uy,\r\n            s_mid\r\n        )\r\n\r\n        if width is None:\r\n            continue\r\n\r\n        atomic_results.append({\r\n\r\n            \"component\":\r\n                component_index,\r\n\r\n            \"complex\":\r\n                False,\r\n\r\n            \"conflict\":\r\n                False,\r\n\r\n            \"sourceA\":\r\n                record[\"sourceA\"],\r\n\r\n            \"sourceB\":\r\n                record[\"sourceB\"],\r\n\r\n            \"sources\":\r\n                set(\r\n                    (\r\n                        record[\"sourceA\"],\r\n                        record[\"sourceB\"]\r\n                    )\r\n                ),\r\n\r\n            \"pairKey\":\r\n                record[\"pairKey\"],\r\n\r\n            \"curveA\":\r\n                record[\"curveA\"],\r\n\r\n            \"curveB\":\r\n                record[\"curveB\"],\r\n\r\n            \"ux\":\r\n                ux,\r\n\r\n            \"uy\":\r\n                uy,\r\n\r\n            \"s0\":\r\n                s0,\r\n\r\n            \"s1\":\r\n                s1,\r\n\r\n            \"width\":\r\n                width\r\n        })\r\n\r\n        continue\r\n\r\n\r\n    # ========================================================\r\n    # 8B. COMPOSANTE COMPLEXE\r\n    # ========================================================\r\n\r\n    complex_components += 1\r\n\r\n    if not local_records:\r\n        continue\r\n\r\n    first_record = local_records[0]\r\n\r\n    d = curve_data(\r\n        first_record[\"curveA\"]\r\n    )\r\n\r\n    if d is None:\r\n        continue\r\n\r\n    ux = d[\"ux\"]\r\n    uy = d[\"uy\"]\r\n\r\n    nx = -uy\r\n    ny = ux\r\n\r\n\r\n    # ========================================================\r\n    # 9. DOMAINES D'OVERLAP\r\n    # ========================================================\r\n\r\n    valid_records = []\r\n    boundaries = []\r\n\r\n\r\n    for record in local_records:\r\n\r\n        a0, a1 = projection_interval(\r\n            record[\"curveA\"],\r\n            ux,\r\n            uy\r\n        )\r\n\r\n        b0, b1 = projection_interval(\r\n            record[\"curveB\"],\r\n            ux,\r\n            uy\r\n        )\r\n\r\n        s0 = max(a0, b0)\r\n        s1 = min(a1, b1)\r\n\r\n        if (\r\n            s1 - s0\r\n            < min_length\r\n        ):\r\n            continue\r\n\r\n        local_record = dict(record)\r\n\r\n        local_record[\"s0\"] = s0\r\n        local_record[\"s1\"] = s1\r\n\r\n        valid_records.append(\r\n            local_record\r\n        )\r\n\r\n        boundaries.append(s0)\r\n        boundaries.append(s1)\r\n\r\n\r\n    if not boundaries:\r\n        continue\r\n\r\n\r\n    # ========================================================\r\n    # 10. FRONTIERES\r\n    # ========================================================\r\n\r\n    boundaries.sort()\r\n\r\n    merged_boundaries = []\r\n\r\n\r\n    for value in boundaries:\r\n\r\n        if not merged_boundaries:\r\n\r\n            merged_boundaries.append(\r\n                value\r\n            )\r\n\r\n            continue\r\n\r\n        previous = (\r\n            merged_boundaries[-1]\r\n        )\r\n\r\n        if (\r\n            abs(value - previous)\r\n            <= merge_tol\r\n        ):\r\n\r\n            merged_boundaries[-1] = (\r\n                0.5 *\r\n                (\r\n                    previous +\r\n                    value\r\n                )\r\n            )\r\n\r\n        else:\r\n\r\n            merged_boundaries.append(\r\n                value\r\n            )\r\n\r\n\r\n    # ========================================================\r\n    # 11. TRANCHES LONGITUDINALES\r\n    # ========================================================\r\n\r\n    for boundary_index in range(\r\n        len(merged_boundaries) - 1\r\n    ):\r\n\r\n        s0 = (\r\n            merged_boundaries[\r\n                boundary_index\r\n            ]\r\n        )\r\n\r\n        s1 = (\r\n            merged_boundaries[\r\n                boundary_index + 1\r\n            ]\r\n        )\r\n\r\n        if (\r\n            s1 - s0\r\n            < min_length\r\n        ):\r\n            continue\r\n\r\n        s_mid = 0.5 * (\r\n            s0 + s1\r\n        )\r\n\r\n\r\n        # ====================================================\r\n        # 12. PAIRES ACTIVES\r\n        # ====================================================\r\n\r\n        slice_records = []\r\n\r\n\r\n        for record in valid_records:\r\n\r\n            if (\r\n                record[\"s0\"]\r\n                <= s_mid + merge_tol\r\n                and\r\n                record[\"s1\"]\r\n                >= s_mid - merge_tol\r\n            ):\r\n\r\n                slice_records.append(\r\n                    record\r\n                )\r\n\r\n\r\n        if not slice_records:\r\n            continue\r\n\r\n        longitudinal_slices += 1\r\n\r\n\r\n        # ====================================================\r\n        # 13. SOURCES ACTIVES\r\n        # ====================================================\r\n\r\n        active_sources = set()\r\n\r\n\r\n        for record in slice_records:\r\n\r\n            active_sources.add(\r\n                record[\"sourceA\"]\r\n            )\r\n\r\n            active_sources.add(\r\n                record[\"sourceB\"]\r\n            )\r\n\r\n\r\n        # ====================================================\r\n        # 14. ORDRE TRANSVERSAL\r\n        # ====================================================\r\n\r\n        ordered = []\r\n\r\n\r\n        for source_id in active_sources:\r\n\r\n            curve = source_curves.get(\r\n                source_id\r\n            )\r\n\r\n            if curve is None:\r\n                continue\r\n\r\n            p = point_at_s(\r\n                curve,\r\n                ux,\r\n                uy,\r\n                s_mid\r\n            )\r\n\r\n            if p is None:\r\n                continue\r\n\r\n            rho = (\r\n                p[0] * nx +\r\n                p[1] * ny\r\n            )\r\n\r\n            ordered.append(\r\n                (\r\n                    rho,\r\n                    source_id\r\n                )\r\n            )\r\n\r\n\r\n        ordered.sort(\r\n            key=lambda item:\r\n                item[0]\r\n        )\r\n\r\n        ordered_sources = [\r\n            item[1]\r\n            for item in ordered\r\n        ]\r\n\r\n        rank = {\r\n\r\n            source_id: index\r\n\r\n            for index, source_id\r\n            in enumerate(\r\n                ordered_sources\r\n            )\r\n        }\r\n\r\n\r\n        # ====================================================\r\n        # 15. FACES ADJACENTES UNIQUEMENT\r\n        # ====================================================\r\n\r\n        available_edges = {}\r\n\r\n\r\n        for record in slice_records:\r\n\r\n            source_a = record[\r\n                \"sourceA\"\r\n            ]\r\n\r\n            source_b = record[\r\n                \"sourceB\"\r\n            ]\r\n\r\n            if (\r\n                source_a not in rank\r\n                or\r\n                source_b not in rank\r\n            ):\r\n                continue\r\n\r\n            rank_a = rank[source_a]\r\n            rank_b = rank[source_b]\r\n\r\n            if (\r\n                abs(rank_a - rank_b)\r\n                != 1\r\n            ):\r\n\r\n                non_adjacent_rejected += 1\r\n                continue\r\n\r\n            edge = (\r\n                min(rank_a, rank_b),\r\n                max(rank_a, rank_b)\r\n            )\r\n\r\n            width = (\r\n                distance_between_curves_at_s(\r\n                    record[\"curveA\"],\r\n                    record[\"curveB\"],\r\n                    ux,\r\n                    uy,\r\n                    s_mid\r\n                )\r\n            )\r\n\r\n            if width is None:\r\n                continue\r\n\r\n            if edge not in available_edges:\r\n\r\n                available_edges[\r\n                    edge\r\n                ] = (\r\n                    record,\r\n                    width\r\n                )\r\n\r\n            else:\r\n\r\n                previous_width = (\r\n                    available_edges[\r\n                        edge\r\n                    ][1]\r\n                )\r\n\r\n                if (\r\n                    width <\r\n                    previous_width\r\n                ):\r\n\r\n                    available_edges[\r\n                        edge\r\n                    ] = (\r\n                        record,\r\n                        width\r\n                    )\r\n\r\n\r\n        if not available_edges:\r\n            continue\r\n\r\n\r\n        # ====================================================\r\n        # 16. CONFLITS\r\n        #\r\n        # IMPORTANT :\r\n        # ceci ne concerne QUE la tranche courante.\r\n        #\r\n        # Une face peut donc être utilisée avec B1 sur une\r\n        # tranche puis B2 sur une autre tranche.\r\n        # ====================================================\r\n\r\n        degree = defaultdict(int)\r\n\r\n\r\n        for edge in available_edges:\r\n\r\n            degree[edge[0]] += 1\r\n            degree[edge[1]] += 1\r\n\r\n\r\n        has_conflict = any(\r\n            value > 1\r\n            for value in degree.values()\r\n        )\r\n\r\n\r\n        if has_conflict:\r\n            conflict_slices += 1\r\n\r\n\r\n        # ====================================================\r\n        # 17. MATCHING OPTIMAL LOCAL\r\n        #\r\n        # Interdit :\r\n        #\r\n        # A-B et B-C sur la MEME tranche.\r\n        #\r\n        # Mais ne bloque pas :\r\n        #\r\n        # A-B1 sur tranche 1\r\n        # A-B2 sur tranche 2.\r\n        # ====================================================\r\n\r\n        n_sources = len(\r\n            ordered_sources\r\n        )\r\n\r\n        dp = [\r\n\r\n            (\r\n                0,\r\n                0.0,\r\n                []\r\n            )\r\n\r\n            for _ in range(\r\n                n_sources + 1\r\n            )\r\n        ]\r\n\r\n\r\n        for i in range(\r\n            1,\r\n            n_sources + 1\r\n        ):\r\n\r\n            best_count = (\r\n                dp[i - 1][0]\r\n            )\r\n\r\n            best_cost = (\r\n                dp[i - 1][1]\r\n            )\r\n\r\n            best_edges = list(\r\n                dp[i - 1][2]\r\n            )\r\n\r\n\r\n            if i >= 2:\r\n\r\n                edge = (\r\n                    i - 2,\r\n                    i - 1\r\n                )\r\n\r\n                if edge in available_edges:\r\n\r\n                    record, width = (\r\n                        available_edges[\r\n                            edge\r\n                        ]\r\n                    )\r\n\r\n                    candidate_count = (\r\n                        dp[i - 2][0] +\r\n                        1\r\n                    )\r\n\r\n                    candidate_cost = (\r\n                        dp[i - 2][1] +\r\n                        width\r\n                    )\r\n\r\n                    candidate_edges = list(\r\n                        dp[i - 2][2]\r\n                    )\r\n\r\n                    candidate_edges.append(\r\n                        edge\r\n                    )\r\n\r\n                    better = False\r\n\r\n                    if (\r\n                        candidate_count >\r\n                        best_count\r\n                    ):\r\n\r\n                        better = True\r\n\r\n                    elif (\r\n                        candidate_count ==\r\n                        best_count\r\n                        and\r\n                        candidate_cost <\r\n                        best_cost\r\n                    ):\r\n\r\n                        better = True\r\n\r\n                    if better:\r\n\r\n                        best_count = (\r\n                            candidate_count\r\n                        )\r\n\r\n                        best_cost = (\r\n                            candidate_cost\r\n                        )\r\n\r\n                        best_edges = (\r\n                            candidate_edges\r\n                        )\r\n\r\n\r\n            dp[i] = (\r\n\r\n                best_count,\r\n                best_cost,\r\n                best_edges\r\n            )\r\n\r\n\r\n        selected_edges = (\r\n            dp[n_sources][2]\r\n        )\r\n\r\n\r\n        # ====================================================\r\n        # 18. ENREGISTREMENT ATOMIQUE\r\n        # ====================================================\r\n\r\n        for edge in selected_edges:\r\n\r\n            record, width = (\r\n                available_edges[\r\n                    edge\r\n                ]\r\n            )\r\n\r\n            atomic_results.append({\r\n\r\n                \"component\":\r\n                    component_index,\r\n\r\n                \"complex\":\r\n                    True,\r\n\r\n                \"conflict\":\r\n                    has_conflict,\r\n\r\n                \"sourceA\":\r\n                    record[\"sourceA\"],\r\n\r\n                \"sourceB\":\r\n                    record[\"sourceB\"],\r\n\r\n                \"sources\":\r\n                    set(\r\n                        (\r\n                            record[\"sourceA\"],\r\n                            record[\"sourceB\"]\r\n                        )\r\n                    ),\r\n\r\n                \"pairKey\":\r\n                    record[\"pairKey\"],\r\n\r\n                \"curveA\":\r\n                    record[\"curveA\"],\r\n\r\n                \"curveB\":\r\n                    record[\"curveB\"],\r\n\r\n                \"ux\":\r\n                    ux,\r\n\r\n                \"uy\":\r\n                    uy,\r\n\r\n                \"s0\":\r\n                    s0,\r\n\r\n                \"s1\":\r\n                    s1,\r\n\r\n                \"width\":\r\n                    width\r\n            })\r\n\r\n            complex_selected_atoms += 1\r\n\r\n\r\n# ============================================================\r\n# 19. FUSION DES PORTIONS DE LA MEME PAIRE\r\n#\r\n# Comportement historique conservé.\r\n# ============================================================\r\n\r\nby_pair = defaultdict(list)\r\n\r\n\r\nfor atom in atomic_results:\r\n\r\n    key = (\r\n        atom[\"component\"],\r\n        atom[\"pairKey\"]\r\n    )\r\n\r\n    by_pair[key].append(atom)\r\n\r\n\r\npair_merged_results = []\r\n\r\n\r\nfor key, atoms in by_pair.items():\r\n\r\n    atoms.sort(\r\n        key=lambda item:\r\n            item[\"s0\"]\r\n    )\r\n\r\n    current = None\r\n\r\n\r\n    for atom in atoms:\r\n\r\n        if current is None:\r\n\r\n            current = dict(atom)\r\n\r\n            current[\"sources\"] = set(\r\n                atom[\"sources\"]\r\n            )\r\n\r\n            continue\r\n\r\n        gap = (\r\n            atom[\"s0\"] -\r\n            current[\"s1\"]\r\n        )\r\n\r\n        if gap <= merge_tol:\r\n\r\n            current[\"s1\"] = max(\r\n                current[\"s1\"],\r\n                atom[\"s1\"]\r\n            )\r\n\r\n            current[\"conflict\"] = (\r\n                current[\"conflict\"]\r\n                or\r\n                atom[\"conflict\"]\r\n            )\r\n\r\n            current[\"sources\"].update(\r\n                atom[\"sources\"]\r\n            )\r\n\r\n        else:\r\n\r\n            pair_merged_results.append(\r\n                current\r\n            )\r\n\r\n            current = dict(atom)\r\n\r\n            current[\"sources\"] = set(\r\n                atom[\"sources\"]\r\n            )\r\n\r\n\r\n    if current is not None:\r\n\r\n        pair_merged_results.append(\r\n            current\r\n        )\r\n\r\n\r\n# ============================================================\r\n# 20. CONSTRUIRE LES AXES PROVISOIRES\r\n#\r\n# Cette étape est nécessaire avant la fusion \"face commune\",\r\n# car deux paires différentes n'ont pas forcément exactement\r\n# la même médiane.\r\n# ============================================================\r\n\r\nprovisional = []\r\n\r\n\r\nfor record in pair_merged_results:\r\n\r\n    length = (\r\n        record[\"s1\"] -\r\n        record[\"s0\"]\r\n    )\r\n\r\n    if length < min_length:\r\n        continue\r\n\r\n    axis = make_centerline(\r\n        record[\"curveA\"],\r\n        record[\"curveB\"],\r\n        record[\"ux\"],\r\n        record[\"uy\"],\r\n        record[\"s0\"],\r\n        record[\"s1\"]\r\n    )\r\n\r\n    if axis is None:\r\n        continue\r\n\r\n    s_mid = 0.5 * (\r\n        record[\"s0\"] +\r\n        record[\"s1\"]\r\n    )\r\n\r\n    width = (\r\n        distance_between_curves_at_s(\r\n            record[\"curveA\"],\r\n            record[\"curveB\"],\r\n            record[\"ux\"],\r\n            record[\"uy\"],\r\n            s_mid\r\n        )\r\n    )\r\n\r\n    if width is None:\r\n        continue\r\n\r\n    data = curve_data(axis)\r\n\r\n    if data is None:\r\n        continue\r\n\r\n    provisional.append({\r\n\r\n        \"axis\":\r\n            axis,\r\n\r\n        \"p0\":\r\n            xyz(axis.StartPoint),\r\n\r\n        \"p1\":\r\n            xyz(axis.EndPoint),\r\n\r\n        \"ux\":\r\n            data[\"ux\"],\r\n\r\n        \"uy\":\r\n            data[\"uy\"],\r\n\r\n        \"length\":\r\n            data[\"length\"],\r\n\r\n        \"width\":\r\n            width,\r\n\r\n        \"width_mm\":\r\n            project_to_mm(width),\r\n\r\n        \"sources\":\r\n            set(record[\"sources\"]),\r\n\r\n        \"pairKeys\":\r\n            set(\r\n                [record[\"pairKey\"]]\r\n            ),\r\n\r\n        \"components\":\r\n            set(\r\n                [record[\"component\"]]\r\n            ),\r\n\r\n        \"complex\":\r\n            record[\"complex\"],\r\n\r\n        \"conflict\":\r\n            record[\"conflict\"],\r\n\r\n        \"merged_shared_face\":\r\n            False\r\n    })\r\n\r\n\r\n# ============================================================\r\n# 21. TEST DE FUSION PAR FACE SOURCE COMMUNE\r\n# ============================================================\r\n\r\ndef shared_sources(a, b):\r\n\r\n    return (\r\n        a[\"sources\"]\r\n        .intersection(\r\n            b[\"sources\"]\r\n        )\r\n    )\r\n\r\n\r\ndef support_offset(point, axis_record):\r\n\r\n    v = (\r\n\r\n        point[0] -\r\n        axis_record[\"p0\"][0],\r\n\r\n        point[1] -\r\n        axis_record[\"p0\"][1]\r\n    )\r\n\r\n    return abs(\r\n\r\n        cross2(\r\n            v,\r\n            (\r\n                axis_record[\"ux\"],\r\n                axis_record[\"uy\"]\r\n            )\r\n        )\r\n    )\r\n\r\n\r\ndef longitudinal_s(\r\n    point,\r\n    origin,\r\n    ux,\r\n    uy\r\n):\r\n\r\n    return (\r\n\r\n        (\r\n            point[0] -\r\n            origin[0]\r\n        ) * ux\r\n\r\n        +\r\n\r\n        (\r\n            point[1] -\r\n            origin[1]\r\n        ) * uy\r\n    )\r\n\r\n\r\ndef try_merge_shared_face(a, b):\r\n\r\n    # --------------------------------------------------------\r\n    # 1. Une face source doit être commune.\r\n    # --------------------------------------------------------\r\n\r\n    common = shared_sources(\r\n        a,\r\n        b\r\n    )\r\n\r\n    if not common:\r\n        return None\r\n\r\n\r\n    # --------------------------------------------------------\r\n    # 2. Largeurs compatibles.\r\n    # --------------------------------------------------------\r\n\r\n    if (\r\n        abs(\r\n            a[\"width_mm\"] -\r\n            b[\"width_mm\"]\r\n        )\r\n        >\r\n        SHARED_FACE_WIDTH_TOL_MM\r\n    ):\r\n        return None\r\n\r\n\r\n    # --------------------------------------------------------\r\n    # 3. Directions pratiquement identiques.\r\n    # --------------------------------------------------------\r\n\r\n    angle = acute_angle_deg(\r\n\r\n        a[\"ux\"],\r\n        a[\"uy\"],\r\n\r\n        b[\"ux\"],\r\n        b[\"uy\"]\r\n    )\r\n\r\n    if (\r\n        angle >\r\n        SHARED_FACE_ANGLE_TOL_DEG\r\n    ):\r\n        return None\r\n\r\n\r\n    # --------------------------------------------------------\r\n    # 4. Axes réellement colinéaires.\r\n    #\r\n    # IMPORTANT :\r\n    # partager une face ne suffit pas.\r\n    #\r\n    # Si A-B1 et A-B2 ont des largeurs très différentes,\r\n    # leurs médianes pourraient être différentes.\r\n    # --------------------------------------------------------\r\n\r\n    d0 = support_offset(\r\n        b[\"p0\"],\r\n        a\r\n    )\r\n\r\n    d1 = support_offset(\r\n        b[\"p1\"],\r\n        a\r\n    )\r\n\r\n    max_offset = max(\r\n        d0,\r\n        d1\r\n    )\r\n\r\n    if (\r\n        max_offset >\r\n        axis_collinear_tol\r\n    ):\r\n        return None\r\n\r\n\r\n    # --------------------------------------------------------\r\n    # 5. Projection de B sur le support de A.\r\n    # --------------------------------------------------------\r\n\r\n    origin = a[\"p0\"]\r\n\r\n    ux = a[\"ux\"]\r\n    uy = a[\"uy\"]\r\n\r\n    a0 = 0.0\r\n    a1 = a[\"length\"]\r\n\r\n    b0 = longitudinal_s(\r\n        b[\"p0\"],\r\n        origin,\r\n        ux,\r\n        uy\r\n    )\r\n\r\n    b1 = longitudinal_s(\r\n        b[\"p1\"],\r\n        origin,\r\n        ux,\r\n        uy\r\n    )\r\n\r\n    amin = min(a0, a1)\r\n    amax = max(a0, a1)\r\n\r\n    bmin = min(b0, b1)\r\n    bmax = max(b0, b1)\r\n\r\n\r\n    # --------------------------------------------------------\r\n    # 6. Gap.\r\n    # --------------------------------------------------------\r\n\r\n    if bmin > amax:\r\n\r\n        gap = (\r\n            bmin - amax\r\n        )\r\n\r\n    elif amin > bmax:\r\n\r\n        gap = (\r\n            amin - bmax\r\n        )\r\n\r\n    else:\r\n\r\n        gap = 0.0\r\n\r\n\r\n    if gap > shared_face_gap:\r\n        return None\r\n\r\n\r\n    # --------------------------------------------------------\r\n    # 7. Intervalle total.\r\n    # --------------------------------------------------------\r\n\r\n    global_min = min(\r\n        amin,\r\n        bmin\r\n    )\r\n\r\n    global_max = max(\r\n        amax,\r\n        bmax\r\n    )\r\n\r\n\r\n    # --------------------------------------------------------\r\n    # 8. IMPORTANT :\r\n    #\r\n    # L'axe fusionné reste EXACTEMENT sur le support de A.\r\n    #\r\n    # Aucun pivot.\r\n    # Aucun centroïde.\r\n    # --------------------------------------------------------\r\n\r\n    z = 0.25 * (\r\n\r\n        a[\"p0\"][2] +\r\n        a[\"p1\"][2] +\r\n        b[\"p0\"][2] +\r\n        b[\"p1\"][2]\r\n    )\r\n\r\n    p0 = (\r\n\r\n        origin[0] +\r\n        ux * global_min,\r\n\r\n        origin[1] +\r\n        uy * global_min,\r\n\r\n        z\r\n    )\r\n\r\n    p1 = (\r\n\r\n        origin[0] +\r\n        ux * global_max,\r\n\r\n        origin[1] +\r\n        uy * global_max,\r\n\r\n        z\r\n    )\r\n\r\n    axis = make_line_from_xyz(\r\n        p0,\r\n        p1\r\n    )\r\n\r\n    if axis is None:\r\n        return None\r\n\r\n\r\n    # --------------------------------------------------------\r\n    # 9. Largeur.\r\n    #\r\n    # Les largeurs sont déjà compatibles.\r\n    # On utilise leur moyenne pondérée par longueur.\r\n    # --------------------------------------------------------\r\n\r\n    total_length = (\r\n        a[\"length\"] +\r\n        b[\"length\"]\r\n    )\r\n\r\n    if total_length > EPS:\r\n\r\n        width_mm = (\r\n\r\n            a[\"width_mm\"] *\r\n            a[\"length\"]\r\n\r\n            +\r\n\r\n            b[\"width_mm\"] *\r\n            b[\"length\"]\r\n\r\n        ) / total_length\r\n\r\n    else:\r\n\r\n        width_mm = 0.5 * (\r\n            a[\"width_mm\"] +\r\n            b[\"width_mm\"]\r\n        )\r\n\r\n\r\n    return {\r\n\r\n        \"axis\":\r\n            axis,\r\n\r\n        \"p0\":\r\n            p0,\r\n\r\n        \"p1\":\r\n            p1,\r\n\r\n        \"ux\":\r\n            ux,\r\n\r\n        \"uy\":\r\n            uy,\r\n\r\n        \"length\":\r\n            global_max -\r\n            global_min,\r\n\r\n        \"width_mm\":\r\n            width_mm,\r\n\r\n        \"width\":\r\n            mm_to_project(\r\n                width_mm\r\n            ),\r\n\r\n        \"sources\":\r\n            set(\r\n                a[\"sources\"]\r\n            ).union(\r\n                b[\"sources\"]\r\n            ),\r\n\r\n        \"pairKeys\":\r\n            set(\r\n                a[\"pairKeys\"]\r\n            ).union(\r\n                b[\"pairKeys\"]\r\n            ),\r\n\r\n        \"components\":\r\n            set(\r\n                a[\"components\"]\r\n            ).union(\r\n                b[\"components\"]\r\n            ),\r\n\r\n        \"complex\":\r\n            (\r\n                a[\"complex\"]\r\n                or\r\n                b[\"complex\"]\r\n            ),\r\n\r\n        \"conflict\":\r\n            (\r\n                a[\"conflict\"]\r\n                or\r\n                b[\"conflict\"]\r\n            ),\r\n\r\n        \"merged_shared_face\":\r\n            True,\r\n\r\n        \"common_sources\":\r\n            set(common),\r\n\r\n        \"gap\":\r\n            gap,\r\n\r\n        \"offset\":\r\n            max_offset,\r\n\r\n        \"angle\":\r\n            angle\r\n    }\r\n\r\n\r\n# ============================================================\r\n# 22. FUSION ITERATIVE PAR FACE COMMUNE\r\n#\r\n# Exemple :\r\n#\r\n# A-B1\r\n# A-B2\r\n# A-B3\r\n#\r\n# peut devenir :\r\n#\r\n# AB1 + AB2\r\n# puis\r\n# AB12 + AB3\r\n#\r\n# => un seul axe.\r\n# ============================================================\r\n\r\nshared_face_merge_infos = []\r\n\r\nshared_face_merge_count = 0\r\n\r\nchanged = True\r\n\r\n\r\nwhile changed:\r\n\r\n    changed = False\r\n\r\n    i = 0\r\n\r\n    while i < len(provisional):\r\n\r\n        j = i + 1\r\n\r\n        while j < len(provisional):\r\n\r\n            a = provisional[i]\r\n            b = provisional[j]\r\n\r\n            result = (\r\n                try_merge_shared_face(\r\n                    a,\r\n                    b\r\n                )\r\n            )\r\n\r\n            if result is None:\r\n\r\n                j += 1\r\n                continue\r\n\r\n\r\n            shared_face_merge_infos.append({\r\n\r\n                \"SourcesCommunes\":\r\n                    sorted(\r\n                        list(\r\n                            result[\r\n                                \"common_sources\"\r\n                            ]\r\n                        )\r\n                    ),\r\n\r\n                \"Gap_mm\":\r\n                    round(\r\n                        project_to_mm(\r\n                            result[\"gap\"]\r\n                        ),\r\n                        3\r\n                    ),\r\n\r\n                \"OffsetAxes_mm\":\r\n                    round(\r\n                        project_to_mm(\r\n                            result[\"offset\"]\r\n                        ),\r\n                        3\r\n                    ),\r\n\r\n                \"Angle_deg\":\r\n                    round(\r\n                        result[\"angle\"],\r\n                        4\r\n                    ),\r\n\r\n                \"LargeurResultat_mm\":\r\n                    round(\r\n                        result[\"width_mm\"],\r\n                        3\r\n                    )\r\n            })\r\n\r\n\r\n            provisional[i] = result\r\n\r\n            provisional.pop(j)\r\n\r\n            shared_face_merge_count += 1\r\n\r\n            changed = True\r\n\r\n            # Recommencer avec le nouvel axe fusionné.\r\n            j = i + 1\r\n\r\n\r\n        i += 1\r\n\r\n\r\n# ============================================================\r\n# 23. RESULTATS FINAUX\r\n# ============================================================\r\n\r\nresolved_axes = []\r\nresolved_widths_mm = []\r\nresolved_infos = []\r\n\r\nconflict_axes = []\r\n\r\n\r\nfor record in provisional:\r\n\r\n    if (\r\n        record[\"length\"] <\r\n        min_length\r\n    ):\r\n        continue\r\n\r\n    axis = record[\"axis\"]\r\n\r\n    width_mm = record[\r\n        \"width_mm\"\r\n    ]\r\n\r\n    resolved_axes.append(\r\n        axis\r\n    )\r\n\r\n    resolved_widths_mm.append(\r\n        width_mm\r\n    )\r\n\r\n\r\n    pair_keys = [\r\n\r\n        list(key)\r\n\r\n        for key in sorted(\r\n            list(\r\n                record[\"pairKeys\"]\r\n            )\r\n        )\r\n    ]\r\n\r\n\r\n    resolved_infos.append({\r\n\r\n        \"Sources\":\r\n            sorted(\r\n                list(\r\n                    record[\"sources\"]\r\n                )\r\n            ),\r\n\r\n        \"PairesSources\":\r\n            pair_keys,\r\n\r\n        \"Largeur_mm\":\r\n            round(\r\n                width_mm,\r\n                3\r\n            ),\r\n\r\n        \"Longueur_mm\":\r\n            round(\r\n                project_to_mm(\r\n                    record[\"length\"]\r\n                ),\r\n                3\r\n            ),\r\n\r\n        \"ComposanteComplexe\":\r\n            record[\"complex\"],\r\n\r\n        \"ZoneConflit\":\r\n            record[\"conflict\"],\r\n\r\n        \"FusionFaceCommune\":\r\n            record[\r\n                \"merged_shared_face\"\r\n            ]\r\n    })\r\n\r\n\r\n    if record[\"conflict\"]:\r\n\r\n        conflict_axes.append(\r\n            axis\r\n        )\r\n\r\n\r\n# ============================================================\r\n# 24. DIAGNOSTIC\r\n# ============================================================\r\n\r\ncomponent_sizes = [\r\n\r\n    len(component)\r\n\r\n    for component in components\r\n]\r\n\r\n\r\nif component_sizes:\r\n\r\n    average_component_size = (\r\n\r\n        float(\r\n            sum(component_sizes)\r\n        )\r\n\r\n        /\r\n\r\n        float(\r\n            len(component_sizes)\r\n        )\r\n    )\r\n\r\nelse:\r\n\r\n    average_component_size = 0.0\r\n\r\n\r\ndiagnostic = {\r\n\r\n    \"Version\":\r\n        \"MUR_03_V04_FaceCommune\",\r\n\r\n    \"Paires candidates entree\":\r\n        len(records),\r\n\r\n    \"Faces sources impliquees\":\r\n        len(source_curves),\r\n\r\n    \"Composantes totales\":\r\n        len(components),\r\n\r\n    \"Composantes simples\":\r\n        simple_components,\r\n\r\n    \"Composantes complexes\":\r\n        complex_components,\r\n\r\n    \"Taille plus grande composante\":\r\n        largest_component,\r\n\r\n    \"Taille moyenne composante\":\r\n        round(\r\n            average_component_size,\r\n            2\r\n        ),\r\n\r\n    \"Paires directes\":\r\n        direct_pairs,\r\n\r\n    \"Tranches complexes analysees\":\r\n        longitudinal_slices,\r\n\r\n    \"Paires non adjacentes rejetees\":\r\n        non_adjacent_rejected,\r\n\r\n    \"Tranches avec conflit\":\r\n        conflict_slices,\r\n\r\n    \"Portions complexes retenues\":\r\n        complex_selected_atoms,\r\n\r\n    \"Portions atomiques\":\r\n        len(atomic_results),\r\n\r\n    \"Portions apres fusion meme paire\":\r\n        len(pair_merged_results),\r\n\r\n    \"Axes provisoires\":\r\n        (\r\n            len(provisional) +\r\n            shared_face_merge_count\r\n        ),\r\n\r\n    \"Fusions par face commune\":\r\n        shared_face_merge_count,\r\n\r\n    \"Details fusions face commune\":\r\n        shared_face_merge_infos,\r\n\r\n    \"Axes finaux\":\r\n        len(resolved_axes),\r\n\r\n    \"Axes issus zone conflit\":\r\n        len(conflict_axes),\r\n\r\n    \"Tolerance fusion atomique mm\":\r\n        merge_tol_mm,\r\n\r\n    \"Longueur mini mm\":\r\n        min_length_mm,\r\n\r\n    \"Tolerance gap face commune mm\":\r\n        SHARED_FACE_GAP_MM,\r\n\r\n    \"Tolerance collinearite axe mm\":\r\n        AXIS_COLLINEAR_TOL_MM,\r\n\r\n    \"Tolerance largeur face commune mm\":\r\n        SHARED_FACE_WIDTH_TOL_MM,\r\n\r\n    \"Tolerance angle face commune deg\":\r\n        SHARED_FACE_ANGLE_TOL_DEG\r\n}\r\n\r\n\r\n# ============================================================\r\n# 25. OUT\r\n# ============================================================\r\n\r\nOUT = (\r\n\r\n    resolved_axes,          # OUT[0]\r\n\r\n    resolved_widths_mm,     # OUT[1]\r\n\r\n    resolved_infos,         # OUT[2]\r\n\r\n    conflict_axes,          # OUT[3]\r\n\r\n    diagnostic              # OUT[4]\r\n)",
      "Engine": "PythonNet3",
      "VariableInputPorts": true,
      "Id": "b268c9b53101440086bec8b61a33995b",
