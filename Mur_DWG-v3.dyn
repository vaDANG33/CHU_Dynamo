    {
      "ConcreteType": "PythonNodeModels.PythonNode, PythonNodeModels",
      "Code": "# -*- coding: utf-8 -*-\r\n\r\nimport clr\r\nimport math\r\n\r\nclr.AddReference(\"ProtoGeometry\")\r\nfrom Autodesk.DesignScript.Geometry import Point, Line\r\n\r\nclr.AddReference(\"RevitAPI\")\r\nfrom Autodesk.Revit.DB import UnitUtils, UnitTypeId, SpecTypeId\r\n\r\nclr.AddReference(\"RevitServices\")\r\nfrom RevitServices.Persistence import DocumentManager\r\n\r\n\r\n# ============================================================\r\n# MUR_05_ReconstituerAxes\r\n#\r\n# Objectif :\r\n#\r\n# 1. Partir des axes MUR_03\r\n#\r\n# 2. Appliquer les corrections validées de MUR_04 :\r\n#\r\n#       DeuxAxes :\r\n#       A ------    ------ B\r\n#              \\__/\r\n#              porte\r\n#\r\n#       => A et B peuvent être reconstruits ensemble\r\n#\r\n#\r\n#       UnAxe :\r\n#       A ------ [porte]\r\n#\r\n#       => prolonger A uniquement\r\n#\r\n#\r\n# 3. Fusionner les segments :\r\n#       - parallèles\r\n#       - colinéaires\r\n#       - épaisseur compatible\r\n#       - overlap ou petit gap\r\n#\r\n# 4. Les prolongements UnAxe restent conservateurs :\r\n#    ils modifient uniquement leur axe source.\r\n#\r\n# 5. Les associations ambiguës de MUR_04 sont ignorées.\r\n#\r\n# ============================================================\r\n\r\n\r\n# ============================================================\r\n# INPUTS\r\n# ============================================================\r\n\r\ninput_axes = IN[0] if IN[0] else []\r\ninput_widths = IN[1] if IN[1] else []\r\n\r\ntwo_axis_connections = IN[2] if IN[2] else []\r\nsingle_axis_extensions = IN[3] if IN[3] else []\r\nassociations = IN[4] if IN[4] else []\r\n\r\n\r\nangle_tol_deg = (\r\n    float(IN[5])\r\n    if IN[5] is not None\r\n    else 0.5\r\n)\r\n\r\ncollinear_tol_mm = (\r\n    float(IN[6])\r\n    if IN[6] is not None\r\n    else 5.0\r\n)\r\n\r\ngap_tol_mm = (\r\n    float(IN[7])\r\n    if IN[7] is not None\r\n    else 5.0\r\n)\r\n\r\nwidth_tol_mm = (\r\n    float(IN[8])\r\n    if IN[8] is not None\r\n    else 5.0\r\n)\r\n\r\n\r\n# ============================================================\r\n# FLATTEN\r\n# ============================================================\r\n\r\ndef flatten(data):\r\n\r\n    result = []\r\n\r\n    if isinstance(data, (list, tuple)):\r\n\r\n        for item in data:\r\n            result.extend(flatten(item))\r\n\r\n    elif data is not None:\r\n\r\n        result.append(data)\r\n\r\n    return result\r\n\r\n\r\naxes = flatten(input_axes)\r\n\r\ntwo_axis_connections = flatten(\r\n    two_axis_connections\r\n)\r\n\r\nsingle_axis_extensions = flatten(\r\n    single_axis_extensions\r\n)\r\n\r\n\r\n# ============================================================\r\n# UNITES\r\n# ============================================================\r\n\r\ndoc = DocumentManager.Instance.CurrentDBDocument\r\n\r\nproject_unit_id = (\r\n    doc.GetUnits()\r\n       .GetFormatOptions(SpecTypeId.Length)\r\n       .GetUnitTypeId()\r\n)\r\n\r\n\r\ndef mm_to_project(value_mm):\r\n\r\n    internal = UnitUtils.ConvertToInternalUnits(\r\n        value_mm,\r\n        UnitTypeId.Millimeters\r\n    )\r\n\r\n    return UnitUtils.ConvertFromInternalUnits(\r\n        internal,\r\n        project_unit_id\r\n    )\r\n\r\n\r\ndef project_to_mm(value):\r\n\r\n    internal = UnitUtils.ConvertToInternalUnits(\r\n        value,\r\n        project_unit_id\r\n    )\r\n\r\n    return UnitUtils.ConvertFromInternalUnits(\r\n        internal,\r\n        UnitTypeId.Millimeters\r\n    )\r\n\r\n\r\ncollinear_tol = mm_to_project(\r\n    collinear_tol_mm\r\n)\r\n\r\ngap_tol = mm_to_project(\r\n    gap_tol_mm\r\n)\r\n\r\n\r\n# ============================================================\r\n# OUTILS\r\n# ============================================================\r\n\r\ndef xyz(point):\r\n\r\n    return (\r\n        float(point.X),\r\n        float(point.Y),\r\n        float(point.Z)\r\n    )\r\n\r\n\r\ndef distance2d(a, b):\r\n\r\n    dx = a[0] - b[0]\r\n    dy = a[1] - b[1]\r\n\r\n    return math.sqrt(\r\n        dx * dx +\r\n        dy * dy\r\n    )\r\n\r\n\r\ndef dot2(a, b):\r\n\r\n    return (\r\n        a[0] * b[0] +\r\n        a[1] * b[1]\r\n    )\r\n\r\n\r\ndef normalize2(v):\r\n\r\n    length = math.sqrt(\r\n        v[0] * v[0] +\r\n        v[1] * v[1]\r\n    )\r\n\r\n    if length <= 1e-12:\r\n        return None\r\n\r\n    return (\r\n        v[0] / length,\r\n        v[1] / length\r\n    )\r\n\r\n\r\ndef get_info(info, key, default=None):\r\n\r\n    try:\r\n        return info[key]\r\n    except:\r\n        pass\r\n\r\n    try:\r\n        return info.get(key, default)\r\n    except:\r\n        return default\r\n\r\n\r\ndef make_line(a, b):\r\n\r\n    if distance2d(a, b) <= 1e-9:\r\n        return None\r\n\r\n    pa = Point.ByCoordinates(\r\n        a[0],\r\n        a[1],\r\n        a[2]\r\n    )\r\n\r\n    pb = Point.ByCoordinates(\r\n        b[0],\r\n        b[1],\r\n        b[2]\r\n    )\r\n\r\n    try:\r\n\r\n        return Line.ByStartPointEndPoint(\r\n            pa,\r\n            pb\r\n        )\r\n\r\n    except:\r\n\r\n        return None\r\n\r\n\r\n# ============================================================\r\n# DONNEES D'UN AXE\r\n# ============================================================\r\n\r\ndef curve_data(curve):\r\n\r\n    try:\r\n\r\n        p0 = xyz(curve.StartPoint)\r\n        p1 = xyz(curve.EndPoint)\r\n\r\n    except:\r\n\r\n        return None\r\n\r\n\r\n    direction = normalize2(\r\n        (\r\n            p1[0] - p0[0],\r\n            p1[1] - p0[1]\r\n        )\r\n    )\r\n\r\n\r\n    if direction is None:\r\n        return None\r\n\r\n\r\n    return {\r\n\r\n        \"p0\": p0,\r\n        \"p1\": p1,\r\n\r\n        \"dir\": direction,\r\n\r\n        \"length\": distance2d(\r\n            p0,\r\n            p1\r\n        )\r\n    }\r\n\r\n\r\n# ============================================================\r\n# ANGLE ENTRE DIRECTIONS\r\n#\r\n# Sans sens :\r\n# +X et -X sont considérés parallèles.\r\n# ============================================================\r\n\r\ndef angle_difference_deg(a, b):\r\n\r\n    value = abs(\r\n        dot2(a, b)\r\n    )\r\n\r\n    value = max(\r\n        0.0,\r\n        min(1.0, value)\r\n    )\r\n\r\n    return math.degrees(\r\n        math.acos(value)\r\n    )\r\n\r\n\r\n# ============================================================\r\n# DISTANCE ENTRE DROITES SUPPORT\r\n# ============================================================\r\n\r\ndef support_distance(\r\n    data_a,\r\n    data_b\r\n):\r\n\r\n    direction = data_a[\"dir\"]\r\n\r\n    normal = (\r\n        -direction[1],\r\n        direction[0]\r\n    )\r\n\r\n    vector = (\r\n        data_b[\"p0\"][0] -\r\n        data_a[\"p0\"][0],\r\n\r\n        data_b[\"p0\"][1] -\r\n        data_a[\"p0\"][1]\r\n    )\r\n\r\n    return abs(\r\n        dot2(\r\n            vector,\r\n            normal\r\n        )\r\n    )\r\n\r\n\r\n# ============================================================\r\n# PROJECTION D'UN SEGMENT SUR UNE DIRECTION\r\n# ============================================================\r\n\r\ndef projection_interval(\r\n    data,\r\n    direction\r\n):\r\n\r\n    s0 = dot2(\r\n        (\r\n            data[\"p0\"][0],\r\n            data[\"p0\"][1]\r\n        ),\r\n        direction\r\n    )\r\n\r\n    s1 = dot2(\r\n        (\r\n            data[\"p1\"][0],\r\n            data[\"p1\"][1]\r\n        ),\r\n        direction\r\n    )\r\n\r\n    return (\r\n        min(s0, s1),\r\n        max(s0, s1)\r\n    )\r\n\r\n\r\n# ============================================================\r\n# GAP ENTRE DEUX INTERVALLES\r\n#\r\n# gap > 0  : espace\r\n# gap = 0  : contact\r\n# gap < 0  : overlap\r\n# ============================================================\r\n\r\ndef interval_gap(a, b):\r\n\r\n    a0, a1 = a\r\n    b0, b1 = b\r\n\r\n    if a1 < b0:\r\n        return b0 - a1\r\n\r\n    if b1 < a0:\r\n        return a0 - b1\r\n\r\n    overlap = min(\r\n        a1,\r\n        b1\r\n    ) - max(\r\n        a0,\r\n        b0\r\n    )\r\n\r\n    return -overlap\r\n\r\n\r\n# ============================================================\r\n# POINT DE LA DROITE A UNE COORDONNEE PROJETEE s\r\n# ============================================================\r\n\r\ndef point_at_projection(\r\n    reference,\r\n    direction,\r\n    s\r\n):\r\n\r\n    p = reference[\"p0\"]\r\n\r\n    p_s = dot2(\r\n        (\r\n            p[0],\r\n            p[1]\r\n        ),\r\n        direction\r\n    )\r\n\r\n    delta = s - p_s\r\n\r\n    return (\r\n        p[0] +\r\n        delta * direction[0],\r\n\r\n        p[1] +\r\n        delta * direction[1],\r\n\r\n        p[2]\r\n    )\r\n\r\n\r\n# ============================================================\r\n# FUSION GEOMETRIQUE DE DEUX SEGMENTS\r\n# ============================================================\r\n\r\ndef merge_two_segments(\r\n    data_a,\r\n    data_b\r\n):\r\n\r\n    direction = data_a[\"dir\"]\r\n\r\n    ia = projection_interval(\r\n        data_a,\r\n        direction\r\n    )\r\n\r\n    ib = projection_interval(\r\n        data_b,\r\n        direction\r\n    )\r\n\r\n\r\n    s_min = min(\r\n        ia[0],\r\n        ib[0]\r\n    )\r\n\r\n    s_max = max(\r\n        ia[1],\r\n        ib[1]\r\n    )\r\n\r\n\r\n    p0 = point_at_projection(\r\n        data_a,\r\n        direction,\r\n        s_min\r\n    )\r\n\r\n    p1 = point_at_projection(\r\n        data_a,\r\n        direction,\r\n        s_max\r\n    )\r\n\r\n\r\n    return make_line(\r\n        p0,\r\n        p1\r\n    )\r\n\r\n\r\n# ============================================================\r\n# COMPATIBILITE DE DEUX AXES\r\n# ============================================================\r\n\r\ndef can_merge(\r\n    axis_a,\r\n    axis_b\r\n):\r\n\r\n    da = curve_data(\r\n        axis_a[\"curve\"]\r\n    )\r\n\r\n    db = curve_data(\r\n        axis_b[\"curve\"]\r\n    )\r\n\r\n\r\n    if da is None or db is None:\r\n        return False, None\r\n\r\n\r\n    # --------------------------------------------------------\r\n    # 1. Parallélisme\r\n    # --------------------------------------------------------\r\n\r\n    angle = angle_difference_deg(\r\n        da[\"dir\"],\r\n        db[\"dir\"]\r\n    )\r\n\r\n\r\n    if angle > angle_tol_deg:\r\n        return False, None\r\n\r\n\r\n    # --------------------------------------------------------\r\n    # 2. Colinéarité\r\n    # --------------------------------------------------------\r\n\r\n    offset = support_distance(\r\n        da,\r\n        db\r\n    )\r\n\r\n\r\n    if offset > collinear_tol:\r\n        return False, None\r\n\r\n\r\n    # --------------------------------------------------------\r\n    # 3. Epaisseur\r\n    # --------------------------------------------------------\r\n\r\n    wa = axis_a[\"width_mm\"]\r\n    wb = axis_b[\"width_mm\"]\r\n\r\n\r\n    if (\r\n        wa is not None\r\n        and\r\n        wb is not None\r\n    ):\r\n\r\n        if abs(wa - wb) > width_tol_mm:\r\n            return False, None\r\n\r\n\r\n    # --------------------------------------------------------\r\n    # 4. Overlap / gap\r\n    # --------------------------------------------------------\r\n\r\n    ia = projection_interval(\r\n        da,\r\n        da[\"dir\"]\r\n    )\r\n\r\n    ib = projection_interval(\r\n        db,\r\n        da[\"dir\"]\r\n    )\r\n\r\n\r\n    gap = interval_gap(\r\n        ia,\r\n        ib\r\n    )\r\n\r\n\r\n    if gap > gap_tol:\r\n        return False, None\r\n\r\n\r\n    return True, {\r\n\r\n        \"angle_deg\":\r\n            angle,\r\n\r\n        \"offset\":\r\n            offset,\r\n\r\n        \"gap\":\r\n            gap\r\n    }\r\n\r\n\r\n# ============================================================\r\n# AXES DE BASE\r\n# ============================================================\r\n\r\nrecords = []\r\n\r\n\r\nfor i, curve in enumerate(axes):\r\n\r\n    data = curve_data(curve)\r\n\r\n    if data is None:\r\n        continue\r\n\r\n\r\n    width = None\r\n\r\n\r\n    if i < len(input_widths):\r\n\r\n        try:\r\n            width = float(\r\n                input_widths[i]\r\n            )\r\n        except:\r\n            pass\r\n\r\n\r\n    records.append({\r\n\r\n        \"curve\":\r\n            curve,\r\n\r\n        \"width_mm\":\r\n            width,\r\n\r\n        \"sources\":\r\n            [i],\r\n\r\n        \"modified\":\r\n            False,\r\n\r\n        \"door_two_axis\":\r\n            False,\r\n\r\n        \"door_single_axis\":\r\n            False\r\n    })\r\n\r\n\r\n# ============================================================\r\n# INDEX MUR_03 -> RECORD\r\n# ============================================================\r\n\r\nrecord_by_source = {}\r\n\r\nfor record in records:\r\n\r\n    if len(record[\"sources\"]) == 1:\r\n\r\n        record_by_source[\r\n            record[\"sources\"][0]\r\n        ] = record\r\n\r\n\r\n# ============================================================\r\n# ASSOCIATIONS MUR_04\r\n#\r\n# Séparer :\r\n#\r\n# - DeuxAxes valides\r\n# - DeuxAxes ambiguës\r\n# - UnAxe\r\n#\r\n# ============================================================\r\n\r\nvalid_two_axis_assoc = []\r\n\r\nambiguous_two_axis_assoc = []\r\n\r\nsingle_axis_assoc = []\r\n\r\n\r\nfor assoc in associations:\r\n\r\n    mode = get_info(\r\n        assoc,\r\n        \"Mode\",\r\n        None\r\n    )\r\n\r\n    ambiguous = bool(\r\n        get_info(\r\n            assoc,\r\n            \"Ambigu\",\r\n            False\r\n        )\r\n    )\r\n\r\n\r\n    if mode == \"DeuxAxes\":\r\n\r\n        if ambiguous:\r\n\r\n            ambiguous_two_axis_assoc.append(\r\n                assoc\r\n            )\r\n\r\n        else:\r\n\r\n            valid_two_axis_assoc.append(\r\n                assoc\r\n            )\r\n\r\n\r\n    elif mode == \"UnAxe\":\r\n\r\n        single_axis_assoc.append(\r\n            assoc\r\n        )\r\n\r\n\r\n# ============================================================\r\n# ETAPE 1\r\n# DEUX AXES VALIDES\r\n#\r\n# On fusionne directement les deux axes sources.\r\n#\r\n# On ne dépend PAS de l'ordre de OUT[1].\r\n# On utilise MurA / MurB des associations.\r\n# ============================================================\r\n\r\ntwo_axis_merges_done = 0\r\n\r\ntwo_axis_failed = 0\r\n\r\nremoved_record_ids = set()\r\n\r\n\r\nfor assoc in valid_two_axis_assoc:\r\n\r\n    mur_a = get_info(\r\n        assoc,\r\n        \"MurA\",\r\n        None\r\n    )\r\n\r\n    mur_b = get_info(\r\n        assoc,\r\n        \"MurB\",\r\n        None\r\n    )\r\n\r\n\r\n    if (\r\n        mur_a is None\r\n        or\r\n        mur_b is None\r\n    ):\r\n\r\n        two_axis_failed += 1\r\n        continue\r\n\r\n\r\n    record_a = record_by_source.get(\r\n        mur_a\r\n    )\r\n\r\n    record_b = record_by_source.get(\r\n        mur_b\r\n    )\r\n\r\n\r\n    if (\r\n        record_a is None\r\n        or\r\n        record_b is None\r\n    ):\r\n\r\n        two_axis_failed += 1\r\n        continue\r\n\r\n\r\n    da = curve_data(\r\n        record_a[\"curve\"]\r\n    )\r\n\r\n    db = curve_data(\r\n        record_b[\"curve\"]\r\n    )\r\n\r\n\r\n    if da is None or db is None:\r\n\r\n        two_axis_failed += 1\r\n        continue\r\n\r\n\r\n    # --------------------------------------------------------\r\n    # Vérification minimale :\r\n    # parallèles + colinéaires\r\n    #\r\n    # Le gap peut être grand car il contient justement\r\n    # la porte.\r\n    # --------------------------------------------------------\r\n\r\n    angle = angle_difference_deg(\r\n        da[\"dir\"],\r\n        db[\"dir\"]\r\n    )\r\n\r\n    offset = support_distance(\r\n        da,\r\n        db\r\n    )\r\n\r\n\r\n    if (\r\n        angle > angle_tol_deg\r\n        or\r\n        offset > collinear_tol\r\n    ):\r\n\r\n        two_axis_failed += 1\r\n        continue\r\n\r\n\r\n    # --------------------------------------------------------\r\n    # Epaisseur compatible\r\n    # --------------------------------------------------------\r\n\r\n    wa = record_a[\"width_mm\"]\r\n    wb = record_b[\"width_mm\"]\r\n\r\n\r\n    if (\r\n        wa is not None\r\n        and\r\n        wb is not None\r\n        and\r\n        abs(wa - wb) >\r\n        width_tol_mm\r\n    ):\r\n\r\n        two_axis_failed += 1\r\n        continue\r\n\r\n\r\n    merged_curve = merge_two_segments(\r\n        da,\r\n        db\r\n    )\r\n\r\n\r\n    if merged_curve is None:\r\n\r\n        two_axis_failed += 1\r\n        continue\r\n\r\n\r\n    # --------------------------------------------------------\r\n    # Epaisseur résultante\r\n    # --------------------------------------------------------\r\n\r\n    if (\r\n        wa is not None\r\n        and\r\n        wb is not None\r\n    ):\r\n\r\n        merged_width = (\r\n            wa + wb\r\n        ) * 0.5\r\n\r\n    elif wa is not None:\r\n\r\n        merged_width = wa\r\n\r\n    else:\r\n\r\n        merged_width = wb\r\n\r\n\r\n    new_record = {\r\n\r\n        \"curve\":\r\n            merged_curve,\r\n\r\n        \"width_mm\":\r\n            merged_width,\r\n\r\n        \"sources\":\r\n            record_a[\"sources\"] +\r\n            record_b[\"sources\"],\r\n\r\n        \"modified\":\r\n            True,\r\n\r\n        \"door_two_axis\":\r\n            True,\r\n\r\n        \"door_single_axis\":\r\n            False\r\n    }\r\n\r\n\r\n    removed_record_ids.add(\r\n        id(record_a)\r\n    )\r\n\r\n    removed_record_ids.add(\r\n        id(record_b)\r\n    )\r\n\r\n\r\n    records.append(\r\n        new_record\r\n    )\r\n\r\n\r\n    # Les deux anciens records ne doivent plus\r\n    # être utilisés par source.\r\n    record_by_source[mur_a] = new_record\r\n    record_by_source[mur_b] = new_record\r\n\r\n\r\n    two_axis_merges_done += 1\r\n\r\n\r\n# ============================================================\r\n# SUPPRIMER LES RECORDS REMPLACES\r\n# ============================================================\r\n\r\nrecords = [\r\n\r\n    record\r\n\r\n    for record in records\r\n\r\n    if id(record)\r\n    not in removed_record_ids\r\n]\r\n\r\n\r\n# ============================================================\r\n# ETAPE 2\r\n# PROLONGEMENTS UN AXE\r\n#\r\n# Ici nous utilisons l'association MurA pour retrouver\r\n# l'axe source.\r\n#\r\n# On cherche ensuite dans OUT[2] la géométrie de prolongement\r\n# correspondante par proximité.\r\n#\r\n# ============================================================\r\n\r\ndef closest_extension_to_axis(\r\n    axis_curve,\r\n    extensions\r\n):\r\n\r\n    data = curve_data(\r\n        axis_curve\r\n    )\r\n\r\n    if data is None:\r\n        return None\r\n\r\n\r\n    best = None\r\n    best_distance = None\r\n\r\n\r\n    for ext in extensions:\r\n\r\n        edata = curve_data(ext)\r\n\r\n        if edata is None:\r\n            continue\r\n\r\n\r\n        # ----------------------------------------------------\r\n        # Direction compatible\r\n        # ----------------------------------------------------\r\n\r\n        angle = angle_difference_deg(\r\n            data[\"dir\"],\r\n            edata[\"dir\"]\r\n        )\r\n\r\n\r\n        if angle > angle_tol_deg:\r\n            continue\r\n\r\n\r\n        # ----------------------------------------------------\r\n        # Droites support compatibles\r\n        # ----------------------------------------------------\r\n\r\n        offset = support_distance(\r\n            data,\r\n            edata\r\n        )\r\n\r\n\r\n        if offset > collinear_tol:\r\n            continue\r\n\r\n\r\n        # ----------------------------------------------------\r\n        # Une extrémité de l'extension doit être proche\r\n        # d'une extrémité de l'axe.\r\n        # ----------------------------------------------------\r\n\r\n        d = min(\r\n\r\n            distance2d(\r\n                data[\"p0\"],\r\n                edata[\"p0\"]\r\n            ),\r\n\r\n            distance2d(\r\n                data[\"p0\"],\r\n                edata[\"p1\"]\r\n            ),\r\n\r\n            distance2d(\r\n                data[\"p1\"],\r\n                edata[\"p0\"]\r\n            ),\r\n\r\n            distance2d(\r\n                data[\"p1\"],\r\n                edata[\"p1\"]\r\n            )\r\n        )\r\n\r\n\r\n        if (\r\n            best is None\r\n            or\r\n            d < best_distance\r\n        ):\r\n\r\n            best = ext\r\n            best_distance = d\r\n\r\n\r\n    return best\r\n\r\n\r\nsingle_axis_done = 0\r\nsingle_axis_failed = 0\r\n\r\nused_extensions = set()\r\n\r\n\r\nfor assoc in single_axis_assoc:\r\n\r\n    mur_a = get_info(\r\n        assoc,\r\n        \"MurA\",\r\n        None\r\n    )\r\n\r\n\r\n    if mur_a is None:\r\n\r\n        single_axis_failed += 1\r\n        continue\r\n\r\n\r\n    record = record_by_source.get(\r\n        mur_a\r\n    )\r\n\r\n\r\n    if record is None:\r\n\r\n        single_axis_failed += 1\r\n        continue\r\n\r\n\r\n    # --------------------------------------------------------\r\n    # Si l'axe a déjà été fusionné par une association\r\n    # DeuxAxes, on ne lui applique pas automatiquement\r\n    # un prolongement UnAxe.\r\n    # --------------------------------------------------------\r\n\r\n    if record[\"door_two_axis\"]:\r\n\r\n        single_axis_failed += 1\r\n        continue\r\n\r\n\r\n    available_extensions = [\r\n\r\n        ext\r\n\r\n        for ext in single_axis_extensions\r\n\r\n        if id(ext)\r\n        not in used_extensions\r\n    ]\r\n\r\n\r\n    extension = closest_extension_to_axis(\r\n        record[\"curve\"],\r\n        available_extensions\r\n    )\r\n\r\n\r\n    if extension is None:\r\n\r\n        single_axis_failed += 1\r\n        continue\r\n\r\n\r\n    da = curve_data(\r\n        record[\"curve\"]\r\n    )\r\n\r\n    de = curve_data(\r\n        extension\r\n    )\r\n\r\n\r\n    merged_curve = merge_two_segments(\r\n        da,\r\n        de\r\n    )\r\n\r\n\r\n    if merged_curve is None:\r\n\r\n        single_axis_failed += 1\r\n        continue\r\n\r\n\r\n    record[\"curve\"] = merged_curve\r\n\r\n    record[\"modified\"] = True\r\n\r\n    record[\"door_single_axis\"] = True\r\n\r\n\r\n    used_extensions.add(\r\n        id(extension)\r\n    )\r\n\r\n\r\n    single_axis_done += 1\r\n\r\n\r\n# ============================================================\r\n# ETAPE 3\r\n# FUSION GENERALE DES AXES COLINEAIRES\r\n#\r\n# IMPORTANT :\r\n#\r\n# Les axes issus de \"UnAxe\" ne doivent pas déclencher\r\n# une fusion automatique avec un autre axe.\r\n#\r\n# Ils peuvent être prolongés, mais restent isolés.\r\n#\r\n# Cela évite :\r\n#\r\n#    axe ---- [porte] ======= autre axe\r\n#\r\n# alors que MUR_04 n'avait pas validé cet autre axe.\r\n# ============================================================\r\n\r\ngeneral_merges = 0\r\n\r\nchanged = True\r\n\r\n\r\nwhile changed:\r\n\r\n    changed = False\r\n\r\n    n = len(records)\r\n\r\n\r\n    for i in range(n):\r\n\r\n        if changed:\r\n            break\r\n\r\n\r\n        a = records[i]\r\n\r\n\r\n        # UnAxe = pas de fusion en chaîne\r\n        if a[\"door_single_axis\"]:\r\n            continue\r\n\r\n\r\n        for j in range(\r\n            i + 1,\r\n            n\r\n        ):\r\n\r\n            b = records[j]\r\n\r\n\r\n            if b[\"door_single_axis\"]:\r\n                continue\r\n\r\n\r\n            compatible, info = can_merge(\r\n                a,\r\n                b\r\n            )\r\n\r\n\r\n            if not compatible:\r\n                continue\r\n\r\n\r\n            da = curve_data(\r\n                a[\"curve\"]\r\n            )\r\n\r\n            db = curve_data(\r\n                b[\"curve\"]\r\n            )\r\n\r\n\r\n            merged_curve = merge_two_segments(\r\n                da,\r\n                db\r\n            )\r\n\r\n\r\n            if merged_curve is None:\r\n                continue\r\n\r\n\r\n            # ------------------------------------------------\r\n            # Epaisseur\r\n            # ------------------------------------------------\r\n\r\n            wa = a[\"width_mm\"]\r\n            wb = b[\"width_mm\"]\r\n\r\n\r\n            if (\r\n                wa is not None\r\n                and\r\n                wb is not None\r\n            ):\r\n\r\n                # Pondération par longueur\r\n                la = da[\"length\"]\r\n                lb = db[\"length\"]\r\n\r\n                if la + lb > 1e-12:\r\n\r\n                    width = (\r\n                        wa * la +\r\n                        wb * lb\r\n                    ) / (\r\n                        la + lb\r\n                    )\r\n\r\n                else:\r\n\r\n                    width = (\r\n                        wa + wb\r\n                    ) * 0.5\r\n\r\n            elif wa is not None:\r\n\r\n                width = wa\r\n\r\n            else:\r\n\r\n                width = wb\r\n\r\n\r\n            merged_record = {\r\n\r\n                \"curve\":\r\n                    merged_curve,\r\n\r\n                \"width_mm\":\r\n                    width,\r\n\r\n                \"sources\":\r\n                    a[\"sources\"] +\r\n                    b[\"sources\"],\r\n\r\n                \"modified\":\r\n                    True,\r\n\r\n                \"door_two_axis\":\r\n                    (\r\n                        a[\"door_two_axis\"]\r\n                        or\r\n                        b[\"door_two_axis\"]\r\n                    ),\r\n\r\n                \"door_single_axis\":\r\n                    False\r\n            }\r\n\r\n\r\n            # ------------------------------------------------\r\n            # Remplacer A et B\r\n            # ------------------------------------------------\r\n\r\n            new_records = []\r\n\r\n\r\n            for k, record in enumerate(\r\n                records\r\n            ):\r\n\r\n                if k == i or k == j:\r\n                    continue\r\n\r\n                new_records.append(\r\n                    record\r\n                )\r\n\r\n\r\n            new_records.append(\r\n                merged_record\r\n            )\r\n\r\n            records = new_records\r\n\r\n\r\n            general_merges += 1\r\n\r\n            changed = True\r\n\r\n            break\r\n\r\n\r\n# ============================================================\r\n# OUTPUT FINAL\r\n# ============================================================\r\n\r\nfinal_axes = []\r\n\r\nfinal_widths = []\r\n\r\nmodified_axes = []\r\n\r\nunmodified_axes = []\r\n\r\naxis_infos = []\r\n\r\n\r\nfor index, record in enumerate(\r\n    records\r\n):\r\n\r\n    curve = record[\"curve\"]\r\n\r\n    data = curve_data(curve)\r\n\r\n\r\n    if data is None:\r\n        continue\r\n\r\n\r\n    final_axes.append(\r\n        curve\r\n    )\r\n\r\n    final_widths.append(\r\n        record[\"width_mm\"]\r\n    )\r\n\r\n\r\n    if record[\"modified\"]:\r\n\r\n        modified_axes.append(\r\n            curve\r\n        )\r\n\r\n    else:\r\n\r\n        unmodified_axes.append(\r\n            curve\r\n        )\r\n\r\n\r\n    axis_infos.append({\r\n\r\n        \"IndexFinal\":\r\n            index,\r\n\r\n        \"SourcesMUR03\":\r\n            record[\"sources\"],\r\n\r\n        \"NbSources\":\r\n            len(\r\n                record[\"sources\"]\r\n            ),\r\n\r\n        \"Epaisseur_mm\":\r\n            (\r\n                round(\r\n                    record[\"width_mm\"],\r\n                    2\r\n                )\r\n                if\r\n                record[\"width_mm\"]\r\n                is not None\r\n                else None\r\n            ),\r\n\r\n        \"Longueur_mm\":\r\n            round(\r\n                project_to_mm(\r\n                    data[\"length\"]\r\n                ),\r\n                1\r\n            ),\r\n\r\n        \"Modifie\":\r\n            record[\"modified\"],\r\n\r\n        \"ConnexionPorteDeuxAxes\":\r\n            record[\"door_two_axis\"],\r\n\r\n        \"ProlongementPorteUnAxe\":\r\n            record[\"door_single_axis\"]\r\n    })\r\n\r\n\r\n# ============================================================\r\n# DIAGNOSTIC\r\n# ============================================================\r\n\r\ndiagnostic = {\r\n\r\n    \"Axes MUR03 entree\":\r\n        len(axes),\r\n\r\n    \"Axes MUR03 valides\":\r\n        len([\r\n            x for x in axes\r\n            if curve_data(x) is not None\r\n        ]),\r\n\r\n    \"Associations DeuxAxes valides\":\r\n        len(valid_two_axis_assoc),\r\n\r\n    \"Associations DeuxAxes ambigues ignorees\":\r\n        len(ambiguous_two_axis_assoc),\r\n\r\n    \"Fusions DeuxAxes effectuees\":\r\n        two_axis_merges_done,\r\n\r\n    \"Fusions DeuxAxes echouees\":\r\n        two_axis_failed,\r\n\r\n    \"Associations UnAxe\":\r\n        len(single_axis_assoc),\r\n\r\n    \"Prolongements UnAxe appliques\":\r\n        single_axis_done,\r\n\r\n    \"Prolongements UnAxe non appliques\":\r\n        single_axis_failed,\r\n\r\n    \"Fusions generales\":\r\n        general_merges,\r\n\r\n    \"Axes finaux\":\r\n        len(final_axes),\r\n\r\n    \"Axes modifies\":\r\n        len(modified_axes),\r\n\r\n    \"Axes non modifies\":\r\n        len(unmodified_axes),\r\n\r\n    \"Tolerance angle deg\":\r\n        angle_tol_deg,\r\n\r\n    \"Tolerance colinearite mm\":\r\n        collinear_tol_mm,\r\n\r\n    \"Tolerance gap mm\":\r\n        gap_tol_mm,\r\n\r\n    \"Tolerance epaisseur mm\":\r\n        width_tol_mm\r\n}\r\n\r\n\r\n# ============================================================\r\n# OUTPUT\r\n# ============================================================\r\n\r\nOUT = (\r\n\r\n    final_axes,          # OUT[0]\r\n\r\n    final_widths,        # OUT[1]\r\n\r\n    modified_axes,       # OUT[2]\r\n\r\n    unmodified_axes,     # OUT[3]\r\n\r\n    axis_infos,          # OUT[4]\r\n\r\n    diagnostic           # OUT[5]\r\n)",
      "Engine": "PythonNet3",
      "VariableInputPorts": true,
      "Id": "a97be03dff46410ba2f3ebda11e2119f",
