    {
      "ConcreteType": "PythonNodeModels.PythonNode, PythonNodeModels",
      "Code": "# -*- coding: utf-8 -*-\r\n\r\nimport clr\r\nimport math\r\n\r\n\r\n# ============================================================\r\n# DESIGN SCRIPT\r\n# ============================================================\r\n\r\nclr.AddReference(\"ProtoGeometry\")\r\n\r\nfrom Autodesk.DesignScript.Geometry import (\r\n    Line as DSLine\r\n)\r\n\r\n\r\n# ============================================================\r\n# REVIT API\r\n# ============================================================\r\n\r\nclr.AddReference(\"RevitAPI\")\r\n\r\nfrom Autodesk.Revit.DB import (\r\n    Curve,\r\n    Line,\r\n    Wall,\r\n    WallType,\r\n    Level,\r\n    UnitUtils,\r\n    UnitTypeId,\r\n    BuiltInParameter\r\n)\r\n\r\n\r\n# ============================================================\r\n# DYNAMO <-> REVIT CONVERSION\r\n# ============================================================\r\n\r\nclr.AddReference(\"RevitNodes\")\r\n\r\nimport Revit\r\n\r\nclr.ImportExtensions(\r\n    Revit.GeometryConversion\r\n)\r\n\r\nclr.ImportExtensions(\r\n    Revit.Elements\r\n)\r\n\r\n\r\n# ============================================================\r\n# REVIT SERVICES\r\n# ============================================================\r\n\r\nclr.AddReference(\"RevitServices\")\r\n\r\nfrom RevitServices.Persistence import (\r\n    DocumentManager\r\n)\r\n\r\nfrom RevitServices.Transactions import (\r\n    TransactionManager\r\n)\r\n\r\n\r\n# ============================================================\r\n# MUR_09_CreerMursRevit\r\n#\r\n# IN[0] = Axes MUR_07\r\n# IN[1] = WallTypes MUR_08\r\n# IN[2] = Niveau bas\r\n# IN[3] = Niveau haut\r\n# IN[4] = Decalage bas mm\r\n# IN[5] = Decalage haut mm\r\n#\r\n#\r\n# OUT[0] = MursCrees\r\n# OUT[1] = AxesCrees\r\n# OUT[2] = IndicesCrees\r\n# OUT[3] = AxesIgnores\r\n# OUT[4] = Erreurs\r\n# OUT[5] = Informations\r\n# OUT[6] = Diagnostic\r\n#\r\n# ============================================================\r\n\r\n\r\n# ============================================================\r\n# DOCUMENT\r\n# ============================================================\r\n\r\ndoc = (\r\n    DocumentManager\r\n    .Instance\r\n    .CurrentDBDocument\r\n)\r\n\r\n\r\n# ============================================================\r\n# INPUTS\r\n# ============================================================\r\n\r\ninput_axes = (\r\n    IN[0]\r\n    if IN[0]\r\n    else []\r\n)\r\n\r\ninput_wall_types = (\r\n    IN[1]\r\n    if IN[1]\r\n    else []\r\n)\r\n\r\nbase_level = IN[2]\r\ntop_level = IN[3]\r\n\r\n\r\nbottom_offset_mm = (\r\n\r\n    float(IN[4])\r\n\r\n    if (\r\n        len(IN) > 4\r\n        and\r\n        IN[4] is not None\r\n    )\r\n\r\n    else 0.0\r\n)\r\n\r\n\r\ntop_offset_mm = (\r\n\r\n    float(IN[5])\r\n\r\n    if (\r\n        len(IN) > 5\r\n        and\r\n        IN[5] is not None\r\n    )\r\n\r\n    else 0.0\r\n)\r\n\r\n\r\n# ============================================================\r\n# UNWRAP LEVELS\r\n# ============================================================\r\n\r\ntry:\r\n\r\n    base_level = UnwrapElement(\r\n        base_level\r\n    )\r\n\r\nexcept:\r\n\r\n    pass\r\n\r\n\r\ntry:\r\n\r\n    top_level = UnwrapElement(\r\n        top_level\r\n    )\r\n\r\nexcept:\r\n\r\n    pass\r\n\r\n\r\n# ============================================================\r\n# AXES\r\n#\r\n# Les axes peuvent éventuellement arriver dans une liste\r\n# imbriquée. Ici on peut les flatten.\r\n# ============================================================\r\n\r\ndef flatten(data):\r\n\r\n    result = []\r\n\r\n    if isinstance(\r\n        data,\r\n        (list, tuple)\r\n    ):\r\n\r\n        for item in data:\r\n\r\n            result.extend(\r\n                flatten(item)\r\n            )\r\n\r\n    elif data is not None:\r\n\r\n        result.append(\r\n            data\r\n        )\r\n\r\n    return result\r\n\r\n\r\naxes = flatten(\r\n    input_axes\r\n)\r\n\r\n\r\n# ============================================================\r\n# WALLTYPES\r\n#\r\n# IMPORTANT :\r\n#\r\n# NE PAS utiliser flatten() ici.\r\n#\r\n# Il faut absolument conserver :\r\n#\r\n# Axe 46 -> WallType 46\r\n# Axe 47 -> None\r\n# Axe 48 -> WallType 48\r\n#\r\n# Sinon l'alignement axes/types serait détruit.\r\n# ============================================================\r\n\r\nif isinstance(\r\n    input_wall_types,\r\n    (list, tuple)\r\n):\r\n\r\n    wall_types_raw = list(\r\n        input_wall_types\r\n    )\r\n\r\nelse:\r\n\r\n    wall_types_raw = [\r\n        input_wall_types\r\n    ]\r\n\r\n\r\nwall_types = []\r\n\r\n\r\nfor item in wall_types_raw:\r\n\r\n    if item is None:\r\n\r\n        wall_types.append(\r\n            None\r\n        )\r\n\r\n        continue\r\n\r\n\r\n    try:\r\n\r\n        item = UnwrapElement(\r\n            item\r\n        )\r\n\r\n    except:\r\n\r\n        pass\r\n\r\n\r\n    wall_types.append(\r\n        item\r\n    )\r\n\r\n\r\n# ============================================================\r\n# UNITES\r\n# ============================================================\r\n\r\ndef mm_to_internal(value_mm):\r\n\r\n    return (\r\n        UnitUtils\r\n        .ConvertToInternalUnits(\r\n            float(value_mm),\r\n            UnitTypeId.Millimeters\r\n        )\r\n    )\r\n\r\n\r\ndef internal_to_mm(value):\r\n\r\n    return (\r\n        UnitUtils\r\n        .ConvertFromInternalUnits(\r\n            value,\r\n            UnitTypeId.Millimeters\r\n        )\r\n    )\r\n\r\n\r\nbottom_offset = mm_to_internal(\r\n    bottom_offset_mm\r\n)\r\n\r\ntop_offset = mm_to_internal(\r\n    top_offset_mm\r\n)\r\n\r\n\r\n# ============================================================\r\n# ELEMENT ID\r\n# ============================================================\r\n\r\ndef get_element_id_value(element):\r\n\r\n    if element is None:\r\n        return None\r\n\r\n\r\n    try:\r\n\r\n        return element.Id.Value\r\n\r\n    except:\r\n\r\n        try:\r\n\r\n            return (\r\n                element\r\n                .Id\r\n                .IntegerValue\r\n            )\r\n\r\n        except:\r\n\r\n            return None\r\n\r\n\r\n# ============================================================\r\n# CONVERSION DYNAMO -> REVIT\r\n#\r\n# IMPORTANT :\r\n#\r\n# Ici on utilise directement la couche de conversion\r\n# Dynamo/Revit.\r\n#\r\n# Autodesk.DesignScript.Geometry.Line\r\n#\r\n#              ↓\r\n#\r\n#         ToRevitType()\r\n#\r\n#              ↓\r\n#\r\n# Autodesk.Revit.DB.Line\r\n#\r\n#\r\n# On retourne également le détail de l'erreur afin de ne\r\n# jamais masquer une erreur CPython.\r\n# ============================================================\r\n\r\ndef dynamo_curve_to_revit_curve(\r\n    dynamo_curve\r\n):\r\n\r\n    if dynamo_curve is None:\r\n\r\n        return (\r\n            None,\r\n            \"Curve = None\"\r\n        )\r\n\r\n\r\n    # --------------------------------------------------------\r\n    # Cas exceptionnel :\r\n    # l'entrée serait déjà une Curve Revit\r\n    # --------------------------------------------------------\r\n\r\n    try:\r\n\r\n        if isinstance(\r\n            dynamo_curve,\r\n            Curve\r\n        ):\r\n\r\n            return (\r\n                dynamo_curve,\r\n                None\r\n            )\r\n\r\n    except:\r\n\r\n        pass\r\n\r\n\r\n    # --------------------------------------------------------\r\n    # Conversion Dynamo native\r\n    # --------------------------------------------------------\r\n\r\n    try:\r\n\r\n        revit_curve = (\r\n            dynamo_curve\r\n            .ToRevitType()\r\n        )\r\n\r\n\r\n        if revit_curve is None:\r\n\r\n            return (\r\n                None,\r\n                \"ToRevitType() retourne None\"\r\n            )\r\n\r\n\r\n        if not isinstance(\r\n            revit_curve,\r\n            Curve\r\n        ):\r\n\r\n            return (\r\n\r\n                None,\r\n\r\n                (\r\n                    \"ToRevitType() a retourne \"\r\n                    \"un objet qui n'est pas \"\r\n                    \"Autodesk.Revit.DB.Curve : \"\r\n                    +\r\n                    str(\r\n                        type(\r\n                            revit_curve\r\n                        )\r\n                    )\r\n                )\r\n            )\r\n\r\n\r\n        return (\r\n            revit_curve,\r\n            None\r\n        )\r\n\r\n\r\n    except Exception as ex:\r\n\r\n        return (\r\n\r\n            None,\r\n\r\n            (\r\n                \"Erreur ToRevitType : \"\r\n                +\r\n                str(ex)\r\n            )\r\n        )\r\n\r\n\r\n# ============================================================\r\n# VALIDATION GENERALE\r\n# ============================================================\r\n\r\nfatal_errors = []\r\n\r\n\r\nif not isinstance(\r\n    base_level,\r\n    Level\r\n):\r\n\r\n    fatal_errors.append(\r\n        \"IN[2] doit etre un Level Revit.\"\r\n    )\r\n\r\n\r\nif not isinstance(\r\n    top_level,\r\n    Level\r\n):\r\n\r\n    fatal_errors.append(\r\n        \"IN[3] doit etre un Level Revit.\"\r\n    )\r\n\r\n\r\nif len(axes) == 0:\r\n\r\n    fatal_errors.append(\r\n        \"Aucun axe recu dans IN[0].\"\r\n    )\r\n\r\n\r\nif len(wall_types) == 0:\r\n\r\n    fatal_errors.append(\r\n        \"Aucun WallType recu dans IN[1].\"\r\n    )\r\n\r\n\r\n# ============================================================\r\n# HAUTEUR\r\n#\r\n# La hauteur géométrique entre :\r\n#\r\n# NiveauBas + offsetBas\r\n#\r\n# et\r\n#\r\n# NiveauHaut + offsetHaut\r\n# ============================================================\r\n\r\nwall_height = None\r\n\r\n\r\nif (\r\n    isinstance(base_level, Level)\r\n    and\r\n    isinstance(top_level, Level)\r\n):\r\n\r\n    wall_height = (\r\n\r\n        top_level.Elevation\r\n        +\r\n        top_offset\r\n\r\n        -\r\n\r\n        (\r\n            base_level.Elevation\r\n            +\r\n            bottom_offset\r\n        )\r\n    )\r\n\r\n\r\n    if wall_height <= 0.0:\r\n\r\n        fatal_errors.append(\r\n\r\n            \"Hauteur de mur <= 0. \"\r\n            \"Verifier Niveau Bas, Niveau Haut \"\r\n            \"et les offsets.\"\r\n        )\r\n\r\n\r\n# ============================================================\r\n# OUTPUTS\r\n# ============================================================\r\n\r\ncreated_walls = []\r\n\r\ncreated_axes = []\r\n\r\ncreated_indices = []\r\n\r\nignored_axes = []\r\n\r\nerrors = []\r\n\r\ninformations = []\r\n\r\n\r\nconversion_success = 0\r\nconversion_failure = 0\r\n\r\nnull_walltypes = 0\r\n\r\ncreation_success = 0\r\ncreation_failure = 0\r\n\r\n\r\n# ============================================================\r\n# TRANSACTION\r\n# ============================================================\r\n\r\nif len(fatal_errors) == 0:\r\n\r\n    TransactionManager.Instance.EnsureInTransaction(\r\n        doc\r\n    )\r\n\r\n\r\n    try:\r\n\r\n        # ====================================================\r\n        # BOUCLE AXES\r\n        # ====================================================\r\n\r\n        for i, axis in enumerate(\r\n            axes\r\n        ):\r\n\r\n            # =================================================\r\n            # WALLTYPE\r\n            # =================================================\r\n\r\n            if i >= len(\r\n                wall_types\r\n            ):\r\n\r\n                ignored_axes.append(\r\n                    axis\r\n                )\r\n\r\n\r\n                errors.append({\r\n\r\n                    \"AxeIndex\":\r\n                        i,\r\n\r\n                    \"Etape\":\r\n                        \"WallType\",\r\n\r\n                    \"Erreur\":\r\n                        (\r\n                            \"Index WallType inexistant. \"\r\n                            \"Nombre de WallTypes = \"\r\n                            +\r\n                            str(\r\n                                len(\r\n                                    wall_types\r\n                                )\r\n                            )\r\n                        )\r\n                })\r\n\r\n\r\n                continue\r\n\r\n\r\n            wall_type = (\r\n                wall_types[i]\r\n            )\r\n\r\n\r\n            # =================================================\r\n            # WALLTYPE NULL\r\n            #\r\n            # Dans notre cas :\r\n            #\r\n            # index 47\r\n            # épaisseur 0 mm\r\n            # =================================================\r\n\r\n            if wall_type is None:\r\n\r\n                null_walltypes += 1\r\n\r\n\r\n                ignored_axes.append(\r\n                    axis\r\n                )\r\n\r\n\r\n                informations.append({\r\n\r\n                    \"AxeIndex\":\r\n                        i,\r\n\r\n                    \"Statut\":\r\n                        \"Ignore\",\r\n\r\n                    \"Raison\":\r\n                        \"WallType null\"\r\n                })\r\n\r\n\r\n                continue\r\n\r\n\r\n            # =================================================\r\n            # VALIDATION WALLTYPE\r\n            # =================================================\r\n\r\n            if not isinstance(\r\n                wall_type,\r\n                WallType\r\n            ):\r\n\r\n                ignored_axes.append(\r\n                    axis\r\n                )\r\n\r\n\r\n                errors.append({\r\n\r\n                    \"AxeIndex\":\r\n                        i,\r\n\r\n                    \"Etape\":\r\n                        \"WallType\",\r\n\r\n                    \"Erreur\":\r\n                        (\r\n                            \"Objet associe non reconnu \"\r\n                            \"comme Autodesk.Revit.DB.WallType.\"\r\n                        ),\r\n\r\n                    \"TypeObjet\":\r\n                        str(\r\n                            type(\r\n                                wall_type\r\n                            )\r\n                        )\r\n                })\r\n\r\n\r\n                continue\r\n\r\n\r\n            # =================================================\r\n            # CONVERSION AXE\r\n            # =================================================\r\n\r\n            (\r\n                revit_curve,\r\n                conversion_error\r\n\r\n            ) = dynamo_curve_to_revit_curve(\r\n                axis\r\n            )\r\n\r\n\r\n            if revit_curve is None:\r\n\r\n                conversion_failure += 1\r\n\r\n\r\n                ignored_axes.append(\r\n                    axis\r\n                )\r\n\r\n\r\n                # ---------------------------------------------\r\n                # Type DesignScript pour diagnostic\r\n                # ---------------------------------------------\r\n\r\n                try:\r\n\r\n                    axis_type = str(\r\n                        axis.GetType()\r\n                    )\r\n\r\n                except:\r\n\r\n                    axis_type = str(\r\n                        type(axis)\r\n                    )\r\n\r\n\r\n                errors.append({\r\n\r\n                    \"AxeIndex\":\r\n                        i,\r\n\r\n                    \"Etape\":\r\n                        \"Conversion\",\r\n\r\n                    \"Erreur\":\r\n                        conversion_error,\r\n\r\n                    \"TypeAxe\":\r\n                        axis_type\r\n                })\r\n\r\n\r\n                continue\r\n\r\n\r\n            conversion_success += 1\r\n\r\n\r\n            # =================================================\r\n            # WALL.CREATE\r\n            #\r\n            # On crée initialement avec une hauteur explicite.\r\n            #\r\n            # Puis on affecte la contrainte supérieure.\r\n            # =================================================\r\n\r\n            try:\r\n\r\n                wall = Wall.Create(\r\n\r\n                    doc,\r\n\r\n                    revit_curve,\r\n\r\n                    wall_type.Id,\r\n\r\n                    base_level.Id,\r\n\r\n                    wall_height,\r\n\r\n                    bottom_offset,\r\n\r\n                    False,  # flip\r\n\r\n                    False   # structural\r\n                )\r\n\r\n\r\n                # =============================================\r\n                # CONTRAINTE SUPERIEURE\r\n                # =============================================\r\n\r\n                top_constraint = (\r\n                    wall.get_Parameter(\r\n                        BuiltInParameter.WALL_HEIGHT_TYPE\r\n                    )\r\n                )\r\n\r\n\r\n                if (\r\n                    top_constraint is not None\r\n                    and\r\n                    not top_constraint.IsReadOnly\r\n                ):\r\n\r\n                    top_constraint.Set(\r\n                        top_level.Id\r\n                    )\r\n\r\n\r\n                # =============================================\r\n                # OFFSET SUPERIEUR\r\n                # =============================================\r\n\r\n                top_offset_parameter = (\r\n                    wall.get_Parameter(\r\n                        BuiltInParameter.WALL_TOP_OFFSET\r\n                    )\r\n                )\r\n\r\n\r\n                if (\r\n                    top_offset_parameter\r\n                    is not None\r\n\r\n                    and\r\n\r\n                    not\r\n                    top_offset_parameter\r\n                    .IsReadOnly\r\n                ):\r\n\r\n                    top_offset_parameter.Set(\r\n                        top_offset\r\n                    )\r\n\r\n\r\n                # =============================================\r\n                # OFFSET INFERIEUR\r\n                # =============================================\r\n\r\n                bottom_offset_parameter = (\r\n                    wall.get_Parameter(\r\n                        BuiltInParameter.WALL_BASE_OFFSET\r\n                    )\r\n                )\r\n\r\n\r\n                if (\r\n                    bottom_offset_parameter\r\n                    is not None\r\n\r\n                    and\r\n\r\n                    not\r\n                    bottom_offset_parameter\r\n                    .IsReadOnly\r\n                ):\r\n\r\n                    bottom_offset_parameter.Set(\r\n                        bottom_offset\r\n                    )\r\n\r\n\r\n                # =============================================\r\n                # SUCCESS\r\n                # =============================================\r\n\r\n                created_walls.append(\r\n                    wall\r\n                )\r\n\r\n                created_axes.append(\r\n                    axis\r\n                )\r\n\r\n                created_indices.append(\r\n                    i\r\n                )\r\n\r\n\r\n                creation_success += 1\r\n\r\n\r\n                informations.append({\r\n\r\n                    \"AxeIndex\":\r\n                        i,\r\n\r\n                    \"Statut\":\r\n                        \"Cree\",\r\n\r\n                    \"WallId\":\r\n                        get_element_id_value(\r\n                            wall\r\n                        ),\r\n\r\n                    \"WallType\":\r\n                        wall_type.Name,\r\n\r\n                    \"WallTypeId\":\r\n                        get_element_id_value(\r\n                            wall_type\r\n                        )\r\n                })\r\n\r\n\r\n            except Exception as ex:\r\n\r\n                creation_failure += 1\r\n\r\n\r\n                ignored_axes.append(\r\n                    axis\r\n                )\r\n\r\n\r\n                errors.append({\r\n\r\n                    \"AxeIndex\":\r\n                        i,\r\n\r\n                    \"Etape\":\r\n                        \"Wall.Create\",\r\n\r\n                    \"Erreur\":\r\n                        str(ex),\r\n\r\n                    \"WallType\":\r\n                        wall_type.Name,\r\n\r\n                    \"WallTypeId\":\r\n                        get_element_id_value(\r\n                            wall_type\r\n                        )\r\n                })\r\n\r\n\r\n    finally:\r\n\r\n        TransactionManager.Instance.TransactionTaskDone()\r\n\r\n\r\n# ============================================================\r\n# HAUTEUR POUR DIAGNOSTIC\r\n# ============================================================\r\n\r\nheight_mm = None\r\n\r\n\r\nif wall_height is not None:\r\n\r\n    try:\r\n\r\n        height_mm = internal_to_mm(\r\n            wall_height\r\n        )\r\n\r\n    except:\r\n\r\n        pass\r\n\r\n\r\n# ============================================================\r\n# DIAGNOSTIC\r\n# ============================================================\r\n\r\ndiagnostic = {\r\n\r\n    \"Axes entree\":\r\n        len(axes),\r\n\r\n    \"WallTypes entree\":\r\n        len(wall_types),\r\n\r\n    \"Conversions reussies\":\r\n        conversion_success,\r\n\r\n    \"Conversions echouees\":\r\n        conversion_failure,\r\n\r\n    \"WallTypes null\":\r\n        null_walltypes,\r\n\r\n    \"Murs crees\":\r\n        len(created_walls),\r\n\r\n    \"Creations reussies\":\r\n        creation_success,\r\n\r\n    \"Creations echouees\":\r\n        creation_failure,\r\n\r\n    \"Axes ignores\":\r\n        len(ignored_axes),\r\n\r\n    \"Erreurs\":\r\n        len(errors),\r\n\r\n    \"Details erreurs\":\r\n        errors,\r\n\r\n    \"Niveau bas\":\r\n        (\r\n            base_level.Name\r\n\r\n            if isinstance(\r\n                base_level,\r\n                Level\r\n            )\r\n\r\n            else None\r\n        ),\r\n\r\n    \"Niveau haut\":\r\n        (\r\n            top_level.Name\r\n\r\n            if isinstance(\r\n                top_level,\r\n                Level\r\n            )\r\n\r\n            else None\r\n        ),\r\n\r\n    \"Decalage bas mm\":\r\n        bottom_offset_mm,\r\n\r\n    \"Decalage haut mm\":\r\n        top_offset_mm,\r\n\r\n    \"Hauteur calculee mm\":\r\n        (\r\n            round(\r\n                height_mm,\r\n                2\r\n            )\r\n\r\n            if height_mm is not None\r\n\r\n            else None\r\n        ),\r\n\r\n    \"Erreurs fatales\":\r\n        fatal_errors\r\n}\r\n\r\n\r\n# ============================================================\r\n# OUTPUT\r\n# ============================================================\r\n\r\nOUT = (\r\n\r\n    created_walls,       # OUT[0]\r\n\r\n    created_axes,        # OUT[1]\r\n\r\n    created_indices,     # OUT[2]\r\n\r\n    ignored_axes,        # OUT[3]\r\n\r\n    errors,              # OUT[4]\r\n\r\n    informations,        # OUT[5]\r\n\r\n    diagnostic           # OUT[6]\r\n)",
      "Engine": "PythonNet3",
      "VariableInputPorts": true,
      "Id": "5b6b5ed9c625442c874804c4c2628211",
      "NodeType": "PythonScriptNode",
      "Inputs": [
        {
          "Id": "d8cbc5831b0d452a9e4896e77c2ba0fb",
          "Name": "IN[0]",
          "Description": "Input #0",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        },
        {
          "Id": "fe16316cc6594b61873d3d888285e2a3",
          "Name": "IN[1]",
          "Description": "Input #1",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        },
        {
          "Id": "599b7c84d0e2460fb53c73f1c83c2178",
          "Name": "IN[2]",
          "Description": "Input #2",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        },
        {
          "Id": "791bef6bf23b4aeda9cbd99d391b4f82",
          "Name": "IN[3]",
          "Description": "Input #3",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        },
        {
          "Id": "6aafcd0029574cbb8aabadbb55238dac",
          "Name": "IN[4]",
          "Description": "Input #4",
