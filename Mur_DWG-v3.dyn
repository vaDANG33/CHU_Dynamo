    {
      "ConcreteType": "PythonNodeModels.PythonNode, PythonNodeModels",
      "Code": "# -*- coding: utf-8 -*-\r\n\r\nimport clr\r\n\r\nclr.AddReference(\"ProtoGeometry\")\r\nfrom Autodesk.DesignScript.Geometry import Line\r\n\r\nclr.AddReference(\"RevitAPI\")\r\nfrom Autodesk.Revit.DB import UnitUtils, UnitTypeId, SpecTypeId\r\n\r\nclr.AddReference(\"RevitServices\")\r\nfrom RevitServices.Persistence import DocumentManager\r\n\r\n\r\n# ============================================================\r\n# INPUTS\r\n# ============================================================\r\n\r\ncurves_input = IN[0]\r\n\r\n# Valeurs saisies en mm\r\nmin_length_mm = float(IN[1]) if IN[1] is not None else 10.0\r\ntolerance_mm = float(IN[2]) if IN[2] is not None else 1.0\r\n\r\n\r\n# ============================================================\r\n# DOCUMENT REVIT + UNITES\r\n# ============================================================\r\n\r\ndoc = DocumentManager.Instance.CurrentDBDocument\r\n\r\nproject_unit_id = (\r\n    doc.GetUnits()\r\n       .GetFormatOptions(SpecTypeId.Length)\r\n       .GetUnitTypeId()\r\n)\r\n\r\n\r\ndef mm_to_project_units(value_mm):\r\n    \"\"\"\r\n    Convertit une valeur en mm vers l'unité de longueur\r\n    actuellement utilisée dans le projet Revit.\r\n    \"\"\"\r\n\r\n    internal_value = UnitUtils.ConvertToInternalUnits(\r\n        value_mm,\r\n        UnitTypeId.Millimeters\r\n    )\r\n\r\n    return UnitUtils.ConvertFromInternalUnits(\r\n        internal_value,\r\n        project_unit_id\r\n    )\r\n\r\n\r\nmin_length = mm_to_project_units(min_length_mm)\r\ntolerance = mm_to_project_units(tolerance_mm)\r\n\r\n\r\n# ============================================================\r\n# FLATTEN\r\n# ============================================================\r\n\r\ndef flatten(data):\r\n    \"\"\"\r\n    Aplatissement récursif des listes.\r\n    \"\"\"\r\n\r\n    result = []\r\n\r\n    if data is None:\r\n        return result\r\n\r\n    if isinstance(data, (list, tuple)):\r\n\r\n        for item in data:\r\n            result.extend(flatten(item))\r\n\r\n    else:\r\n\r\n        result.append(data)\r\n\r\n    return result\r\n\r\n\r\nall_curves = flatten(curves_input)\r\n\r\n\r\n# ============================================================\r\n# CONSERVER UNIQUEMENT LES LIGNES\r\n# ============================================================\r\n\r\nlines = []\r\n\r\nfor curve in all_curves:\r\n\r\n    if curve is None:\r\n        continue\r\n\r\n    # Une ligne DesignScript possède notamment StartPoint,\r\n    # EndPoint et Direction.\r\n    if (\r\n        hasattr(curve, \"StartPoint\")\r\n        and hasattr(curve, \"EndPoint\")\r\n        and hasattr(curve, \"Direction\")\r\n    ):\r\n        lines.append(curve)\r\n\r\n\r\ninitial_line_count = len(lines)\r\n\r\n\r\n# ============================================================\r\n# NORMALISER LE SENS DES LIGNES\r\n# ============================================================\r\n\r\ndef normalize_line(line):\r\n    \"\"\"\r\n    Impose un sens identique aux lignes géométriquement\r\n    équivalentes.\r\n\r\n    Priorité :\r\n        X croissant\r\n        puis Y croissant\r\n        puis Z croissant\r\n    \"\"\"\r\n\r\n    p1 = line.StartPoint\r\n    p2 = line.EndPoint\r\n\r\n    dx = p2.X - p1.X\r\n    dy = p2.Y - p1.Y\r\n    dz = p2.Z - p1.Z\r\n\r\n    reverse = False\r\n\r\n    if dx < -tolerance:\r\n\r\n        reverse = True\r\n\r\n    elif abs(dx) <= tolerance:\r\n\r\n        if dy < -tolerance:\r\n\r\n            reverse = True\r\n\r\n        elif abs(dy) <= tolerance and dz < -tolerance:\r\n\r\n            reverse = True\r\n\r\n    if reverse:\r\n\r\n        return Line.ByStartPointEndPoint(\r\n            p2,\r\n            p1\r\n        )\r\n\r\n    return line\r\n\r\n\r\nnormalized_lines = []\r\n\r\nfor line in lines:\r\n\r\n    try:\r\n\r\n        normalized_lines.append(\r\n            normalize_line(line)\r\n        )\r\n\r\n    except:\r\n\r\n        pass\r\n\r\n\r\n# ============================================================\r\n# CLE GEOMETRIQUE\r\n# ============================================================\r\n\r\ndef quantize(value):\r\n    \"\"\"\r\n    Regroupe les coordonnées situées dans la même\r\n    tolérance géométrique.\r\n    \"\"\"\r\n\r\n    if tolerance <= 0:\r\n\r\n        return round(value, 9)\r\n\r\n    return int(\r\n        round(value / tolerance)\r\n    )\r\n\r\n\r\ndef line_key(line):\r\n\r\n    p1 = line.StartPoint\r\n    p2 = line.EndPoint\r\n\r\n    return (\r\n        quantize(p1.X),\r\n        quantize(p1.Y),\r\n        quantize(p1.Z),\r\n\r\n        quantize(p2.X),\r\n        quantize(p2.Y),\r\n        quantize(p2.Z)\r\n    )\r\n\r\n\r\n# ============================================================\r\n# SUPPRIMER LES DOUBLONS\r\n# AVANT LE FILTRE DE LONGUEUR\r\n# ============================================================\r\n\r\nunique_lines = []\r\n\r\nknown_keys = set()\r\n\r\nremoved_duplicates = 0\r\n\r\nfor line in normalized_lines:\r\n\r\n    try:\r\n\r\n        key = line_key(line)\r\n\r\n        if key not in known_keys:\r\n\r\n            known_keys.add(key)\r\n            unique_lines.append(line)\r\n\r\n        else:\r\n\r\n            removed_duplicates += 1\r\n\r\n    except:\r\n\r\n        pass\r\n\r\n\r\n# ============================================================\r\n# SUPPRIMER LES LIGNES TROP COURTES\r\n# ============================================================\r\n\r\nfinal_lines = []\r\n\r\nremoved_short = 0\r\n\r\nfor line in unique_lines:\r\n\r\n    try:\r\n\r\n        if line.Length >= min_length:\r\n\r\n            final_lines.append(line)\r\n\r\n        else:\r\n\r\n            removed_short += 1\r\n\r\n    except:\r\n\r\n        pass\r\n\r\n\r\n# ============================================================\r\n# DIAGNOSTIC\r\n# ============================================================\r\n\r\ndiagnostic = {\r\n    \"Courbes initiales\": len(all_curves),\r\n    \"Lignes detectees\": initial_line_count,\r\n    \"Doublons supprimes\": removed_duplicates,\r\n    \"Lignes courtes supprimees\": removed_short,\r\n    \"Lignes finales\": len(final_lines),\r\n    \"Longueur mini mm\": min_length_mm,\r\n    \"Tolerance mm\": tolerance_mm\r\n}\r\n\r\n\r\n# ============================================================\r\n# OUTPUT\r\n# ============================================================\r\n\r\nOUT = final_lines, diagnostic",
      "Engine": "PythonNet3",
      "VariableInputPorts": true,
      "Id": "85c5a7bf21fc4c6f9f26805b52d6b861",
      "NodeType": "PythonScriptNode",
      "Inputs": [
        {
          "Id": "1c2673fb2a1a43c5b1bc12ac01ade880",
          "Name": "IN[0]",
          "Description": "Input #0",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        },
        {
          "Id": "47e68f71f2b94c7b97cf44d0a60eddd9",
          "Name": "IN[1]",
          "Description": "Input #1",
