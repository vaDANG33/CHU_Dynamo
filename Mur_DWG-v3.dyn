    {
      "ConcreteType": "PythonNodeModels.PythonNode, PythonNodeModels",
      "Code": "# -*- coding: utf-8 -*-\r\n\r\nimport clr\r\nimport math\r\n\r\n# ============================================================\r\n# REVIT API\r\n# ============================================================\r\n\r\nclr.AddReference(\"RevitAPI\")\r\n\r\nfrom Autodesk.Revit.DB import (\r\n    WallType,\r\n    FilteredElementCollector,\r\n    UnitUtils,\r\n    UnitTypeId\r\n)\r\n\r\n\r\n# ============================================================\r\n# REVIT SERVICES\r\n# ============================================================\r\n\r\nclr.AddReference(\"RevitServices\")\r\n\r\nfrom RevitServices.Persistence import DocumentManager\r\nfrom RevitServices.Transactions import TransactionManager\r\n\r\n\r\n# ============================================================\r\n# MUR_08_CreerTypesMurs\r\n#\r\n# IN[0]\r\n#     Epaisseurs classifiees de MUR_07\r\n#\r\n# IN[1]\r\n#     WallType modele\r\n#\r\n# IN[2]\r\n#     Prefixe\r\n#\r\n#\r\n# Exemple :\r\n#\r\n# Epaisseurs :\r\n#\r\n#   30\r\n#   70\r\n#   100\r\n#   120\r\n#\r\n# Type modele :\r\n#\r\n#   Mur generique\r\n#\r\n# Resultat :\r\n#\r\n#   A SUPPRIMER_CHU_Mur_30mm\r\n#   A SUPPRIMER_CHU_Mur_70mm\r\n#   A SUPPRIMER_CHU_Mur_100mm\r\n#   A SUPPRIMER_CHU_Mur_120mm\r\n#\r\n#\r\n# Si le type existe deja :\r\n#\r\n#   => reutilisation\r\n#\r\n# Si le type n'existe pas :\r\n#\r\n#   => duplication du type modele\r\n#   => modification largeur couche\r\n#\r\n# ============================================================\r\n\r\n\r\n# ============================================================\r\n# DOCUMENT\r\n# ============================================================\r\n\r\ndoc = DocumentManager.Instance.CurrentDBDocument\r\n\r\n\r\n# ============================================================\r\n# INPUTS\r\n# ============================================================\r\n\r\ninput_widths = IN[0] if IN[0] else []\r\n\r\nbase_wall_type = IN[1]\r\n\r\nprefix = IN[2] if len(IN) > 2 else None\r\n\r\n\r\nif prefix is None:\r\n\r\n    prefix = \"A SUPPRIMER_\"\r\n\r\n\r\ntry:\r\n\r\n    prefix = str(prefix)\r\n\r\nexcept:\r\n\r\n    prefix = \"A SUPPRIMER_\"\r\n\r\n\r\nif prefix.strip() == \"\":\r\n\r\n    prefix = \"A SUPPRIMER_\"\r\n\r\n\r\n# ============================================================\r\n# UNWRAP\r\n# ============================================================\r\n\r\ntry:\r\n\r\n    base_wall_type = UnwrapElement(\r\n        base_wall_type\r\n    )\r\n\r\nexcept:\r\n\r\n    pass\r\n\r\n\r\n# ============================================================\r\n# OUTILS\r\n# ============================================================\r\n\r\ndef flatten(data):\r\n\r\n    result = []\r\n\r\n    if isinstance(data, (list, tuple)):\r\n\r\n        for item in data:\r\n\r\n            result.extend(\r\n                flatten(item)\r\n            )\r\n\r\n    elif data is not None:\r\n\r\n        result.append(data)\r\n\r\n    return result\r\n\r\n\r\ndef safe_float(value):\r\n\r\n    try:\r\n\r\n        result = float(value)\r\n\r\n        if math.isnan(result):\r\n            return None\r\n\r\n        if math.isinf(result):\r\n            return None\r\n\r\n        return result\r\n\r\n    except:\r\n\r\n        return None\r\n\r\n\r\ndef format_width(width_mm):\r\n\r\n    \"\"\"\r\n    100.0 -> 100\r\n    72.0  -> 72\r\n    72.5  -> 72.5\r\n    \"\"\"\r\n\r\n    rounded = round(\r\n        width_mm\r\n    )\r\n\r\n\r\n    if abs(\r\n        width_mm -\r\n        rounded\r\n    ) < 1e-6:\r\n\r\n        return str(\r\n            int(rounded)\r\n        )\r\n\r\n\r\n    text = (\r\n        \"{:.3f}\".format(\r\n            width_mm\r\n        )\r\n        .rstrip(\"0\")\r\n        .rstrip(\".\")\r\n    )\r\n\r\n    return text\r\n\r\n\r\ndef make_type_name(width_mm):\r\n\r\n    return (\r\n        prefix\r\n        +\r\n        format_width(width_mm)\r\n        +\r\n        \"mm\"\r\n    )\r\n\r\n\r\ndef mm_to_internal(width_mm):\r\n\r\n    return UnitUtils.ConvertToInternalUnits(\r\n        width_mm,\r\n        UnitTypeId.Millimeters\r\n    )\r\n\r\n\r\n# ============================================================\r\n# EPAISSEURS\r\n# ============================================================\r\n\r\nwidths_raw = flatten(\r\n    input_widths\r\n)\r\n\r\nwidths = []\r\n\r\ninvalid_width_indices = []\r\n\r\n\r\nfor i, value in enumerate(\r\n    widths_raw\r\n):\r\n\r\n    width = safe_float(\r\n        value\r\n    )\r\n\r\n\r\n    if (\r\n        width is None\r\n        or\r\n        width <= 0.0\r\n    ):\r\n\r\n        widths.append(\r\n            None\r\n        )\r\n\r\n        invalid_width_indices.append(\r\n            i\r\n        )\r\n\r\n    else:\r\n\r\n        widths.append(\r\n            width\r\n        )\r\n\r\n\r\n# ============================================================\r\n# VERIFICATION DU TYPE MODELE\r\n# ============================================================\r\n\r\nfatal_error = None\r\n\r\n\r\nif base_wall_type is None:\r\n\r\n    fatal_error = (\r\n        \"Aucun WallType modele fourni.\"\r\n    )\r\n\r\n\r\nelif not isinstance(\r\n    base_wall_type,\r\n    WallType\r\n):\r\n\r\n    fatal_error = (\r\n        \"IN[1] doit etre un WallType Revit.\"\r\n    )\r\n\r\n\r\n# ============================================================\r\n# COLLECTER LES WALLTYPES EXISTANTS\r\n# ============================================================\r\n\r\nexisting_types_by_name = {}\r\n\r\n\r\nif fatal_error is None:\r\n\r\n    collector = (\r\n        FilteredElementCollector(doc)\r\n        .OfClass(WallType)\r\n    )\r\n\r\n\r\n    for wall_type in collector:\r\n\r\n        try:\r\n\r\n            name = wall_type.Name\r\n\r\n            existing_types_by_name[\r\n                name\r\n            ] = wall_type\r\n\r\n        except:\r\n\r\n            pass\r\n\r\n\r\n# ============================================================\r\n# CLASSES UNIQUES\r\n# ============================================================\r\n\r\nunique_widths = sorted(\r\n    set(\r\n        width\r\n        for width in widths\r\n        if width is not None\r\n    )\r\n)\r\n\r\n\r\n# ============================================================\r\n# OUTPUTS\r\n# ============================================================\r\n\r\ntypes_by_width = {}\r\n\r\ncreated_types = []\r\n\r\nreused_types = []\r\n\r\ncorrespondences = []\r\n\r\nerrors = []\r\n\r\n\r\n# ============================================================\r\n# CREATION / REUTILISATION\r\n# ============================================================\r\n\r\nif fatal_error is None:\r\n\r\n    TransactionManager.Instance.EnsureInTransaction(\r\n        doc\r\n    )\r\n\r\n\r\n    try:\r\n\r\n        for width_mm in unique_widths:\r\n\r\n            type_name = make_type_name(\r\n                width_mm\r\n            )\r\n\r\n\r\n            # =================================================\r\n            # CAS 1\r\n            # LE TYPE EXISTE DEJA\r\n            # =================================================\r\n\r\n            if type_name in existing_types_by_name:\r\n\r\n                wall_type = (\r\n                    existing_types_by_name[\r\n                        type_name\r\n                    ]\r\n                )\r\n\r\n\r\n                types_by_width[\r\n                    width_mm\r\n                ] = wall_type\r\n\r\n\r\n                reused_types.append(\r\n                    wall_type\r\n                )\r\n\r\n\r\n                correspondences.append({\r\n\r\n                    \"Epaisseur_mm\":\r\n                        width_mm,\r\n\r\n                    \"NomType\":\r\n                        type_name,\r\n\r\n                    \"Action\":\r\n                        \"Reutilise\",\r\n\r\n                    \"ElementId\":\r\n                        wall_type.Id.Value\r\n                })\r\n\r\n\r\n                continue\r\n\r\n\r\n            # =================================================\r\n            # CAS 2\r\n            # CREATION\r\n            # =================================================\r\n\r\n            try:\r\n\r\n                # ---------------------------------------------\r\n                # Dupliquer le type modele\r\n                # ---------------------------------------------\r\n\r\n                new_type = (\r\n                    base_wall_type.Duplicate(\r\n                        type_name\r\n                    )\r\n                )\r\n\r\n\r\n                # ---------------------------------------------\r\n                # CompoundStructure\r\n                # ---------------------------------------------\r\n\r\n                compound = (\r\n                    new_type.GetCompoundStructure()\r\n                )\r\n\r\n\r\n                if compound is None:\r\n\r\n                    errors.append({\r\n\r\n                        \"Epaisseur_mm\":\r\n                            width_mm,\r\n\r\n                        \"NomType\":\r\n                            type_name,\r\n\r\n                        \"Erreur\":\r\n                            \"Le WallType ne possede pas de CompoundStructure.\"\r\n                    })\r\n\r\n                    continue\r\n\r\n\r\n                # ---------------------------------------------\r\n                # Vérifier le nombre de couches\r\n                # ---------------------------------------------\r\n\r\n                layers = compound.GetLayers()\r\n\r\n                layer_count = len(layers)\r\n\r\n\r\n                if layer_count != 1:\r\n\r\n                    errors.append({\r\n\r\n                        \"Epaisseur_mm\":\r\n                            width_mm,\r\n\r\n                        \"NomType\":\r\n                            type_name,\r\n\r\n                        \"Erreur\":\r\n                            (\r\n                                \"Le type modele contient \"\r\n                                +\r\n                                str(layer_count)\r\n                                +\r\n                                \" couches. MUR_08 attend actuellement \"\r\n                                +\r\n                                \"un mur simple a une seule couche.\"\r\n                            )\r\n                    })\r\n\r\n                    continue\r\n\r\n\r\n                # ---------------------------------------------\r\n                # Nouvelle largeur\r\n                # ---------------------------------------------\r\n\r\n                width_internal = (\r\n                    mm_to_internal(\r\n                        width_mm\r\n                    )\r\n                )\r\n\r\n\r\n                compound.SetLayerWidth(\r\n                    0,\r\n                    width_internal\r\n                )\r\n\r\n\r\n                # ---------------------------------------------\r\n                # Réaffecter la CompoundStructure\r\n                # ---------------------------------------------\r\n\r\n                new_type.SetCompoundStructure(\r\n                    compound\r\n                )\r\n\r\n\r\n                # ---------------------------------------------\r\n                # Stockage\r\n                # ---------------------------------------------\r\n\r\n                types_by_width[\r\n                    width_mm\r\n                ] = new_type\r\n\r\n\r\n                created_types.append(\r\n                    new_type\r\n                )\r\n\r\n\r\n                existing_types_by_name[\r\n                    type_name\r\n                ] = new_type\r\n\r\n\r\n                correspondences.append({\r\n\r\n                    \"Epaisseur_mm\":\r\n                        width_mm,\r\n\r\n                    \"NomType\":\r\n                        type_name,\r\n\r\n                    \"Action\":\r\n                        \"Cree\",\r\n\r\n                    \"ElementId\":\r\n                        new_type.Id.Value\r\n                })\r\n\r\n\r\n            except Exception as ex:\r\n\r\n                errors.append({\r\n\r\n                    \"Epaisseur_mm\":\r\n                        width_mm,\r\n\r\n                    \"NomType\":\r\n                        type_name,\r\n\r\n                    \"Erreur\":\r\n                        str(ex)\r\n                })\r\n\r\n\r\n    finally:\r\n\r\n        TransactionManager.Instance.TransactionTaskDone()\r\n\r\n\r\n# ============================================================\r\n# TYPE POUR CHAQUE AXE\r\n#\r\n# L'ordre est strictement celui de MUR_07 OUT[1].\r\n#\r\n# Exemple :\r\n#\r\n# widths :\r\n#\r\n# [100, 100, 70, 30, 100]\r\n#\r\n# OUT[0] :\r\n#\r\n# [Type100,\r\n#  Type100,\r\n#  Type70,\r\n#  Type30,\r\n#  Type100]\r\n#\r\n# ============================================================\r\n\r\nwall_types_per_axis = []\r\n\r\n\r\nfor width in widths:\r\n\r\n    if width is None:\r\n\r\n        wall_types_per_axis.append(\r\n            None\r\n        )\r\n\r\n        continue\r\n\r\n\r\n    wall_type = types_by_width.get(\r\n        width\r\n    )\r\n\r\n\r\n    wall_types_per_axis.append(\r\n        wall_type\r\n    )\r\n\r\n\r\n# ============================================================\r\n# TYPES UNIQUES\r\n# ============================================================\r\n\r\nunique_wall_types = []\r\n\r\n\r\nfor width in unique_widths:\r\n\r\n    wall_type = types_by_width.get(\r\n        width\r\n    )\r\n\r\n    if wall_type is not None:\r\n\r\n        unique_wall_types.append(\r\n            wall_type\r\n        )\r\n\r\n\r\n# ============================================================\r\n# VERIFICATION LARGEUR REELLE\r\n# ============================================================\r\n\r\nwidth_checks = []\r\n\r\n\r\nfor width in unique_widths:\r\n\r\n    wall_type = types_by_width.get(\r\n        width\r\n    )\r\n\r\n\r\n    if wall_type is None:\r\n        continue\r\n\r\n\r\n    actual_width_mm = None\r\n\r\n\r\n    try:\r\n\r\n        actual_width_mm = (\r\n            UnitUtils.ConvertFromInternalUnits(\r\n                wall_type.Width,\r\n                UnitTypeId.Millimeters\r\n            )\r\n        )\r\n\r\n    except:\r\n\r\n        pass\r\n\r\n\r\n    width_checks.append({\r\n\r\n        \"NomType\":\r\n            wall_type.Name,\r\n\r\n        \"EpaisseurDemandee_mm\":\r\n            width,\r\n\r\n        \"EpaisseurRevit_mm\":\r\n            (\r\n                round(\r\n                    actual_width_mm,\r\n                    3\r\n                )\r\n                if\r\n                actual_width_mm\r\n                is not None\r\n                else None\r\n            )\r\n    })\r\n\r\n\r\n# ============================================================\r\n# DIAGNOSTIC\r\n# ============================================================\r\n\r\ndiagnostic = {\r\n\r\n    \"Epaisseurs entree\":\r\n        len(widths_raw),\r\n\r\n    \"Epaisseurs valides\":\r\n        len([\r\n            x\r\n            for x in widths\r\n            if x is not None\r\n        ]),\r\n\r\n    \"Epaisseurs invalides\":\r\n        len(\r\n            invalid_width_indices\r\n        ),\r\n\r\n    \"Indices invalides\":\r\n        invalid_width_indices,\r\n\r\n    \"Classes demandees\":\r\n        len(unique_widths),\r\n\r\n    \"Types disponibles\":\r\n        len(unique_wall_types),\r\n\r\n    \"Types crees\":\r\n        len(created_types),\r\n\r\n    \"Types existants reutilises\":\r\n        len(reused_types),\r\n\r\n    \"Erreurs\":\r\n        len(errors),\r\n\r\n    \"Details erreurs\":\r\n        errors,\r\n\r\n    \"Prefixe\":\r\n        prefix,\r\n\r\n    \"Verification largeurs\":\r\n        width_checks,\r\n\r\n    \"Types par axe\":\r\n        len(wall_types_per_axis)\r\n}\r\n\r\n\r\nif fatal_error is not None:\r\n\r\n    diagnostic[\r\n        \"Erreur fatale\"\r\n    ] = fatal_error\r\n\r\n\r\n# ============================================================\r\n# OUTPUT\r\n# ============================================================\r\n\r\nOUT = (\r\n\r\n    wall_types_per_axis,     # OUT[0]\r\n\r\n    unique_wall_types,       # OUT[1]\r\n\r\n    created_types,           # OUT[2]\r\n\r\n    reused_types,            # OUT[3]\r\n\r\n    correspondences,         # OUT[4]\r\n\r\n    diagnostic               # OUT[5]\r\n)",
      "Engine": "PythonNet3",
      "VariableInputPorts": true,
      "Id": "f402e0d0bd3b44c79e2f93972e9cb6a4",
      "NodeType": "PythonScriptNode",
