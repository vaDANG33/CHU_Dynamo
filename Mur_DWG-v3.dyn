    {
      "ConcreteType": "PythonNodeModels.PythonNode, PythonNodeModels",
      "Code": "# -*- coding: utf-8 -*-\r\n\r\nimport clr\r\nimport math\r\n\r\nclr.AddReference(\"ProtoGeometry\")\r\nfrom Autodesk.DesignScript.Geometry import Point, Line\r\n\r\nclr.AddReference(\"RevitAPI\")\r\nfrom Autodesk.Revit.DB import UnitUtils, UnitTypeId, SpecTypeId\r\n\r\nclr.AddReference(\"RevitServices\")\r\nfrom RevitServices.Persistence import DocumentManager\r\n\r\n\r\n# ============================================================\r\n# MUR_06_ResoudreJonctions\r\n# VERSION 03\r\n#\r\n# 1. Fusion itérative des axes colinéaires jointifs /\r\n#    chevauchants\r\n#\r\n# 2. L = prolonger les deux axes jusqu'à l'intersection\r\n#\r\n# 3. T = prolonger uniquement la branche\r\n#\r\n# 4. X = détecter uniquement, aucune modification\r\n#\r\n# REGLE ABSOLUE :\r\n# MUR_06 ne peut jamais :\r\n# - raccourcir un axe\r\n# - déplacer latéralement un axe\r\n# - pivoter un axe\r\n#\r\n# Il peut seulement :\r\n# - fusionner des axes déjà colinéaires\r\n# - prolonger un axe sur son support original\r\n#\r\n#\r\n# IN[0] = axes MUR_05\r\n# IN[1] = épaisseurs mm\r\n# IN[2] = tolérance max de prolongement mm\r\n# IN[3] = tolérance angulaire deg\r\n#\r\n# OUT[0] = axes finaux\r\n# OUT[1] = épaisseurs finales\r\n# OUT[2] = points L\r\n# OUT[3] = points T\r\n# OUT[4] = points X\r\n# OUT[5] = géométries de correction\r\n# OUT[6] = informations jonctions\r\n# OUT[7] = diagnostic\r\n# ============================================================\r\n\r\n\r\n# ============================================================\r\n# INPUTS\r\n# ============================================================\r\n\r\ninput_axes = IN[0] if IN[0] else []\r\ninput_widths = IN[1] if IN[1] else []\r\n\r\nextension_tol_mm = (\r\n    float(IN[2])\r\n    if IN[2] is not None\r\n    else 75.0\r\n)\r\n\r\nangle_tol_deg = (\r\n    float(IN[3])\r\n    if IN[3] is not None\r\n    else 2.0\r\n)\r\n\r\n\r\n# ============================================================\r\n# PARAMETRES INTERNES\r\n# ============================================================\r\n\r\n# Deux axes doivent être pratiquement sur le même support\r\n# pour pouvoir être fusionnés.\r\nCOLLINEAR_TOL_MM = 3.0\r\n\r\n# Petit gap autorisé UNIQUEMENT pour absorber les imprécisions\r\n# numériques / dessin.\r\n#\r\n# Ce n'est PAS la tolérance L/T.\r\nMERGE_GAP_TOL_MM = 150.0\r\n\r\n# Tolérance entre épaisseurs pour fusion.\r\nWIDTH_TOL_MM = 2.0\r\n\r\nEPS = 1e-9\r\n\r\n\r\n# ============================================================\r\n# FLATTEN\r\n# ============================================================\r\n\r\ndef flatten(data):\r\n\r\n    result = []\r\n\r\n    if isinstance(data, (list, tuple)):\r\n\r\n        for item in data:\r\n            result.extend(flatten(item))\r\n\r\n    elif data is not None:\r\n\r\n        result.append(data)\r\n\r\n    return result\r\n\r\n\r\naxes = flatten(input_axes)\r\nwidths = flatten(input_widths)\r\n\r\n\r\n# ============================================================\r\n# UNITES\r\n# ============================================================\r\n\r\ndoc = DocumentManager.Instance.CurrentDBDocument\r\n\r\nproject_unit_id = (\r\n    doc.GetUnits()\r\n       .GetFormatOptions(SpecTypeId.Length)\r\n       .GetUnitTypeId()\r\n)\r\n\r\n\r\ndef mm_to_project(value_mm):\r\n\r\n    internal = UnitUtils.ConvertToInternalUnits(\r\n        value_mm,\r\n        UnitTypeId.Millimeters\r\n    )\r\n\r\n    return UnitUtils.ConvertFromInternalUnits(\r\n        internal,\r\n        project_unit_id\r\n    )\r\n\r\n\r\ndef project_to_mm(value):\r\n\r\n    internal = UnitUtils.ConvertToInternalUnits(\r\n        value,\r\n        project_unit_id\r\n    )\r\n\r\n    return UnitUtils.ConvertFromInternalUnits(\r\n        internal,\r\n        UnitTypeId.Millimeters\r\n    )\r\n\r\n\r\nextension_tol = mm_to_project(extension_tol_mm)\r\ncollinear_tol = mm_to_project(COLLINEAR_TOL_MM)\r\nmerge_gap_tol = mm_to_project(MERGE_GAP_TOL_MM)\r\n\r\n\r\n# ============================================================\r\n# OUTILS\r\n# ============================================================\r\n\r\ndef xyz(point):\r\n\r\n    return (\r\n        float(point.X),\r\n        float(point.Y),\r\n        float(point.Z)\r\n    )\r\n\r\n\r\ndef distance2d(a, b):\r\n\r\n    dx = a[0] - b[0]\r\n    dy = a[1] - b[1]\r\n\r\n    return math.sqrt(\r\n        dx * dx +\r\n        dy * dy\r\n    )\r\n\r\n\r\ndef dot2(a, b):\r\n\r\n    return (\r\n        a[0] * b[0] +\r\n        a[1] * b[1]\r\n    )\r\n\r\n\r\ndef cross2(a, b):\r\n\r\n    return (\r\n        a[0] * b[1] -\r\n        a[1] * b[0]\r\n    )\r\n\r\n\r\ndef make_point(p):\r\n\r\n    try:\r\n\r\n        return Point.ByCoordinates(\r\n            p[0],\r\n            p[1],\r\n            p[2]\r\n        )\r\n\r\n    except:\r\n\r\n        return None\r\n\r\n\r\ndef make_line(a, b):\r\n\r\n    if distance2d(a, b) <= EPS:\r\n        return None\r\n\r\n    pa = make_point(a)\r\n    pb = make_point(b)\r\n\r\n    if pa is None or pb is None:\r\n        return None\r\n\r\n    try:\r\n\r\n        return Line.ByStartPointEndPoint(\r\n            pa,\r\n            pb\r\n        )\r\n\r\n    except:\r\n\r\n        return None\r\n\r\n\r\n# ============================================================\r\n# DONNEES GEOMETRIQUES D'UN AXE\r\n# ============================================================\r\n\r\ndef geometry_data(p0, p1):\r\n\r\n    dx = p1[0] - p0[0]\r\n    dy = p1[1] - p0[1]\r\n\r\n    length = math.sqrt(\r\n        dx * dx +\r\n        dy * dy\r\n    )\r\n\r\n    if length <= EPS:\r\n        return None\r\n\r\n    return {\r\n\r\n        \"p0\": p0,\r\n        \"p1\": p1,\r\n\r\n        \"dir\": (\r\n            dx / length,\r\n            dy / length\r\n        ),\r\n\r\n        \"length\": length\r\n    }\r\n\r\n\r\ndef curve_data(curve):\r\n\r\n    try:\r\n\r\n        p0 = xyz(curve.StartPoint)\r\n        p1 = xyz(curve.EndPoint)\r\n\r\n    except:\r\n\r\n        return None\r\n\r\n    return geometry_data(\r\n        p0,\r\n        p1\r\n    )\r\n\r\n\r\n# ============================================================\r\n# ANGLE AIGU\r\n#\r\n# abs(dot) => indépendant du sens de la ligne\r\n# ============================================================\r\n\r\ndef acute_angle_deg(dir_a, dir_b):\r\n\r\n    value = abs(\r\n        dot2(dir_a, dir_b)\r\n    )\r\n\r\n    value = max(\r\n        0.0,\r\n        min(1.0, value)\r\n    )\r\n\r\n    return math.degrees(\r\n        math.acos(value)\r\n    )\r\n\r\n\r\n# ============================================================\r\n# DISTANCE POINT -> SUPPORT\r\n# ============================================================\r\n\r\ndef point_support_distance(point, record):\r\n\r\n    v = (\r\n        point[0] - record[\"p0\"][0],\r\n        point[1] - record[\"p0\"][1]\r\n    )\r\n\r\n    return abs(\r\n        cross2(\r\n            v,\r\n            record[\"dir\"]\r\n        )\r\n    )\r\n\r\n\r\n# ============================================================\r\n# PROJECTION LONGITUDINALE SUR UN SUPPORT\r\n#\r\n# t est ici une distance réelle depuis p0,\r\n# pas un paramètre normalisé.\r\n# ============================================================\r\n\r\ndef longitudinal_parameter(point, origin, direction):\r\n\r\n    return dot2(\r\n\r\n        (\r\n            point[0] - origin[0],\r\n            point[1] - origin[1]\r\n        ),\r\n\r\n        direction\r\n    )\r\n\r\n\r\n# ============================================================\r\n# EPAISSEURS COMPATIBLES\r\n# ============================================================\r\n\r\ndef compatible_width(a, b):\r\n\r\n    wa = a[\"width_mm\"]\r\n    wb = b[\"width_mm\"]\r\n\r\n    if wa is None or wb is None:\r\n        return True\r\n\r\n    return (\r\n        abs(wa - wb)\r\n        <= WIDTH_TOL_MM\r\n    )\r\n\r\n\r\n# ============================================================\r\n# PREPARATION DES RECORDS\r\n# ============================================================\r\n\r\nrecords = []\r\n\r\nfor original_index, curve in enumerate(axes):\r\n\r\n    data = curve_data(curve)\r\n\r\n    if data is None:\r\n        continue\r\n\r\n    width = None\r\n\r\n    if original_index < len(widths):\r\n\r\n        try:\r\n            width = float(\r\n                widths[original_index]\r\n            )\r\n        except:\r\n            width = None\r\n\r\n    records.append({\r\n\r\n        \"index\": original_index,\r\n\r\n        \"source_indices\": [\r\n            original_index\r\n        ],\r\n\r\n        \"curve\": curve,\r\n\r\n        \"p0\": data[\"p0\"],\r\n        \"p1\": data[\"p1\"],\r\n\r\n        \"dir\": data[\"dir\"],\r\n        \"length\": data[\"length\"],\r\n\r\n        \"width_mm\": width,\r\n\r\n        \"modified\": False,\r\n\r\n        \"corrections\": []\r\n    })\r\n\r\n\r\n# ============================================================\r\n# METTRE A JOUR LA GEOMETRIE D'UN RECORD\r\n# ============================================================\r\n\r\ndef update_record_geometry(record, p0, p1):\r\n\r\n    data = geometry_data(\r\n        p0,\r\n        p1\r\n    )\r\n\r\n    if data is None:\r\n        return False\r\n\r\n    curve = make_line(\r\n        p0,\r\n        p1\r\n    )\r\n\r\n    if curve is None:\r\n        return False\r\n\r\n    record[\"curve\"] = curve\r\n\r\n    record[\"p0\"] = data[\"p0\"]\r\n    record[\"p1\"] = data[\"p1\"]\r\n\r\n    record[\"dir\"] = data[\"dir\"]\r\n    record[\"length\"] = data[\"length\"]\r\n\r\n    return True\r\n\r\n\r\n# ============================================================\r\n# TEST / FUSION DE DEUX AXES\r\n#\r\n# Retour :\r\n# None => impossible\r\n#\r\n# ou :\r\n# {\r\n#   \"p0\": ...\r\n#   \"p1\": ...\r\n#   \"gap\": ...\r\n# }\r\n# ============================================================\r\n\r\ndef try_merge_collinear(a, b):\r\n\r\n    # --------------------------------------------------------\r\n    # 1. Même épaisseur\r\n    # --------------------------------------------------------\r\n\r\n    if not compatible_width(a, b):\r\n        return None\r\n\r\n    # --------------------------------------------------------\r\n    # 2. Directions parallèles\r\n    # --------------------------------------------------------\r\n\r\n    angle = acute_angle_deg(\r\n        a[\"dir\"],\r\n        b[\"dir\"]\r\n    )\r\n\r\n    if angle > angle_tol_deg:\r\n        return None\r\n\r\n    # --------------------------------------------------------\r\n    # 3. Même droite support\r\n    #\r\n    # On teste les deux endpoints de B par rapport au\r\n    # support de A.\r\n    # --------------------------------------------------------\r\n\r\n    d_b0 = point_support_distance(\r\n        b[\"p0\"],\r\n        a\r\n    )\r\n\r\n    d_b1 = point_support_distance(\r\n        b[\"p1\"],\r\n        a\r\n    )\r\n\r\n    if (\r\n        d_b0 > collinear_tol\r\n        or\r\n        d_b1 > collinear_tol\r\n    ):\r\n        return None\r\n\r\n    # --------------------------------------------------------\r\n    # 4. Tout projeter sur le support ORIGINAL de A\r\n    #\r\n    # Important :\r\n    # le nouvel axe reste donc exactement sur le support A.\r\n    # --------------------------------------------------------\r\n\r\n    origin = a[\"p0\"]\r\n    direction = a[\"dir\"]\r\n\r\n    ta0 = 0.0\r\n    ta1 = a[\"length\"]\r\n\r\n    tb0 = longitudinal_parameter(\r\n        b[\"p0\"],\r\n        origin,\r\n        direction\r\n    )\r\n\r\n    tb1 = longitudinal_parameter(\r\n        b[\"p1\"],\r\n        origin,\r\n        direction\r\n    )\r\n\r\n    a_min = min(\r\n        ta0,\r\n        ta1\r\n    )\r\n\r\n    a_max = max(\r\n        ta0,\r\n        ta1\r\n    )\r\n\r\n    b_min = min(\r\n        tb0,\r\n        tb1\r\n    )\r\n\r\n    b_max = max(\r\n        tb0,\r\n        tb1\r\n    )\r\n\r\n    # --------------------------------------------------------\r\n    # 5. Gap longitudinal\r\n    #\r\n    # gap < 0 => chevauchement\r\n    # gap = 0 => jointif\r\n    # gap > 0 => vide\r\n    # --------------------------------------------------------\r\n\r\n    if b_min > a_max:\r\n\r\n        gap = (\r\n            b_min - a_max\r\n        )\r\n\r\n    elif a_min > b_max:\r\n\r\n        gap = (\r\n            a_min - b_max\r\n        )\r\n\r\n    else:\r\n\r\n        gap = 0.0\r\n\r\n    # --------------------------------------------------------\r\n    # On autorise seulement :\r\n    #\r\n    # chevauchement\r\n    # jointif\r\n    # micro-gap <= 5 mm\r\n    #\r\n    # PAS un I-crossing général.\r\n    # --------------------------------------------------------\r\n\r\n    if gap > merge_gap_tol:\r\n        return None\r\n\r\n    # --------------------------------------------------------\r\n    # 6. Intervalle global\r\n    # --------------------------------------------------------\r\n\r\n    global_min = min(\r\n        a_min,\r\n        b_min\r\n    )\r\n\r\n    global_max = max(\r\n        a_max,\r\n        b_max\r\n    )\r\n\r\n    # --------------------------------------------------------\r\n    # 7. Reconstruction STRICTEMENT sur le support de A\r\n    # --------------------------------------------------------\r\n\r\n    z = (\r\n        a[\"p0\"][2] +\r\n        a[\"p1\"][2] +\r\n        b[\"p0\"][2] +\r\n        b[\"p1\"][2]\r\n    ) / 4.0\r\n\r\n    p_start = (\r\n\r\n        origin[0]\r\n        + direction[0] * global_min,\r\n\r\n        origin[1]\r\n        + direction[1] * global_min,\r\n\r\n        z\r\n    )\r\n\r\n    p_end = (\r\n\r\n        origin[0]\r\n        + direction[0] * global_max,\r\n\r\n        origin[1]\r\n        + direction[1] * global_max,\r\n\r\n        z\r\n    )\r\n\r\n    return {\r\n\r\n        \"p0\": p_start,\r\n        \"p1\": p_end,\r\n\r\n        \"gap\": gap,\r\n\r\n        \"angle\": angle,\r\n\r\n        \"support_offset\":\r\n            max(d_b0, d_b1)\r\n    }\r\n\r\n\r\n# ============================================================\r\n# ETAPE 1\r\n#\r\n# FUSION ITERATIVE DES AXES COLLINEAIRES\r\n# ============================================================\r\n\r\nmerge_infos = []\r\n\r\nmerge_passes = 0\r\nmerge_count = 0\r\n\r\nchanged = True\r\n\r\n\r\nwhile changed:\r\n\r\n    changed = False\r\n    merge_passes += 1\r\n\r\n    i = 0\r\n\r\n    while i < len(records):\r\n\r\n        merged_this_i = False\r\n\r\n        j = i + 1\r\n\r\n        while j < len(records):\r\n\r\n            a = records[i]\r\n            b = records[j]\r\n\r\n            result = try_merge_collinear(\r\n                a,\r\n                b\r\n            )\r\n\r\n            if result is None:\r\n\r\n                j += 1\r\n                continue\r\n\r\n            # ------------------------------------------------\r\n            # Sources avant fusion\r\n            # ------------------------------------------------\r\n\r\n            sources_a = list(\r\n                a[\"source_indices\"]\r\n            )\r\n\r\n            sources_b = list(\r\n                b[\"source_indices\"]\r\n            )\r\n\r\n            # ------------------------------------------------\r\n            # Nouvelle largeur\r\n            #\r\n            # Si les deux existent et sont compatibles,\r\n            # moyenne légère.\r\n            # ------------------------------------------------\r\n\r\n            if (\r\n                a[\"width_mm\"] is not None\r\n                and\r\n                b[\"width_mm\"] is not None\r\n            ):\r\n\r\n                new_width = (\r\n                    a[\"width_mm\"]\r\n                    + b[\"width_mm\"]\r\n                ) * 0.5\r\n\r\n            elif a[\"width_mm\"] is not None:\r\n\r\n                new_width = a[\"width_mm\"]\r\n\r\n            else:\r\n\r\n                new_width = b[\"width_mm\"]\r\n\r\n            # ------------------------------------------------\r\n            # Mise à jour de A\r\n            # ------------------------------------------------\r\n\r\n            success = update_record_geometry(\r\n\r\n                a,\r\n\r\n                result[\"p0\"],\r\n                result[\"p1\"]\r\n            )\r\n\r\n            if not success:\r\n\r\n                j += 1\r\n                continue\r\n\r\n            a[\"width_mm\"] = new_width\r\n\r\n            a[\"source_indices\"] = sorted(\r\n                set(\r\n                    sources_a +\r\n                    sources_b\r\n                )\r\n            )\r\n\r\n            a[\"modified\"] = True\r\n\r\n            a[\"corrections\"].append({\r\n\r\n                \"Type\":\r\n                    \"MERGE\",\r\n\r\n                \"Sources\":\r\n                    sources_b,\r\n\r\n                \"Gap_mm\":\r\n                    round(\r\n                        project_to_mm(\r\n                            result[\"gap\"]\r\n                        ),\r\n                        2\r\n                    )\r\n            })\r\n\r\n            # ------------------------------------------------\r\n            # Diagnostic\r\n            # ------------------------------------------------\r\n\r\n            merge_infos.append({\r\n\r\n                \"Type\":\r\n                    \"MERGE_COLLINEAR\",\r\n\r\n                \"SourcesA\":\r\n                    sources_a,\r\n\r\n                \"SourcesB\":\r\n                    sources_b,\r\n\r\n                \"ResultSources\":\r\n                    list(\r\n                        a[\"source_indices\"]\r\n                    ),\r\n\r\n                \"Gap_mm\":\r\n                    round(\r\n                        project_to_mm(\r\n                            result[\"gap\"]\r\n                        ),\r\n                        2\r\n                    ),\r\n\r\n                \"OffsetSupport_mm\":\r\n                    round(\r\n                        project_to_mm(\r\n                            result[\r\n                                \"support_offset\"\r\n                            ]\r\n                        ),\r\n                        2\r\n                    ),\r\n\r\n                \"Angle_deg\":\r\n                    round(\r\n                        result[\"angle\"],\r\n                        3\r\n                    )\r\n            })\r\n\r\n            # ------------------------------------------------\r\n            # Supprimer B\r\n            # ------------------------------------------------\r\n\r\n            records.pop(j)\r\n\r\n            merge_count += 1\r\n\r\n            changed = True\r\n            merged_this_i = True\r\n\r\n            # ------------------------------------------------\r\n            # IMPORTANT :\r\n            # recommencer les comparaisons pour le nouvel axe A.\r\n            #\r\n            # Exemple :\r\n            # A+B fusionnés\r\n            # puis AB+C.\r\n            # ------------------------------------------------\r\n\r\n            j = i + 1\r\n\r\n        i += 1\r\n\r\n\r\n# ============================================================\r\n# INTERSECTION DES SUPPORTS\r\n# ============================================================\r\n\r\ndef support_intersection(a, b):\r\n\r\n    p = a[\"p0\"]\r\n    q = b[\"p0\"]\r\n\r\n    r = (\r\n        a[\"p1\"][0] - p[0],\r\n        a[\"p1\"][1] - p[1]\r\n    )\r\n\r\n    s = (\r\n        b[\"p1\"][0] - q[0],\r\n        b[\"p1\"][1] - q[1]\r\n    )\r\n\r\n    denominator = cross2(\r\n        r,\r\n        s\r\n    )\r\n\r\n    if abs(denominator) <= EPS:\r\n        return None\r\n\r\n    qp = (\r\n        q[0] - p[0],\r\n        q[1] - p[1]\r\n    )\r\n\r\n    t = (\r\n        cross2(qp, s)\r\n        /\r\n        denominator\r\n    )\r\n\r\n    u = (\r\n        cross2(qp, r)\r\n        /\r\n        denominator\r\n    )\r\n\r\n    return {\r\n\r\n        \"point\": (\r\n\r\n            p[0] + t * r[0],\r\n            p[1] + t * r[1],\r\n\r\n            (\r\n                p[2] +\r\n                q[2]\r\n            ) * 0.5\r\n        ),\r\n\r\n        \"t\": t,\r\n        \"u\": u\r\n    }\r\n\r\n\r\n# ============================================================\r\n# ANALYSE DU PARAMETRE\r\n#\r\n# t < 0  => prolonger Start\r\n# t > 1  => prolonger End\r\n# 0..1   => intersection déjà dans le segment\r\n# ============================================================\r\n\r\ndef extension_state(record, parameter):\r\n\r\n    if parameter < 0.0:\r\n\r\n        distance = (\r\n            -parameter\r\n            * record[\"length\"]\r\n        )\r\n\r\n        return {\r\n\r\n            \"type\": \"extension\",\r\n\r\n            \"endpoint_id\": 0,\r\n\r\n            \"distance\": distance\r\n        }\r\n\r\n    if parameter > 1.0:\r\n\r\n        distance = (\r\n            (parameter - 1.0)\r\n            * record[\"length\"]\r\n        )\r\n\r\n        return {\r\n\r\n            \"type\": \"extension\",\r\n\r\n            \"endpoint_id\": 1,\r\n\r\n            \"distance\": distance\r\n        }\r\n\r\n    return {\r\n\r\n        \"type\": \"inside\",\r\n\r\n        \"endpoint_id\": None,\r\n\r\n        \"distance\": 0.0\r\n    }\r\n\r\n\r\n# ============================================================\r\n# PROPOSITIONS DE PROLONGEMENT\r\n# ============================================================\r\n\r\nproposals = {}\r\n\r\n\r\ndef add_extension_proposal(\r\n    record_index,\r\n    endpoint_id,\r\n    distance,\r\n    junction_type,\r\n    junction_id\r\n):\r\n\r\n    if distance <= EPS:\r\n        return\r\n\r\n    if distance > extension_tol:\r\n        return\r\n\r\n    key = (\r\n        record_index,\r\n        endpoint_id\r\n    )\r\n\r\n    if key not in proposals:\r\n        proposals[key] = []\r\n\r\n    proposals[key].append({\r\n\r\n        \"distance\":\r\n            distance,\r\n\r\n        \"type\":\r\n            junction_type,\r\n\r\n        \"junction_id\":\r\n            junction_id\r\n    })\r\n\r\n\r\n# ============================================================\r\n# ETAPE 2\r\n#\r\n# DETECTION L / T / X\r\n# ============================================================\r\n\r\njunctions = []\r\n\r\npair_tests = 0\r\nparallel_pairs = 0\r\ntoo_far = 0\r\n\r\n\r\nfor i in range(len(records)):\r\n\r\n    a = records[i]\r\n\r\n    for j in range(\r\n        i + 1,\r\n        len(records)\r\n    ):\r\n\r\n        b = records[j]\r\n\r\n        pair_tests += 1\r\n\r\n        angle = acute_angle_deg(\r\n            a[\"dir\"],\r\n            b[\"dir\"]\r\n        )\r\n\r\n        # ----------------------------------------------------\r\n        # I volontairement ignoré.\r\n        # ----------------------------------------------------\r\n\r\n        if angle <= angle_tol_deg:\r\n\r\n            parallel_pairs += 1\r\n            continue\r\n\r\n        inter = support_intersection(\r\n            a,\r\n            b\r\n        )\r\n\r\n        if inter is None:\r\n            continue\r\n\r\n        target = inter[\"point\"]\r\n\r\n        state_a = extension_state(\r\n            a,\r\n            inter[\"t\"]\r\n        )\r\n\r\n        state_b = extension_state(\r\n            b,\r\n            inter[\"u\"]\r\n        )\r\n\r\n        # ====================================================\r\n        # X\r\n        #\r\n        # Les deux segments contiennent déjà l'intersection.\r\n        # Aucun changement.\r\n        # ====================================================\r\n\r\n        if (\r\n            state_a[\"type\"] == \"inside\"\r\n            and\r\n            state_b[\"type\"] == \"inside\"\r\n        ):\r\n\r\n            junctions.append({\r\n\r\n                \"type\":\r\n                    \"X\",\r\n\r\n                \"point\":\r\n                    target,\r\n\r\n                \"records\":\r\n                    [i, j],\r\n\r\n                \"angle_deg\":\r\n                    angle,\r\n\r\n                \"extensions\":\r\n                    []\r\n            })\r\n\r\n            continue\r\n\r\n        # ====================================================\r\n        # T : A est branche\r\n        # ====================================================\r\n\r\n        if (\r\n            state_a[\"type\"] == \"extension\"\r\n            and\r\n            state_b[\"type\"] == \"inside\"\r\n        ):\r\n\r\n            distance = state_a[\r\n                \"distance\"\r\n            ]\r\n\r\n            if distance <= extension_tol:\r\n\r\n                junction_id = len(\r\n                    junctions\r\n                )\r\n\r\n                junctions.append({\r\n\r\n                    \"type\":\r\n                        \"T\",\r\n\r\n                    \"point\":\r\n                        target,\r\n\r\n                    \"records\":\r\n                        [i, j],\r\n\r\n                    \"branch_record\":\r\n                        i,\r\n\r\n                    \"main_record\":\r\n                        j,\r\n\r\n                    \"angle_deg\":\r\n                        angle,\r\n\r\n                    \"extensions\": [\r\n\r\n                        (\r\n                            i,\r\n                            state_a[\r\n                                \"endpoint_id\"\r\n                            ],\r\n                            distance\r\n                        )\r\n                    ]\r\n                })\r\n\r\n                add_extension_proposal(\r\n\r\n                    i,\r\n\r\n                    state_a[\r\n                        \"endpoint_id\"\r\n                    ],\r\n\r\n                    distance,\r\n\r\n                    \"T\",\r\n\r\n                    junction_id\r\n                )\r\n\r\n            else:\r\n\r\n                too_far += 1\r\n\r\n            continue\r\n\r\n        # ====================================================\r\n        # T : B est branche\r\n        # ====================================================\r\n\r\n        if (\r\n            state_a[\"type\"] == \"inside\"\r\n            and\r\n            state_b[\"type\"] == \"extension\"\r\n        ):\r\n\r\n            distance = state_b[\r\n                \"distance\"\r\n            ]\r\n\r\n            if distance <= extension_tol:\r\n\r\n                junction_id = len(\r\n                    junctions\r\n                )\r\n\r\n                junctions.append({\r\n\r\n                    \"type\":\r\n                        \"T\",\r\n\r\n                    \"point\":\r\n                        target,\r\n\r\n                    \"records\":\r\n                        [i, j],\r\n\r\n                    \"branch_record\":\r\n                        j,\r\n\r\n                    \"main_record\":\r\n                        i,\r\n\r\n                    \"angle_deg\":\r\n                        angle,\r\n\r\n                    \"extensions\": [\r\n\r\n                        (\r\n                            j,\r\n                            state_b[\r\n                                \"endpoint_id\"\r\n                            ],\r\n                            distance\r\n                        )\r\n                    ]\r\n                })\r\n\r\n                add_extension_proposal(\r\n\r\n                    j,\r\n\r\n                    state_b[\r\n                        \"endpoint_id\"\r\n                    ],\r\n\r\n                    distance,\r\n\r\n                    \"T\",\r\n\r\n                    junction_id\r\n                )\r\n\r\n            else:\r\n\r\n                too_far += 1\r\n\r\n            continue\r\n\r\n        # ====================================================\r\n        # L\r\n        #\r\n        # Les deux axes doivent être prolongés.\r\n        # ====================================================\r\n\r\n        if (\r\n            state_a[\"type\"] == \"extension\"\r\n            and\r\n            state_b[\"type\"] == \"extension\"\r\n        ):\r\n\r\n            da = state_a[\"distance\"]\r\n            db = state_b[\"distance\"]\r\n\r\n            if (\r\n                da <= extension_tol\r\n                and\r\n                db <= extension_tol\r\n            ):\r\n\r\n                junction_id = len(\r\n                    junctions\r\n                )\r\n\r\n                junctions.append({\r\n\r\n                    \"type\":\r\n                        \"L\",\r\n\r\n                    \"point\":\r\n                        target,\r\n\r\n                    \"records\":\r\n                        [i, j],\r\n\r\n                    \"angle_deg\":\r\n                        angle,\r\n\r\n                    \"extensions\": [\r\n\r\n                        (\r\n                            i,\r\n                            state_a[\r\n                                \"endpoint_id\"\r\n                            ],\r\n                            da\r\n                        ),\r\n\r\n                        (\r\n                            j,\r\n                            state_b[\r\n                                \"endpoint_id\"\r\n                            ],\r\n                            db\r\n                        )\r\n                    ]\r\n                })\r\n\r\n                add_extension_proposal(\r\n\r\n                    i,\r\n\r\n                    state_a[\r\n                        \"endpoint_id\"\r\n                    ],\r\n\r\n                    da,\r\n\r\n                    \"L\",\r\n\r\n                    junction_id\r\n                )\r\n\r\n                add_extension_proposal(\r\n\r\n                    j,\r\n\r\n                    state_b[\r\n                        \"endpoint_id\"\r\n                    ],\r\n\r\n                    db,\r\n\r\n                    \"L\",\r\n\r\n                    junction_id\r\n                )\r\n\r\n            else:\r\n\r\n                too_far += 1\r\n\r\n\r\n# ============================================================\r\n# ETAPE 3\r\n#\r\n# RESOLUTION DES PROPOSITIONS\r\n#\r\n# Si plusieurs intersections demandent le même endpoint :\r\n# prendre le prolongement LE PLUS COURT.\r\n# ============================================================\r\n\r\nresolved = {}\r\n\r\nmultiple_candidates = []\r\n\r\n\r\nfor key, values in proposals.items():\r\n\r\n    ordered = sorted(\r\n        values,\r\n        key=lambda x: x[\"distance\"]\r\n    )\r\n\r\n    best = ordered[0]\r\n\r\n    resolved[key] = best\r\n\r\n    if len(ordered) > 1:\r\n\r\n        multiple_candidates.append({\r\n\r\n            \"Record\":\r\n                key[0],\r\n\r\n            \"Sources\":\r\n                records[\r\n                    key[0]\r\n                ][\"source_indices\"],\r\n\r\n            \"Endpoint\":\r\n                key[1],\r\n\r\n            \"Candidats_mm\": [\r\n\r\n                round(\r\n                    project_to_mm(\r\n                        x[\"distance\"]\r\n                    ),\r\n                    1\r\n                )\r\n\r\n                for x in ordered\r\n            ],\r\n\r\n            \"Choisi_mm\":\r\n                round(\r\n                    project_to_mm(\r\n                        best[\"distance\"]\r\n                    ),\r\n                    1\r\n                )\r\n        })\r\n\r\n\r\n# ============================================================\r\n# ETAPE 4\r\n#\r\n# APPLICATION DES PROLONGEMENTS\r\n#\r\n# Pnew est TOUJOURS calculé à partir de :\r\n#\r\n# endpoint original +/- direction originale * distance\r\n#\r\n# Donc :\r\n# - pas de pivot\r\n# - pas de déplacement latéral\r\n# - pas de raccourcissement\r\n# ============================================================\r\n\r\ncorrections_geometry = []\r\n\r\nextension_count = 0\r\n\r\n\r\nfor record_index, record in enumerate(records):\r\n\r\n    original_p0 = record[\"p0\"]\r\n    original_p1 = record[\"p1\"]\r\n\r\n    new_p0 = original_p0\r\n    new_p1 = original_p1\r\n\r\n    # --------------------------------------------------------\r\n    # START\r\n    # --------------------------------------------------------\r\n\r\n    key0 = (\r\n        record_index,\r\n        0\r\n    )\r\n\r\n    if key0 in resolved:\r\n\r\n        proposal = resolved[key0]\r\n\r\n        distance = proposal[\r\n            \"distance\"\r\n        ]\r\n\r\n        new_p0 = (\r\n\r\n            original_p0[0]\r\n            - record[\"dir\"][0]\r\n            * distance,\r\n\r\n            original_p0[1]\r\n            - record[\"dir\"][1]\r\n            * distance,\r\n\r\n            original_p0[2]\r\n        )\r\n\r\n        correction = make_line(\r\n            original_p0,\r\n            new_p0\r\n        )\r\n\r\n        if correction is not None:\r\n\r\n            corrections_geometry.append(\r\n                correction\r\n            )\r\n\r\n        record[\"corrections\"].append({\r\n\r\n            \"Type\":\r\n                proposal[\"type\"],\r\n\r\n            \"Endpoint\":\r\n                0,\r\n\r\n            \"Extension_mm\":\r\n                round(\r\n                    project_to_mm(\r\n                        distance\r\n                    ),\r\n                    1\r\n                )\r\n        })\r\n\r\n        record[\"modified\"] = True\r\n\r\n        extension_count += 1\r\n\r\n    # --------------------------------------------------------\r\n    # END\r\n    # --------------------------------------------------------\r\n\r\n    key1 = (\r\n        record_index,\r\n        1\r\n    )\r\n\r\n    if key1 in resolved:\r\n\r\n        proposal = resolved[key1]\r\n\r\n        distance = proposal[\r\n            \"distance\"\r\n        ]\r\n\r\n        new_p1 = (\r\n\r\n            original_p1[0]\r\n            + record[\"dir\"][0]\r\n            * distance,\r\n\r\n            original_p1[1]\r\n            + record[\"dir\"][1]\r\n            * distance,\r\n\r\n            original_p1[2]\r\n        )\r\n\r\n        correction = make_line(\r\n            original_p1,\r\n            new_p1\r\n        )\r\n\r\n        if correction is not None:\r\n\r\n            corrections_geometry.append(\r\n                correction\r\n            )\r\n\r\n        record[\"corrections\"].append({\r\n\r\n            \"Type\":\r\n                proposal[\"type\"],\r\n\r\n            \"Endpoint\":\r\n                1,\r\n\r\n            \"Extension_mm\":\r\n                round(\r\n                    project_to_mm(\r\n                        distance\r\n                    ),\r\n                    1\r\n                )\r\n        })\r\n\r\n        record[\"modified\"] = True\r\n\r\n        extension_count += 1\r\n\r\n    # --------------------------------------------------------\r\n    # Reconstruction\r\n    # --------------------------------------------------------\r\n\r\n    update_record_geometry(\r\n        record,\r\n        new_p0,\r\n        new_p1\r\n    )\r\n\r\n\r\n# ============================================================\r\n# POINTS L / T / X\r\n# ============================================================\r\n\r\npoints_L = []\r\npoints_T = []\r\npoints_X = []\r\n\r\n\r\n# Jonctions réellement utilisées par une correction\r\nused_junction_ids = set()\r\n\r\nfor proposal in resolved.values():\r\n\r\n    used_junction_ids.add(\r\n        proposal[\"junction_id\"]\r\n    )\r\n\r\n\r\nfor junction_id, junction in enumerate(junctions):\r\n\r\n    jtype = junction[\"type\"]\r\n\r\n    # X ne nécessite pas de prolongement\r\n    active = (\r\n        jtype == \"X\"\r\n        or\r\n        junction_id in used_junction_ids\r\n    )\r\n\r\n    if not active:\r\n        continue\r\n\r\n    p = make_point(\r\n        junction[\"point\"]\r\n    )\r\n\r\n    if p is None:\r\n        continue\r\n\r\n    if jtype == \"L\":\r\n\r\n        points_L.append(p)\r\n\r\n    elif jtype == \"T\":\r\n\r\n        points_T.append(p)\r\n\r\n    elif jtype == \"X\":\r\n\r\n        points_X.append(p)\r\n\r\n\r\n# ============================================================\r\n# AXES FINAUX / EPAISSEURS\r\n# ============================================================\r\n\r\nfinal_axes = [\r\n\r\n    record[\"curve\"]\r\n\r\n    for record in records\r\n]\r\n\r\nfinal_widths = [\r\n\r\n    record[\"width_mm\"]\r\n\r\n    for record in records\r\n]\r\n\r\n\r\n# ============================================================\r\n# INFORMATIONS DES JONCTIONS\r\n# ============================================================\r\n\r\njunction_infos = []\r\n\r\n\r\n# ------------------------------------------------------------\r\n# Ajouter d'abord les fusions\r\n# ------------------------------------------------------------\r\n\r\nfor info in merge_infos:\r\n\r\n    junction_infos.append(\r\n        info\r\n    )\r\n\r\n\r\n# ------------------------------------------------------------\r\n# Puis L / T / X\r\n# ------------------------------------------------------------\r\n\r\nfor junction_id, junction in enumerate(junctions):\r\n\r\n    jtype = junction[\"type\"]\r\n\r\n    active = (\r\n        jtype == \"X\"\r\n        or\r\n        junction_id in used_junction_ids\r\n    )\r\n\r\n    if not active:\r\n        continue\r\n\r\n    rec_ids = junction[\r\n        \"records\"\r\n    ]\r\n\r\n    source_groups = [\r\n\r\n        records[r][\r\n            \"source_indices\"\r\n        ]\r\n\r\n        for r in rec_ids\r\n    ]\r\n\r\n    extension_values = [\r\n\r\n        round(\r\n            project_to_mm(\r\n                ext[2]\r\n            ),\r\n            1\r\n        )\r\n\r\n        for ext in junction.get(\r\n            \"extensions\",\r\n            []\r\n        )\r\n    ]\r\n\r\n    junction_infos.append({\r\n\r\n        \"Type\":\r\n            jtype,\r\n\r\n        \"Records\":\r\n            rec_ids,\r\n\r\n        \"Sources\":\r\n            source_groups,\r\n\r\n        \"Angle_deg\":\r\n            round(\r\n                junction[\r\n                    \"angle_deg\"\r\n                ],\r\n                2\r\n            ),\r\n\r\n        \"Extensions_mm\":\r\n            extension_values,\r\n\r\n        \"Point_X\":\r\n            round(\r\n                junction[\r\n                    \"point\"\r\n                ][0],\r\n                4\r\n            ),\r\n\r\n        \"Point_Y\":\r\n            round(\r\n                junction[\r\n                    \"point\"\r\n                ][1],\r\n                4\r\n            )\r\n    })\r\n\r\n\r\n# ============================================================\r\n# DIAGNOSTIC\r\n# ============================================================\r\n\r\ncount_L = sum(\r\n\r\n    1\r\n\r\n    for j in junction_infos\r\n\r\n    if j.get(\"Type\") == \"L\"\r\n)\r\n\r\ncount_T = sum(\r\n\r\n    1\r\n\r\n    for j in junction_infos\r\n\r\n    if j.get(\"Type\") == \"T\"\r\n)\r\n\r\ncount_X = sum(\r\n\r\n    1\r\n\r\n    for j in junction_infos\r\n\r\n    if j.get(\"Type\") == \"X\"\r\n)\r\n\r\n\r\ndiagnostic = {\r\n\r\n    \"Version\":\r\n        \"MUR_06_FusionCollineaire_Prolongement_03\",\r\n\r\n    \"Regle\":\r\n        \"Fusion collineaire + prolongement uniquement\",\r\n\r\n    \"Axes entree\":\r\n        len(axes),\r\n\r\n    \"Axes apres fusion\":\r\n        len(records),\r\n\r\n    \"Fusions\":\r\n        merge_count,\r\n\r\n    \"Passes fusion\":\r\n        merge_passes,\r\n\r\n    \"Tolerance collinearite mm\":\r\n        COLLINEAR_TOL_MM,\r\n\r\n    \"Tolerance micro-gap fusion mm\":\r\n        MERGE_GAP_TOL_MM,\r\n\r\n    \"Tolerance epaisseur fusion mm\":\r\n        WIDTH_TOL_MM,\r\n\r\n    \"Tolerance prolongement mm\":\r\n        extension_tol_mm,\r\n\r\n    \"Tolerance angle deg\":\r\n        angle_tol_deg,\r\n\r\n    \"Tests L/T/X\":\r\n        pair_tests,\r\n\r\n    \"Paires paralleles ignorees\":\r\n        parallel_pairs,\r\n\r\n    \"Intersections trop eloignees\":\r\n        too_far,\r\n\r\n    \"Jonctions L\":\r\n        count_L,\r\n\r\n    \"Jonctions T\":\r\n        count_T,\r\n\r\n    \"Jonctions X\":\r\n        count_X,\r\n\r\n    \"Prolongements\":\r\n        extension_count,\r\n\r\n    \"Endpoints plusieurs candidats\":\r\n        len(\r\n            multiple_candidates\r\n        ),\r\n\r\n    \"Details candidats\":\r\n        multiple_candidates,\r\n\r\n    \"Axes finaux\":\r\n        len(final_axes)\r\n}\r\n\r\n\r\n# ============================================================\r\n# OUT\r\n# ============================================================\r\n\r\nOUT = (\r\n\r\n    final_axes,              # OUT[0]\r\n\r\n    final_widths,            # OUT[1]\r\n\r\n    points_L,                # OUT[2]\r\n\r\n    points_T,                # OUT[3]\r\n\r\n    points_X,                # OUT[4]\r\n\r\n    corrections_geometry,    # OUT[5]\r\n\r\n    junction_infos,          # OUT[6]\r\n\r\n    diagnostic               # OUT[7]\r\n)",
      "Engine": "PythonNet3",
      "VariableInputPorts": true,
      "Id": "70e1df6f08214123b06d044bd67ede53",
      "NodeType": "PythonScriptNode",
